층 커피숍 등 부대시설도 알차다.","updated":"2025-10-10","facilities":[{"k":"주요시설","v":"카라반(27면)","items":["카라반(27면)"]},{"k":"기타 부대시설","v":"태국 음식점, 카페","items":["태국 음식점, 카페"]},{"k":"카라반 내부시설","v":"침대 · TV · 에어컨 · 냉장고 · 유무선인터넷 · 난방기구 · 취사도구 · 내부화장실 · 내부샤워실","items":["침대","TV","에어컨","냉장고","유무선인터넷","난방기구","취사도구","내부화장실","내부샤워실"]},{"k":"캠핑장비대여","v":"캠핑장 문의","items":["캠핑장 문의"]},{"k":"반려동물 출입","v":"불가능"},{"k":"화로대","v":"개별"},{"k":"안전시설현황","v":"소화기 (2) · 화재감지기 (2)","items":["소화기 (2)","화재감지기 (2)"]}],"photos":["https://www.gocamping.or.kr/upload/camp/6733/14854B54U7LwhwuNvK1JZPoQ.jpg","https://www.gocamping.or.kr/upload/camp/6733/0673DolAHT3Z6JKibpNiZrwE.jpg","https://www.gocamping.or.kr/upload/camp/6733/01851LLzU6Hg5xC2NJKV9JSv.jpg","https://www.gocamping.or.kr/upload/camp/6733/3885a0U0HDpv9YP3YJNlkTst.jpg","https://www.gocamping.or.kr/upload/camp/6733/9544cNoPs4tUSTK4nebjdwYG.jpg","https://www.gocamping.or.kr/upload/camp/6733/1513BXWtt6Rar9y5jvkDoL2A.jpg","https://www.gocamping.or.kr/upload/camp/6733/2640ZlyscCgmwlTfC5HFmn1S.jpg","https://www.gocamping.or.kr/upload/camp/6733/0921Puio543TReKNcGSmWOXS.jpg","https://www.gocamping.or.kr/upload/camp/6733/2724esGUckR9uN9ooCa6yUFM.jpg","https://www.gocamping.or.kr/upload/camp/6733/6588b4c1sTy5kR68z94lOLLy.jpg","https://www.gocamping.or.kr/upload/camp/6733/381543QQrX2uvVbIUSW4P2CI.jpg","https://www.gocamping.or.kr/upload/camp/6733/4012GY62OxEZ0w21OdOMA2r9.jpg"],"guide":[{"title":"일반캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"일반","values":["70,000","80,000","130,000","150,000"]}]}},{"title":"카라반","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"카라반","values":["58,000 ~110,000","120,000 ~150,000","140,000 ~150,000","150,000 ~200,000"]}]}}],"fees":[{"won":70000,"label":"일반캠핑 · 일반","period":"평상시 주중"},{"won":80000,"label":"일반캠핑 · 일반","period":"평상시 주말"},{"won":130000,"label":"일반캠핑 · 일반","period":"성수기 주중"},{"won":150000,"label":"일반캠핑 · 일반","period":"성수기 주말"}],"checked_at":"2026-10-20T03:48:00.830Z