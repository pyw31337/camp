6면)","items":["일반야영장(75면)","자동차야영장사이트(36면)"]},{"k":"기타 정보","v":"개인 트레일러 입장가능","items":["개인 트레일러 입장가능"]},{"k":"사이트 간격","v":"4M"},{"k":"바닥형태 (단위:면)","v":"잔디 (111)","items":["잔디 (111)"]},{"k":"사이트 크기","v":"8 X 10 : 36개 · 5 X 6 : 75개"},{"k":"캠핑장비대여","v":"캠핑장 문의","items":["캠핑장 문의"]},{"k":"반려동물 출입","v":"불가능"},{"k":"화로대","v":"개별"}],"photos":["https://www.gocamping.or.kr/upload/camp/3578/8755i9dwwgCLfNCZdtwZMS9m.jpg","https://www.gocamping.or.kr/upload/camp/3578/90631xMfpU0ixbuS2TLTPz10.jpg","https://www.gocamping.or.kr/upload/camp/3578/77413YMtiWD4zN082w6IeFyW.jpg","https://www.gocamping.or.kr/upload/camp/3578/9112ZuKk0q0tm2RngnTwM7mi.jpg","https://www.gocamping.or.kr/upload/camp/3578/3061BqcBo1Ai5wkHkiRX6Z4q.jpg","https://www.gocamping.or.kr/upload/camp/3578/0581acvfYlffEmnCTj0KEaWz.jpg","https://www.gocamping.or.kr/upload/camp/3578/6400sZHVHlAdC6bQrlH1rcxE.jpg","https://www.gocamping.or.kr/upload/camp/3578/6015OQSbhgWhPNgn7B2HQP4p.jpg","https://www.gocamping.or.kr/upload/camp/3578/3586oHL2eQTpc7XoDPPgihfd.jpg","https://www.gocamping.or.kr/upload/camp/3578/569492hiU4MdHFXFm2KW1iTD.jpg"],"layout":["https://www.gocamping.or.kr/upload/camp/3578/9669sC6mwJmc7UMdYlUEFT9k.jpg"],"guide":[{"title":"일반캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"일반","values":["20,000","20,000","20,000","20,000"]}]}},{"title":"오토캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"오토캠핑","values":["30,000","30,000","30,000","30,000"]}]}}],"fees":[{"won":20000,"label":"일반캠핑 · 일반","period":"평상시 주중"},{"won":20000,"label":"일반캠핑 · 일반","period":"평상시 주말"},{"won":20000,"label":"일반캠핑 · 일반","period":"성수기 주중"},{"won":20000,"label":"일반캠핑 · 일반","period":"성수기 주말"},{"won":30000,"label":"오토캠핑 · 오토캠핑","period":"평상시 주중"},{"won":30000,"label":"오토캠핑 · 오토캠핑","period":"평상시 주말"},{"won":30000,"label":"오토캠핑 · 오토캠핑","period":"성수기 주중"},{"won":30000,"label":"오토캠핑 · 오토캠핑","period":"성수기 주말"}],"checked_at":"2026-10-20T04:41:01.340Z"},"tour_info":[{"name":"이용요금","text":"- 카라반 1