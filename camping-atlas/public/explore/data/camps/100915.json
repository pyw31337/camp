g"],"img_dup":1,"photos":[{"t":"camps/100915/e26fc49c-t.webp","l":"camps/100915/e26fc49c-l.webp","w":720,"h":479}],"operator_snippets":[{"text":"선셋코스트 카라반&캠핑장","url":"http://www.sunsetcoast.kr/html/index.html"},{"text":"애견동반가능","url":"http://www.sunsetcoast.kr/html/index.html"},{"text":"선셋코스트 카라반&캠핑장은 자연 속에서 편안한 휴식을","url":"http://www.sunsetcoast.kr/html/index.html"},{"text":"선셋코스트 카라반&캠핑장을 방문해보세요.","url":"http://www.sunsetcoast.kr/html/index.html"},{"text":"선셋코스트 카라반&캠핑장 입니다.","url":"http://www.sunsetcoast.kr/html/index.html"},{"text":"카라반 마다 개별데크에서 바베큐를 즐길수 있습니다.","url":"http://www.sunsetcoast.kr/html/index.html"},{"text":"반려동물과 함께 입실하실 수 있습니다.","url":"http://www.sunsetcoast.kr/html/index.html"},{"text":"- 일부카라반 : 고래","url":"http://www.sunsetcoast.kr/html/index.html"},{"text":"상호명 : 선셋코스트 카라반 & 캠핑장","url":"http://www.sunsetcoast.kr/html/index.html"},{"text":"선셋코스트 카라반&캠핑장 - RESERVATION","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"금요일 요금 /주말 : 토요일, 법정공휴일 전날","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"성수기 기간 : 실시간예약 달력을 참고하세요.","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"예약계좌 : IBK 기업은행 239-145391-04-017 (예금주 : 선셋코스트 카라반&캠핑장)","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"추가인원안내","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"- 기준인원 초과 시 추가 요금 발생","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"- 성인 1인 20,000원","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"아동 1인 20,000원","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"- 숯+그릴 이용 : 30,000원","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"- 카라반,에어스트림 테라스 바베큐 가능","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"실시간예약 달력으로 예약시 발송되는 문자(객실,투숙일,요금)를 확인하세요.","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"최대인원 초과시 입실 및 환불이 불가합니다.","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"입실시간","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"22시 이후 펜션에 도착하실 경우 미리 연락하셔야 하며,사전 연락이 없을 경우 입실을 제한 받을 수 있습니다.","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"퇴실시간","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"다음 이용인을 위하여 퇴실시간을 준수해 주시기 바랍니다.","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"객실정리 후 퇴실점검을 받으셔야 합니다.","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"이용중 집기 파손 시에는 펜션지기에게 알려주시기 바랍니다.","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"쓰레기는 지정된 장소에 분리하여 주시기 바랍니다.","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"환불규정","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"올바른 예약문화 정착을 위하여 해당 업소에서는 예약 취소시 환불기준을 아래와 같이 운영하고 있으니","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"당일예약 후 당일 취소시에도 수수료 적용되니 신중히 예약바랍니다.","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"취소 수수료","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"기본 취소 수수료","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"10일 전 취소시","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"9일 전 취소시","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"8일전 취소시","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"7일전 취소시","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"6일전 취소시","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"5일전 취소시","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"4일전 취소시","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"3일전 취소시","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"2일전 취소시","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"1일전 취소시","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"100% 공제(환불 불가)","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"이용일 당일 취소시","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"환불액은 객실전체요금에서 환불됩니다.","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"환불은 입금자명으로 되며 입금시 송금수수료는 제외한 후 입금됩니다.","url":"http://www.sunsetcoast.kr/html/sub6_reser.html"},{"text":"선셋코스트 카라반&캠핑장 - NOTICE","url":"http://www.sunsetcoast.kr/html/sub6_notice.html"},{"text":"선셋코스트 카라반&캠핑장 - LOCATION","url":"http://www.sunsetcoast.kr/html/sub6_map.html"},{"text":"선셋코스트 카라반&캠핑장 - PROLOGUE","url":"http://www.sunsetcoast.kr/html/sub1_view.html"},{"text":"샤워장, 화장실, 취사장, 세탁실 등이 완비되어 있어 편리함을 더했으며,","url":"http://www.sunsetcoast.kr/html/sub1_view.html"},{"text":"이용객들에게 자건거 무료대여 서비스를 제공해 드립니다.","url":"http://www.sunsetcoast.kr/html/sub1_view.html"},{"text":"선셋코스트 카라반&리조트는 자연 속에서","url":"http://www.sunsetcoast.kr/html/sub1_view.html"},{"text":"선셋코스트 카라반&리조트를 방문해보세요.","url":"http://www.sunsetcoast.kr/html/sub1_view.html"},{"text":"카라반&캠핑장 - ROOMS","url":"http://www.sunsetcoast.kr/html/sub2_room1.html"},{"text":"유형 : 오션뷰 우주선 카라반","url":"http://www.sunsetcoast.kr/html/sub2_room1.html"},{"text":"2명 초과시 추가요금 발생","url":"http://www.sunsetcoast.kr/html/sub2_room1.html"},{"text":"- 놀멍 카라반은 애견동반가능합니다.","url":"http://www.sunsetcoast.kr/html/sub2_room1.html"},{"text":"**바다와 함께하는 고급스러운 캠핑의 꿈, 에어스트림 카라반에서 현실로!**","url":"http://www.sunsetcoast.kr/html/sub2_room2.html"},{"text":"바다를 향해 펼쳐진 아름다운 풍경, 그곳에 자리 잡은 5대의 고품격 에어스트림 카라반.","url":"http://www.sunsetcoast.kr/html/sub2_room2.html"},{"text":"### **전통과 현대의 만남, 에어스트림 카라반**","url":"http://www.sunsetcoast.kr/html/sub2_room2.html"},{"text":"각 카라반은 새롭게 리모델링 되어 현대적인 감각을 더했으며,","url":"http://www.sunsetcoast.kr/html/sub2_room2.html"},{"text":"카라반의 창문을 열면 눈앞에 펼쳐지는 푸른 바다.","url":"http://www.sunsetcoast.kr/html/sub2_room2.html"},{"text":"캠핑의 자유로움과 고급 호텔의 안락함을 동시에 누릴 수 있는 곳, 에어스트림 카라반입니다.","url":"http://www.sunsetcoast.kr/html/sub2_room2.html"},{"text":"각종 편의시설이 완비된 카라반에서, 당신은 아무런 불편 없이 자연의 품에서 완벽한 휴식을 즐길 수 있습니다.","url":"http://www.sunsetcoast.kr/html/sub2_room2.html"},{"text":"지금 바로 예약하시고, 에어스트림 카라반에서 잊지 못할 럭셔리 캠핑을 경험해보세요.","url":"http://www.sunsetcoast.kr/html/sub2_room2.html"},{"text":"비수기(공통)","url":"http://www.sunsetcoast.kr/html/sub2_room2.html"},{"text":"20,000원","url":"http://www.sunsetcoast.kr/html/sub2_room2.html"},{"text":"침대,식탁,에어컨,냉장고,취사도구,전자레인지,객실샤워실,스파시설,난방,소화기,화재 경보기","url":"http://www.sunsetcoast.kr/html/sub2_room2.html"}],"field_conditions":{"version":2,"status":"CONFIRMED","parking":{"state":"UNKNOWN","mode":"UNKNOWN","tent_side":null,"cart_required":null,"shared_nearby":null,"drop_off_external":null,"auto_camping_sites":null},"shelter_setup":{"state":"UNKNOWN","max_tents":null,"max_tarps":null,"canopy_allowed":null,"note":null},"power":{"state":"CONFIRMED","available":true,"limit_w":null,"regulatory_reference_w":600,"breaker_capacity":null,"statutory_standard":true,"high_power_mention":null},"ground":{"state":"UNKNOWN","types":[]},"charcoal":{"state":"CONFIRMED","allowed":true},"firewood":{"state":"CONFIRMED","allowed":true,"sold":null},"fire_pit":{"state":"CONFIRMED","arrangement":"개별"},"site_size":{"state":"UNKNOWN","groups":[]},"sanitary":{"state":"UNKNOWN","toilets_count":null,"showers_count":null,"sinks_count":null,"private_bathroom":false,"private_bathroom_state":"UNKNOWN","hot_water":null,"note":null},"features":["FOREST_TRAIL"],"rental_offers":[],"source":{"label":"한국관광공사 고캠핑 운영자 등록 및 공식 소개 전수조사","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=100915","checked_at":"2024-12-31T00:00:00+09:00","tier":"A"}},"spec":{"version":1,"generated_at":"2026-10-19T11:48:27.177Z","fields":{"PET_POLICY":{"grade":"OFFICIAL_TEXT","values":[{"value":"동반 가능","quote":"애견동반가능","source":{"kind":"operator_homepage","label":"운영자 홈페이지","url":"http://www.sunsetcoast.kr/html/index.html","date":"2026-10-19T09:36:01.878Z"},"period":null}],"mentions":[],"conflict":false}},"stats":{"facts":2,"reviews_used":0,"roundups_skipped":2}},"rv":{"n":6,"p":[["반려견 동반 편함",2],["시설 깔끔·쾌적",1]],"c":[],"details":{"pros":[{"topic":"반려견 동반 편함","count":2,"samples":[{"title":"제주도 서귀포시 대형견 동반 가능한 숙소ㅣ선셋코스트 카라반","url":"https://blog.naver.com/hadodaek/22441