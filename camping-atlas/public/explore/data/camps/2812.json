l":"가족·키즈","why":"고캠핑 부대시설"},{"code":"REVIEW_QUIET","label":"후기: 조용","why":"후기 7건"}],"summary":"일반 21 · 화로대 개별","score":{"known":14,"facts":8,"total":18},"generated_at":"2026-10-31T01:22:49.836Z"},"site_types":[{"code":"PITCH","label":"일반 사이트","count":21,"sub":null,"grade":"CONFIRMED","src":"gocamping","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=2812","at":"2025-08-27T00:00:00+09:00","quote":null},{"code":"AUTO","label":"오토캠핑","count":null,"sub":null,"grade":"OPERATOR","src":"operator_homepage","url":"http://www.jocamp.co.kr/info/info01.php","at":"2026-10-20T01:19:34.407Z","quote":"Home > 캠프둘러보기 > 오토캠핑장 A site"},{"code":"HOUSE","label":"숙박동","count":null,"sub":"펜션","grade":"MENTION","src":"blog_mention","url":"https://blog.naver.com/rf1843/224281471918","at":"2026-05-11","quote":"지리산 오도재 함양군 휴천면 지리산펜션부지 별장부지 캠핑장부지..... 토지설명 : 지리산 국립공원 오도재 방"}],"house_rules":{"v":1,"tags":[{"k":"NO_PET","quote":"반려동물 동반: 불가능","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=2812","src":"한국관광공사 고캠핑 운영자 등록값","at":"2025-08-27T00:00:00+09:00","g":"c","label":"반려견 불가","icon":"paw"}],"rules":[],"ops":[],"notices":[]},"gcd":{"url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=2812","info":{"주소":"경상남도 함양군 휴천면 월평리 지리산가는길 811-1","문의처":"055-963-9393","캠핑장 유형":"일반야영장","운영기간":"봄, 여름, 가을","운영일":"평일+주말","예약방법":"온라인예약대기","주변이용가능시설":"계곡 물놀이"},"intro":"함양에서 지리산 가는 길은 국내에서 최고로 일컬어지는 아름다운 길이다. 먼저 아찔한 구비가 그림처럼 이어지는 지안재가 이 길에 있고, 좀 더 오르면 지리산과 함양 땅을 넘나들게 하는 오도재가 이어진다. 이곳에 지리산 오도재힐링캠핑장이 있다.\n캠핑장은 A, B, C 총 3구역으로 나눠져 있으며 A사이트는 가장 높은 곳에 위치하고 있어 삼봉산 및 멀리 함양 시내를 조망할 수 있다. 사이트 바로 옆으로 계곡이 흐르고 쉼터가 자리하고 있어 최적의 자리이다. B사이트는 중간에 위치하고 있어 편의시설을 이용하기에 좋으며 계단식으로 조성되어 있어 조용한 공간을 찾는 캠퍼들에겐 안성맞춤인 자리다. C사이트는 하단에 위치하고 있는 자리로, 앞으로는 큰 계곡이 흐르고 있으며 옆으로는 작은 계곡에서 맑은 물이 쉼 없이 흘러나오고 있다.\n큰 정자나무 밑에서 맑은 물소리를 들으며, 파란 하늘을 보고 있노라면 신선이 부럽지 않다. 가만히 텐트에 누워만 있어도 자연 힐링이 되는 캠핑장이다.","updated":"2025-08-27","facilities":[{"k":"주요시설","v":"일반야영장(21면)","items":["일반야영장(21면)"]},{"k":"바닥형태 (단위:면)","v":"파쇄석 (21)","items":["파쇄석 (21)"]},{"k":"사이트 크기","v":"6 X 7 : 21개"},{"k":"캠핑장비대여","v":"캠핑장 문의","items":["캠핑장 문의"]},{"k":"반려동물 출입","v":"불가능"},{"k":"화로대","v":"개별"},{"k":"안전시설현황","v":"소화기 (10)","items":["소화기 (10)"]}],"photos":["https://www.gocamping.or.kr/upload/camp/2812/6696CYqWKIyphs7FPCd3NclA.jpg","https://www.gocamping.or.kr/upload/camp/2812/0583sVUs4ki7f0GP5PwOnklH.jpg","https://www.gocamping.or.kr/upload/camp/2812/6137OtWu2xYnBfUsniKpH9AU.jpg","https://www.gocamping.or.kr/upload/camp/2812/0769gzAMj4rEB1WwJfIDjxrO.jpg","https://www.gocamping.or.kr/upload/camp/2812/8498KRZUxxul1BvnXqFfxHMo.jpg","https://www.gocamping.or.kr/upload/camp/2812/2242M48gGc5qADgY27vjJH55.jpg","https://www.gocamping.or.kr/upload/camp/2812/2942lKkHjpSkWj3A6i5ze5wE.jpg","https://www.gocamping.or.kr/upload/camp/2812/4453vnTady7atPlMfshlPG3d.jpg"],"guide":[{"title":"일반캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"일반","values":["25,000","0","30,000","0"]}]}}],"fees":[{"won":25000,"label":"일반캠핑 · 일반","period":"평상시 주중"},{"won":30000,"label":"일반캠핑 · 일반","period":"성수기 주중"}],"checked_at":"2026-10-20T03:50:14.406Z"}}