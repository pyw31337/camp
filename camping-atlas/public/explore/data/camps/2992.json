ypes":[{"code":"AUTO","label":"오토캠핑","count":18,"sub":null,"grade":"CONFIRMED","src":"gocamping","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=2992","at":"2025-08-04T00:00:00+09:00","quote":null},{"code":"DECK","label":"데크","count":3,"sub":null,"grade":"CONFIRMED","src":"gocamping","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=2992","at":"2025-08-04T00:00:00+09:00","quote":null},{"code":"RV","label":"캠핑카·트레일러","count":null,"sub":null,"grade":"CONFIRMED","src":"gocamping","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=2992","at":"2025-08-04T00:00:00+09:00","quote":"트레일러 입장 가능"}],"house_rules":{"v":1,"tags":[{"k":"NO_PET","quote":"반려동물 동반: 불가능","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=2992","src":"한국관광공사 고캠핑 운영자 등록값","at":"2025-08-04T00:00:00+09:00","g":"c","label":"반려견 불가","icon":"paw"}],"rules":[],"ops":[{"text":"- 수영장 운영(여름 시즌 한정)","url":"http://cbnuo.chungbuk.ac.kr/cbnuo/intro/facility.php","at":"2026-10-20T01:20:19.115Z","src":"운영자 홈페이지"}],"notices":[]},"gcd":{"url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=2992","info":{"주소":"충청북도 진천군 문백면 은진로 29","문의처":"043-532-2341","캠핑장 유형":"자동차야영장","운영기간":"봄, 여름, 가을, 겨울","운영일":"주말","예약방법":"-","주변이용가능시설":"운동장, 수영장"},"intro":"충북대학교 천문대 천문체험학교 캠핑장은 충청북도 진천군 문백면에 위치했다. 진천군청을 기점으로 약 18km 거리에 있으며, 차량을 이용해 생거진천로, 농다리로, 은진로를 차례로 거치면 도착한다. 이동시간은 20분정도 걸린다. 이곳은 도로와 인접해 있어 접근이 쉽고, 천문관측 교육체험과 함께 캠핑을 즐길 수 있다. 사이트 크기와 개수는 가로 5m 세로 5m 파쇄석 15면, 데크 3면이다. 사이트는 간격이 넓고 큰 나무 그늘이 있어 여름철에도 여유롭고 시원한 캠핑을 즐길 수 있다. 화로대, 전기, 무선인터넷을 이용할 수 있다. 개인 트레일러와 카라반 입장이 가능하며, 관리소에서는 텐트, 릴선, 화로대, 식기 를 빌려준다. 캠핑장은 사계절 내내 운영하며, 예약은 온라인 실시간으로만 받는다. 아울러 반려견은 동반 입장이 불가능하다.\n캠핑장 주변에는 증평 미암리 석조관음보살입상, 진천 농다리등 관광지가 즐비하다. 가까운 거리에 여러 음식점이 있어 마음에 드는 요리로 즐길 수 있다.","updated":"2025-08-04","facilities":[{"k":"주요시설","v":"자동차야영장사이트(18면)","items":["자동차야영장사이트(18면)"]},{"k":"기타 정보","v":"개인 트레일러 입장가능","items":["개인 트레일러 입장가능"]},{"k":"기타 부대시설","v":"천체망원경 구경 1m","items":["천체망원경 구경 1m"]},{"k":"바닥형태 (단위