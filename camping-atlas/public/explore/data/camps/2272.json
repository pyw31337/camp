 감상하며 함께 즐길 수 있다.","updated":"2026-06-30","facilities":[{"k":"주요시설","v":"자동차야영장사이트(44면)","items":["자동차야영장사이트(44면)"]},{"k":"기타 정보","v":"개인 트레일러 입장가능","items":["개인 트레일러 입장가능"]},{"k":"바닥형태 (단위:면)","v":"잔디 (34) · 파쇄석 (10)","items":["잔디 (34)","파쇄석 (10)"]},{"k":"캠핑장비대여","v":"캠핑장 문의","items":["캠핑장 문의"]},{"k":"반려동물 출입","v":"불가능"},{"k":"화로대","v":"개별"},{"k":"안전시설현황","v":"소화기 (20) · 화재감지기 (20)","items":["소화기 (20)","화재감지기 (20)"]}],"photos":["https://www.gocamping.or.kr/upload/camp/2272/05219ADkK6fbe3tccNe6MCih.jpg","https://www.gocamping.or.kr/upload/camp/2272/63220bAF7KRB4eBdNwcmtC7G.jpg","https://www.gocamping.or.kr/upload/camp/2272/4296PkwrqcDCkFREToyRJP1Z.jpg","https://www.gocamping.or.kr/upload/camp/2272/5825lenpUHv4qpOAxONfGfft.jpg","https://www.gocamping.or.kr/upload/camp/2272/5932QqwIxUw1VSxotk7vJrHj.jpg","https://www.gocamping.or.kr/upload/camp/2272/6179VC2etIaLFGcKhQ4c4zx1.jpg","https://www.gocamping.or.kr/upload/camp/2272/5710lQWKzIIv00S3rRp2xSZW.jpg","https://www.gocamping.or.kr/upload/camp/2272/25408xvF5C5uWwX09gB4UQAr.jpg","https://www.gocamping.or.kr/upload/camp/2272/5782rrORA40kQSxAIn2TYAU6.jpg","https://www.gocamping.or.kr/upload/camp/2272/9697AD3FUdcsBOj3tTs3VZzA.jpg","https://www.gocamping.or.kr/upload/camp/2272/12190iQFFOpsfjRyupcbBf8F.jpg","https://www.gocamping.or.kr/upload/camp/2272/7656b0H00JmPyM8yexIbgUz8.jpg","https://www.gocamping.or.kr/upload/camp/2272/3486i8izkW1PSev7NctM2pGD.jpg","https://www.gocamping.or.kr/upload/camp/2272/5383N3LyAI4T2lzHiqp3cUUl.jpg"],"layout":["https://www.gocamping.or.kr/upload/camp/2272/4586HGC5TcpTJpCNsQiFFccs.jpg"],"guide":[{"title":"일반캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"일반","values":["30,000","0","0","0"]}]}},{"title":"오토캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"오토캠핑","values":["30,000","0","0","0"]}]}}],"fees":[{"won":30000,"label":"일반캠핑 · 일반","period":"평상시 주중"},{"won":30000,"label":"오토캠핑 · 오토캠핑","period":"평상시 주중"}],"checked_at":"2026-10-20T03:16:3