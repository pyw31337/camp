 수 있다.","updated":"2024-12-09","facilities":[{"k":"주요시설","v":"일반야영장(20면)","items":["일반야영장(20면)"]},{"k":"기타 정보","v":"개인 트레일러 입장가능","items":["개인 트레일러 입장가능"]},{"k":"사이트 크기","v":"8 X 8 : 20개"},{"k":"캠핑장비대여","v":"릴선 · 화로대","items":["릴선","화로대"]},{"k":"반려동물 출입","v":"불가능"},{"k":"화로대","v":"개별"},{"k":"안전시설현황","v":"소화기 (30)","items":["소화기 (30)"]}],"photos":["https://www.gocamping.or.kr/upload/camp/1220/1869M2fSmBA3fuoovJML39v8.jpg","https://www.gocamping.or.kr/upload/camp/1220/6829o35LC6k1v1MOlPb6DOjh.jpg","https://www.gocamping.or.kr/upload/camp/1220/5445q4JkEoP6Eu4S5SnVrCah.jpg","https://www.gocamping.or.kr/upload/camp/1220/7145NAOkKoiQS2XAiZULyXIN.jpg","https://www.gocamping.or.kr/upload/camp/1220/2690uPHLpgjC4MjzzcLPuHfb.jpg"],"guide":[{"title":"일반캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"일반","values":["30,000","30,000","30,000","30,000"]}]}}],"fees":[{"won":30000,"label":"일반캠핑 · 일반","period":"평상시 주중"},{"won":30000,"label":"일반캠핑 · 일반","period":"평상시 주말"},{"won":30000,"label":"일반캠핑 · 일반","period":"성수기 주중"},{"won":30000,"label":"일반캠핑 · 일반","period":"성수기 주말"}],"checked_at":"2026-10-20T04:23:20.024Z"}}