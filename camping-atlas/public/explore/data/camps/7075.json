08","facilities":[{"k":"주요시설","v":"자동차야영장사이트(31면)","items":["자동차야영장사이트(31면)"]},{"k":"캠핑장비대여","v":"캠핑장 문의","items":["캠핑장 문의"]},{"k":"반려동물 출입","v":"불가능"},{"k":"화로대","v":"개별"}],"photos":["https://www.gocamping.or.kr/upload/camp/7075/0284h9ZofBHNYtk6s7nRctjh.jpg","https://www.gocamping.or.kr/upload/camp/7075/3715Eg3C6910rhLdO6gTNU9q.jpg","https://www.gocamping.or.kr/upload/camp/7075/9371Bd0RZOdtGHItTYSleNjy.jpg","https://www.gocamping.or.kr/upload/camp/7075/0140RTjekevWoYtvCtEbktEe.jpg","https://www.gocamping.or.kr/upload/camp/7075/5077DwPpeDRwSBWDAkK2l2lu.jpg","https://www.gocamping.or.kr/upload/camp/7075/1626PbEwgT3Xg5TIaAQdH1GT.jpg","https://www.gocamping.or.kr/upload/camp/7075/2589gcm0lyjXSvp9MUmrt1v8.jpg","https://www.gocamping.or.kr/upload/camp/7075/6467Tsc2lWgwwxsYHYLt47lX.jpg","https://www.gocamping.or.kr/upload/camp/7075/9909522pJIo7JDZJYhXpDpsb.jpg","https://www.gocamping.or.kr/upload/camp/7075/38201fKcBNv3VAfLA2asOmMu.jpg","https://www.gocamping.or.kr/upload/camp/7075/3829q54j2fopQnoE6TO7gT59.jpg","https://www.gocamping.or.kr/upload/camp/7075/2364LPJouGpXTaV9OaQpsOj6.jpg","https://www.gocamping.or.kr/upload/camp/7075/8168txtYTtG8iYz5S3I6Yx05.jpg","https://www.gocamping.or.kr/upload/camp/7075/1719a3ykh9McKcwpRurTMqpr.jpg","https://www.gocamping.or.kr/upload/camp/7075/069671crSGTsHnXoRdQOofmn.jpg","https://www.gocamping.or.kr/upload/camp/7075/37199nhbTYvLadOTHCLIYd75.jpg","https://www.gocamping.or.kr/upload/camp/7075/47235Bkv5pKjKLK533w8bMIy.jpg","https://www.gocamping.or.kr/upload/camp/7075/4028F9w3etuLVL0ISuNL89mY.jpg","https://www.gocamping.or.kr/upload/camp/7075/5032Jdy9ZKXY0KiyOdkbT0BI.jpg"],"layout":["https://www.gocamping.or.kr/upload/camp/7075/2972cgYAlMNT2A9Hu5bclJe9.jpg"],"checked_at":"2026-10-20T04:41:16.740Z"}}