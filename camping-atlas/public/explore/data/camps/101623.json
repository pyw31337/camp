/gocamping.or.kr/upload/camp/101623/30274b7PIzQFa6h0c5NfSXoc.jpg","https://gocamping.or.kr/upload/camp/101623/3232Dlh4nzFX6QAZNP1x3vbE.jpg"],"img_dup":1,"photos":[{"t":"camps/101623/3f4b71b3-t.webp","l":"camps/101623/3f4b71b3-l.webp","w":720,"h":540}],"operator_snippets":[{"text":"단양글램핑&펜션","url":"http://danyangglamping.com/contents/main.html"},{"text":"글램핑 1호~10호","url":"http://danyangglamping.com/contents/main.html"},{"text":"글램핑 11호(체험이벤트룸)","url":"http://danyangglamping.com/contents/main.html"},{"text":"캠핑 데크싸이트","url":"http://danyangglamping.com/contents/main.html"},{"text":"선암계곡물놀이","url":"http://danyangglamping.com/contents/main.html"},{"text":"단양 글램핑&펜션","url":"http://danyangglamping.com/contents/main.html"},{"text":"충북 단양 최대 규모, VVIP를 위한 럭셔리 글램핑!","url":"http://danyangglamping.com/contents/main.html"},{"text":"자연 속 글램핑과 펜션이 공존하는곳","url":"http://danyangglamping.com/contents/main.html"},{"text":"단양 글램핑&펜션과 함께 즐기는 편안한 휴식","url":"http://danyangglamping.com/contents/main.html"},{"text":"탁 트인 시원한 풍경이 함께하는 단양 글램핑&펜션,","url":"http://danyangglamping.com/contents/main.html"},{"text":"글램핑장 배치도","url":"http://danyangglamping.com/contents/main.html"},{"text":"글램핑 11호","url":"http://danyangglamping.com/contents/main.html"},{"text":"업체명 : 단양글램핑&펜션","url":"http://danyangglamping.com/contents/main.html"},{"text":"단양 글램핑&펜션 소개","url":"http://danyangglamping.com/contents/about.html"},{"text":"소백산 선암계곡 앞에 위치한 단양 글램핑&펜션은 자연 속에서 힐링을 즐길 수 있는 최적의 장소입니다.","url":"http://danyangglamping.com/contents/about.html"},{"text":"청정한 계곡물이 흐르는 선암계곡은 주변 경관이 수려하고 물이 맑아 여름철에는 물놀이를 즐기기에 좋고,","url":"http://danyangglamping.com/contents/about.html"},{"text":"또한 저희 글램핑장은 중앙고속도로 단양 IC에서 차로 약 10분 거리에 위치해 있어 접근성도 좋습니다.","url":"http://danyangglamping.com/contents/about.html"},{"text":"펜션 앞에 흐르는","url":"http://danyangglamping.com/contents/about.html"},{"text":"단양 글램핑&펜션이 선사하는 즐거움","url":"http://danyangglamping.com/contents/about.html"},{"text":"자연속 힐링 글램핑&펜션","url":"http://danyangglamping.com/contents/about.html"},{"text":"일상을 특별함으로 채워가는 단양 글램핑&펜션","url":"http://danyangglamping.com/contents/about.html"},{"text":"성수기 안내","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"자세한 성수기 기간은 실시간 예약에서 확인해 주세요.","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"인원 추가요금 안내","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"단, 캠핑 데크싸이트는 기준 인원 초과 시 1인당 1만원 의 추가비용이 발생합니다.","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"입실/퇴실 안내","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"입실시간 : 15시","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"퇴실시간 : 11시","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"부대시설 추가요금 안내","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"바비큐(숯+그릴+석쇠) 이용 요금: 2~4인 20,000원","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"5~8인 30,000원","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"불멍 이용 요금: 1회 20,000원 (장작 추가 10kg 15,000원)","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"펜션 이용객 불멍 이용 시 세팅비 추가 적용(2~4인 10,000원","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"5~8인 15,000원","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"요금 안내","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"성수기 기간은 실시간 예약에서 확인해 주세요.","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"예약 후 24시간 이내 전액 입금하셔야 예약이 완료되며 미입금 시 예약이 자동으로 취소 됩니다.","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"사전 통보 없이 예약금 입금이 안 된 경우에는 예약이 자동으로 취소됩니다.","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"# 인원 추가 안내","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"기준 인원 초과 시 1인당 2만원의 추가요금이 있습니다.","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"/ 데크사이트는 1인당 1만원의 추가요금이 있습니다.","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"기준 인원 초과 시 추가 인원에 대한 비용이 별도로 발생할 수 있습니다.","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"최대 인원 초과 시 입실이 불가능할 수 있으며, 해당 사유로 환불받을 수 없습니다.","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"예약인원(영·유아 포함) 외에 초과 인원은 입실 불가 합니다.","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"# 입퇴실안내","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"퇴실 시 음식물 및 기타 쓰레기는 분리수거 해 주시고, 식기류는 세척해 주시기 바랍니다.","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"입실은 오후 3시부터, 퇴실은 다음날 오전 11시까지입니다.","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"다음 이용 고객을 위해 퇴실 시간을 준수해 주시기 바랍니다.","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"퇴실 시 간단한 정리 부탁드립니다.","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"개인 화로대, 휴대용 전열 및 가스버너 사용은 금지합니다.","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"22:00 매너 타임 시간을 준수해 주시기 바랍니다.","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"강제 퇴실의 사유가 될 수 있습니다.","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"또한 미성년자의 예약 및 이용은 숙소 규정에 따라 결정되며 해당 사유로 환불받을 수 없습니다.","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"# 반려동물 및 벌레","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"반려동물 동반 시 입실이 불가하며, 해당 사유로 환불받을 수 없습니다.","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"환불안내","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"환불 적용은 이용요금 전액 입금 시에만 적용됩니다.","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"환불 시 결제하신 금액에서 취소수수료를 제외한 금액을 환불해 드립니다.","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"예약취소 시 환불 기준을 아래와 같이 운영하고 있사오니 꼭 확인하시고 예약하시길 바랍니다.","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"객실 이용 7일 전 취소 - 기본요금의 90% 환불","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"객실 이용 6일 전 취소 - 기본요금의 80% 환불","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"객실 이용 5일 전 취소 - 기본요금의 70% 환불","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"객실 이용 4일 전 취소 - 기본요금의 50% 환불","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"객실 이용 3일 전 취소 - 기본요금의 40% 환불","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"객실 이용 2일 전 취소 - 기본요금의 30% 환불","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"객실 이용 1일 전 취소 - 기본요금의 10% 환불","url":"http://danyangglamping.com/contents/reserve.html"},{"text":"객실 이용 당일 취소 - 환불 불가","url":"http://danyangglamping.com/contents/reserve.html"}],"field_conditions":{"version":2,"status":"SURVEYED","parking":{"state":"UNKNOWN","mode":"UNKNOWN","tent_side":null,"cart_required":null,"shared_nearby":null,"drop_off_external":null,"auto_camping_sites":null},"shelter_setup":{"state":"UNKNOWN","max_tents":null,"max_tarps":null,"canopy_allowed":null,"note":null},"power":{"state":"CONFIRMED","available":true,"limit_w":null,"regulatory_reference_w":600,"breaker_capacity":null,"statutory_standard":true,"high_power_mention":null},"ground":{"state":"CONFIRMED","types":[{"type":"DECK","count":1},{"type":"GRAVEL","count":10}]},"charcoal":{"state":"SURVEYED","allowed":true},"firewood":{"state":"SURVEYED","allowed":true,"sold":true},"fire_pit":{"state":"SURVEYED","arrangement":"개별"},"site_size":{"state":"UNKNOWN","groups":[]},"sanitary":{"state":"UNKNOWN","toilets_count":null,"showers_count":null,"sinks_count":null,"private_bathroom":false,"private_bathroom_state":"UNKNOWN","hot_water":"24시간","note":null},"features":["SWIMMING_POOL","VALLEY","PLAYGROUND","EXPERIENCE","FOREST_TRAIL"],"rental_offers":[],"source":{"label":"한국관광공사 고캠핑 운영자 등록 및 공식 소개 전수조사","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=101623","checked_at":"2026-01-14T00:00:00+09:00","tier":"A"}},"spec":{"version":1,"generated_at":"2026-10-19T04:15:33.311Z","fields":{"CHECKIN_TIME":{"grade":"OFFICIAL_TEXT","values":[{"value":"15:00부터","quote":"입실시간 : 15시","source":{"kind":"operator_homepage","label":"운영자 홈페이지","url":"http://danyangglamping.com