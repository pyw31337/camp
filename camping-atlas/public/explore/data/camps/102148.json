q.com/05reservation.html"},{"text":"- 애견 동반 불가입니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation.html"},{"text":"- 20시 이후 피칭 절대 불가입니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation.html"},{"text":"- 미성년자는 부모님의 동행이 있어야 이용 가능합니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation.html"},{"text":"- 조기 입촌 및 시간 연장 퇴촌 시 초과 요금 발생됩니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation.html"},{"text":"다음 입실자가 있을 시 연장 불가합니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation.html"},{"text":"- 퇴촌 시 다음 손님을 위해 사이트 정리와 분리수거 쓰레기 정리 후 퇴실 하셔야 합니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation.html"},{"text":"( 깨끗이 해주시고 관리인에게 퇴실 점검을 받으시길 바랍니다.)","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation.html"},{"text":"- 매너 타임은 22:30부터 다음날 07:30까지입니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation.html"},{"text":"매너 타임을 어기고 민원 신고 2회 이상 시 즉시 퇴장 조치 됩니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation.html"},{"text":"- 매너 타임 시 블루투스, 빔프로젝터 등 음향기기 사용 금지","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation.html"},{"text":"- 밤 10시 이후 고성방가로 인해 민원 발생 시 퇴촌 조치","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation.html"},{"text":"- 밤 10시 이후 고성방가나 시끄러운 술자리는 타인에게 불쾌감을 주는 행위이므로 캠핑 에티켓을 지켜주시기 바랍니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation.html"},{"text":"고성 방사로 주변에 피해를 주지 마세요.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation.html"},{"text":"- 모든 사이트는 금연입니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation.html"},{"text":"흡연( 전자담배 포함)은 지정된 장소에서 하시기 바랍니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation.html"},{"text":"화재 방지와 비흡연자들을 위해 매너를 지켜 주시기 바랍니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation.html"},{"text":"야영장에서 흡연 민원 접수 시 즉각 퇴실 조치 됩니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation.html"},{"text":"- 숯불& 장작 이용방법 :주변이 산으로 둘러싸여 있어서 화로대 사용 시 반드시 받침대를 사용하시고 사용 시 화재로 인한 문제가 발생되지 않도록 주의하여 주시고 화로 는 불씨가 완전히 꺼진 후 지정된 장소에서 처리!","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation.html"},{"text":"- 퇴실 시간 엄수.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation.html"},{"text":"- 재활용 쓰레기는 분리 수거장 이용","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation.html"},{"text":"(식사, 담소, 불멍 등 )","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation.html"},{"text":"- 캠핑장 내에서 전기차 충전은 하실 수 없습니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation.html"},{"text":"양지 캠핑장 유의사항","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation02.html"},{"text":"# 양지 이용시 유의사항들 입니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation02.html"},{"text":"- 이용 시간을 준수하시고 퇴장 시 다음 이용객을 위하여 이용한 사이트는 깨끗하게 정리 바랍니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation02.html"},{"text":"- 흡연은 흡연 구역에서만 가능합니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation02.html"},{"text":"- 캠핑장 내 차량은 시속 10Km 이하로 서 행하시고, 매너 타임 시 이동 자제 부탁드립니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation02.html"},{"text":"- 폭죽/풍등/블꽃놀이 사용 불가(화재 위험)","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation02.html"},{"text":"- 밀폐된 곳에서 화로/가스 사용 금지(일산화탄소 중독 우려)","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation02.html"},{"text":"- 고 전력의 전자 제품은 감전/화재 위험으로 사용 불가(사이트 당 사용량은 600W 이하)","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation02.html"},{"text":"- 바비큐 및 불멍 장작 사용 후 숯과 재는 불씨가 꺼진 것을 확인 후, 전용 숯(재) 수거함에 배출 바랍니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation02.html"},{"text":"- 폐수는 반드시 지정된 개수대에 배출 바랍니니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation02.html"},{"text":"- 정치/종교적 홍보활동 금지합니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation02.html"},{"text":"- 관리자의 허가 없이 상업적인 홍보 또는 물품 판매는 금지합니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/05reservation02.html"},{"text":"봄에는 벚꽃길 산책, 여름엔 물놀이 시설과 계곡 물놀이,","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/01about.html"},{"text":"겨울엔 고요한 설경 속 따뜻한 불멍까지 힐링 캠핑장입니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/01about.html"},{"text":"개별 샤워장과 개수대 등 쾌적한 시설과","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/01about.html"},{"text":"가을엔 오색 단풍 캠핑, 겨울엔 고요한 설경 속 따뜻한 불멍까지 힐링 캠핑장입니다.","url":"http://www.xn--le5b8ek5du5cr6etwdvwq.com/01about02.html"}],"field_conditions":{"version":2,"status":"SURVEYED","parking":{"state":"UNKNOWN","mode":"UNKNOWN","tent_side":null,"cart_required":null,"shared_nearby":null,"drop_off_external":null,"auto_camping_sites":null},"shelter_setup":{"state":"UNKNOWN","max_tents":null,"max_tarps":null,"canopy_allowed":null,"note":null},"power":{"state":"SURVEYED","available":true,"limit_w":600,"regulatory_reference_w":null,"breaker_capacity":"2.7A","statutory_standard":false,"high_power_mention":null},"ground":{"state":"CONFIRMED","types":[{"type":"CRUSHED_STONE","count":25}]},"charcoal":{"state":"SURVEYED","allowed":true},"firewood":{"state":"SURVEYED","allowed":true,"sold":true},"fire_pit":{"state":"SURVEYED","arrangement":"개별"},"site_size":{"state":"CONFIRMED","groups":[{"width_m":6,"depth_m":8,"count":20},{"width_m":7,"depth_m":8,"count":5}]},"sanitary":{"state":"CONFIRMED","toilets_count":25,"showers_count":25,"sinks_count":25,"private_bathroom":true,"private_bathroom_state":"SURVEYED","hot_water":"제공","note":"단독 개별 화장실/욕실 구비"},"features":["SWIMMING_POOL","VALLEY","PLAYGROUND","FOREST_TRAIL"],"rental_offers":[],"source":{"label":"한국관광공사 고캠핑 운영자 등록 및 공식 소개 전수조사","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=102148","checked_at":"2026-06-30T00:00:00+09:00","tier":"A"}},"spec":{"version":1,"generated_at":"2026-10-30T18:32:48.305Z","fields":{"CHECKIN_TIME":{"grade":"MENTION","values":[],"mentions":[{"value":"14:00부터","count":1,"latest":"2026-05-30","samples":[{"quote":"주소 충남 천안시 동남구 북면 위례성로 321부터 ⏰ check in - out 입실 - 14:00 퇴실 - 12:00","url":"https://blog.naver.com/soso__vvv/224300817335","label":"맛따라 멋따라 브로그","date":"2026-05-30"