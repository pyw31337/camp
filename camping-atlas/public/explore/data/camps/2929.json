site_types":[{"code":"PITCH","label":"일반 사이트","count":47,"sub":null,"grade":"CONFIRMED","src":"gocamping","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=2929","at":"2026-01-15T00:00:00+09:00","quote":null},{"code":"GLAMPING","label":"글램핑","count":15,"sub":null,"grade":"CONFIRMED","src":"gocamping","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=2929","at":"2026-01-15T00:00:00+09:00","quote":null},{"code":"CARAVAN","label":"카라반","count":null,"sub":null,"grade":"MENTION","src":"blog_mention","url":"https://blog.naver.com/shyundu/223285592537","at":"2023-12-07","quote":"[경기_이천] 청암관광농원 카라반/글램핑. 주소: 경기 이천시 부발읍 황무로1720번길 74 청암관광농원"}],"house_rules":{"v":1,"tags":[{"k":"NO_PET","quote":"반려동물 동반: 불가능","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=2929","src":"한국관광공사 고캠핑 운영자 등록값","at":"2026-01-15T00:00:00+09:00","g":"c","label":"반려견 불가","icon":"paw"}],"rules":[],"ops":[],"notices":[]},"gcd":{"url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=2929","info":{"주소":"경기도 이천시 부발읍 황무로1720번길 74","문의처":"031-632-5082","캠핑장 유형":"일반야영장","운영기간":"봄, 가을","운영일":"주말","예약방법":"전화, 온라인실시간예약","주변이용가능시설":""},"intro":"경치 좋은 농원 속에 자리한 청암관광농원 캠핑장은 넓은 부지에 자연을 고스란히 담아낸 힐링 공간입니다. 캠핑장은 사방이 푸른 숲으로 둘러싸여 있으며, 각종 나무가 드리워져 있어 계절마다 다른 풍경을 감상할 수 있습니다. 천연 잔디 위에 텐트를 설치할 수 있는 특별한 경험은 다른 곳에서 쉽게 접하기 어려운 이곳만의 매력입니다.\n캠핑장 중심에는 아름다운 연못과 수영장이 조성되어 있어 여름철 시원한 물놀이와 사계절 내내 잔잔한 풍경을 즐길 수 있습니다. 연못가에 비친 나무와 하늘은 고즈넉한 분위기를 자아내며, 아이들은 수영장에서 신나는 시간을 보낼 수 있어 가족 단위 캠핑객들에게 인기가 높습니다.\n또한 캠핑장 전역은 운영자의 세심한 관리로 시설이 매우 깨끗하게 유지됩니다. 화장실, 샤워실, 개수대 등 편의시설은 청결하고 최신식으로 관리되고 있어 누구나 쾌적하게 머물 수 있습니다. 넓게 설계된 사이트는 간격이 여유 있어 프라이빗한 분위기를 보장하며, 숲과 어우러져 조용한 힐링 시간을 제공합니다.\n부대시설도 충실합니다. 매점과 식당이 함께 운영되고 있어 간단한 먹거리나 캠핑에 필요한 물품을 손쉽게 구매할 수 있으며, 현장에서 따뜻한 식사를 즐길 수도 있습니다. 덕분에 장비가 부족한 초보 캠퍼도 불편 없이 방문할 수 있습니다.\n청암관광농원 캠핑장은 탁월한 경치, 천연 잔디의 특별한 캠핑 경험, 연못과 수영장이 주는 즐거움, 그리고 편리한 시설까지 모두 갖춘 캠핑장입니다. 서울·수도권에서 부담 없이 찾아올 수 있는 힐링 명소로, 가족과 연인, 친구 모두에게 잊지 못할 추억을 선사할 것입니다.","updated":"2026-01-15","facilities":[{"k":"주요시설","v":"일반야영장(47면) · 글램핑시설(15면)","items":["일반야영장(47면)","글램핑시설(15면)"]},{"k":"바닥형태 (단위:면)","v":"잔디 (47)","items":["잔디 (47)"]},{"k":"사이트 크기","v":"10 X 10 : 47개"},{"k":"글램핑 내부시설","v":"침대 · TV · 에어컨 · 냉장고 · 유무선인터넷 · 난방기구 · 취사도구","items":["침대","TV","에어컨","냉장고","유무선인터넷","난방기구","취사도구"]},{"k":"캠핑장비대여","v":"릴선 · 일산화탄소감지기","items":["릴선","일산화탄소감지기"]},{"k":"반려동물 출입","v":"불가능"},{"k":"화로대","v":"개별"},{"k":"안전시설현황","v":"소화기 (50) · 방화수 (2) · 화재감지기 (20)","items":["소화기 (50)","방화수 (2)","화재감지기 (20)"]}],"photos":["https://www.gocamping.or.kr/upload/camp/2929/19981x3FHhSNO7lyoza8NYQO.jpg","https://www.gocamping.or.kr/upload/camp/2929/8133kK7UHEE2TPatkyqVNxXG.jpg","https://www.gocamping.or.kr/upload/camp/2929/5116ku93soqXqD1qhJ2n6JKd.jpg","https://www.gocamping.or.kr/upload/camp/2929/8980TY9pS6eQxFIBtfNeHn7x.jpg","https://www.gocamping.or.kr/upload/camp/2929/90863TRNqBrmLuttiSuELlCU.jpg","https://www.gocamping.or.kr/upload/camp/2929/8276TMLXbg7kKvfocqGtpyDD.jpg","https://www.gocamping.or.kr/upload/camp/2929/7665wDXjX2mNNg8TpEOFxO2y.jpg","https://www.gocamping.or.kr/upload/camp/2929/6544nZNjTg0oKbgiAtfimrFx.jpg","https://www.gocamping.or.kr/upload/camp/2929/90559Fge8zofLwgihisNkcNs.jpg","https://www.gocamping.or.kr/upload/camp/2929/6011VoNdl6tsYGUBvR6s7X0j.jpg","https://www.gocamping.or.kr/upload/camp/2929/7274JreKpFJbCBiE6aamTHkj.jpg","https://www.gocamping.or.kr/upload/camp/2929/6104YreOfgsMF4NmJ6mYf8w1.jpg","https://www.gocamping.or.kr/upload/camp/2929/9060TxT9Zyowg2sSIW4s8F9K.jpg","https://www.gocamping.or.kr/upload/camp/2929/2496cS02qZ3PArpgtuZiBVzT.jpg","https://www.gocamping.or.kr/upload/camp/2929/0646wN893mh9NK6JqMiAt9iz.jpg","https://www.gocamping.or.kr/upload/camp/2929/02934w6T8UptR8UWsuEvOkYZ.jpg","https://www.gocamping.or.kr/upload/camp/2929/8412Pv50hw0ExKPXNAk4Ii00.jpg","https://www.gocamping.or.kr/upload/camp/2929/00398VNfjzGQ71nXbFajHWGL.jpg","https://www.gocamping.or.kr/upload/camp/2929/7041wsM5ImXUZfFiJvFQ0Y8q.jpg","https://www.gocamping.or.kr/upload/camp/2929/93271DTuKepeM