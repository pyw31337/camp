//postfiles.pstatic.net/MjAyNDA3MDFfMTI3/MDAxNzE5ODAzNDQyNjE3.lYlDxuVb2GC95F3_qVVZfsc9w7Ht7q06YF3KeBwIaxUg.XQ-ZlSYxG0Ga434mCqNXKVQ6Uw3J1EkA6JdkZCXBewQg.JPEG/20240628_104032.jpg?type=w773"},{"t":"web","title":"설악동자동차야영장 — 카라반, 오토캠핑장, 놀이터 — 강원 속초시 설악동","snippet":"설악동자동차야영장은 강원특별자치도 속초시 청봉로 25에 위치한 캠핑장입니다. 바베큐, 봄꽃여행, 반려동물, 전화번호를 확인할 수 있습니다.","url":"https://opendatflow.com/camping-sites/792","src":"opendatflow.com","date":null}],"web_checked_at":"2026-10-19T05:17:06.591Z","house_rules":{"v":1,"tags":[{"k":"NO_PET","quote":"반려동물 동반: 불가능","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=1668","src":"한국관광공사 고캠핑 운영자 등록값","at":"2026-08-31T00:00:00+09:00","g":"c","label":"반려견 불가","icon":"paw"},{"k":"NO_FIREWOOD","quote":"산림보호구역 (장작 불가, 숯만 가능)","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=1668","src":"한국관광공사 고캠핑 운영자 등록 및 공식 소개 전수조사","at":"2026-08-31T00:00:00+09:00","g":"c","label":"장작 불가","icon":"flame"}],"rules":[],"ops":[],"notices":[]},"gcd":{"url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=1668","info":{"주소":"강원특별자치도 속초시 청봉로 25 (설악동)","문의처":"033-801-0903","캠핑장 유형":"자동차야영장","운영기간":"봄, 여름, 가을, 겨울","운영일":"평일+주말","예약방법":"온라인실시간예약","주변이용가능시설":"산책로, 어린이놀이시설"},"intro":"설악동자동차야영장은 강원도 속초시에 자리했다. 동해고속도로 북양양IC에서 북양양, 설악산 방면 좌측 방향으로 약 10분만 달리면 도착한다. 이곳은 설악산국립공원 내에 위치한 덕분에 연중 싱그러움을 맛볼 수 있다. 한국 최대 규모의 야영장으로 유명해 전국에서 많은 캠퍼가 즐겨 찾는다. 자동차야영지는 140동(전영지 전기사용 가능), 캠핑용차량전용야영지 13동, 카라반(4인) 13동이 있다. 넓은 캠핑장이지만 곳곳에 개수대, 샤워장, 화장실을 비치해 불편함이 없다. 매점을 운영하지 않지만, 캠핑장에서 약 10분 거리에 슈퍼와 편의점이 있다. 화로 사용은 모든 사이트에서 가능하다.","updated":"2026-08-31","facilities":[{"k":"주요시설","v":"자동차야영장사이트(140면) · 카라반(13면) · 개인카라반사이트(13면) · 덤프스테이션(13기)","items":["자동차야영장사이트(140면)","카라반(13면)","개인카라반사이트(13면)","덤프스테이션(13기)"]},{"k":"기타 정보","v":"개인 트레일러 입장가능","items":["개인 트레일러 입장가능"]},{"k":"기타 부대시설","v":"관리사무소 1동, 놀이터 1개소, 화장실 3동, 세척장 4동, 샤워장 2동, 복합동(화장실, 세척장, 샤워장) 1동, 워케이션 센터 1동","items":["관리사무소 1동, 놀이터 1개소, 화장실 3동, 세척장 4동, 샤워장 2동, 복합동(화장실, 세척장, 샤워장) 1동, 워케이션 센터 1동"]},{"k":"사이트 간격","v":"3M"