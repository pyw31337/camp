은 필수다.","updated":"2026-07-13","facilities":[{"k":"주요시설","v":"일반야영장(30면)","items":["일반야영장(30면)"]},{"k":"기타 정보","v":"개인 트레일러 입장가능","items":["개인 트레일러 입장가능"]},{"k":"사이트 간격","v":"2M"},{"k":"바닥형태 (단위:면)","v":"파쇄석 (22)","items":["파쇄석 (22)"]},{"k":"캠핑장비대여","v":"캠핑장 문의","items":["캠핑장 문의"]},{"k":"반려동물 출입","v":"불가능"},{"k":"화로대","v":"캠핑장 문의"},{"k":"안전시설현황","v":"소화기 (35)","items":["소화기 (35)"]}],"photos":["https://www.gocamping.or.kr/upload/camp/7084/3793UrHZguN0rz8X97hIqJ9Z.jpg","https://www.gocamping.or.kr/upload/camp/7084/0193e7sWRShSBBgKADIDfkfo.jpg","https://www.gocamping.or.kr/upload/camp/7084/5751Ydy8YmrV2HMy3iJjJvgn.jpg","https://www.gocamping.or.kr/upload/camp/7084/1258HvASpT2zfyNvvDB6sHyT.jpg","https://www.gocamping.or.kr/upload/camp/7084/6789RxnIH6Sz7MES9SiE1NE0.jpg","https://www.gocamping.or.kr/upload/camp/7084/8912lwc9yA2KVp3eJUDrrLFR.jpg","https://www.gocamping.or.kr/upload/camp/7084/0205nzHqxc7YWagnkhSgKqSp.jpg","https://www.gocamping.or.kr/upload/camp/7084/8296fKHrmOJoUNGRLbi3lstg.jpg","https://www.gocamping.or.kr/upload/camp/7084/8107ADuWZh7Q0Y4z0FvS1Snp.jpg","https://www.gocamping.or.kr/upload/camp/7084/0046uEGM23UHgqyytISbYufU.jpg","https://www.gocamping.or.kr/upload/camp/7084/08407CuvURDIrpWGOgc0oLxq.jpg"],"guide":[{"title":"일반캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"일반","values":["30,000","30,000","40,000","40,000"]}]}}],"fees":[{"won":30000,"label":"일반캠핑 · 일반","period":"평상시 주중"},{"won":30000,"label":"일반캠핑 · 일반","period":"평상시 주말"},{"won":40000,"label":"일반캠핑 · 일반","period":"성수기 주중"},{"won":40000,"label":"일반캠핑 · 일반","period":"성수기 주말"}],"checked_at":"2026-10-20T03:14:30.310Z"}}