":"개인 트레일러 입장가능","items":["개인 트레일러 입장가능"]},{"k":"사이트 간격","v":"3M"},{"k":"바닥형태 (단위:면)","v":"파쇄석 (22)","items":["파쇄석 (22)"]},{"k":"캠핑장비대여","v":"릴선 · 난방기구","items":["릴선","난방기구"]},{"k":"반려동물 출입","v":"불가능"},{"k":"화로대","v":"개별"},{"k":"안전시설현황","v":"소화기 (40)","items":["소화기 (40)"]}],"photos":["https://www.gocamping.or.kr/upload/camp/28/8089tYNxjEWXJrj2qgfAhEFn.jpg","https://www.gocamping.or.kr/upload/camp/28/6007hmsuHw0rHIlseDKaHa8f.jpg","https://www.gocamping.or.kr/upload/camp/28/2445ERjoVvLPLNDV04PfmwtX.jpg","https://www.gocamping.or.kr/upload/camp/28/2442CjTMfAEhO5Cq6oJnXLxT.jpg","https://www.gocamping.or.kr/upload/camp/28/4394b8pCC167xCewK9msNOsQ.jpg","https://www.gocamping.or.kr/upload/camp/28/558585rbYlsbhSMb9VlM7qhT.jpg","https://www.gocamping.or.kr/upload/camp/28/7784Gk7cDPi5IYK361TLzmhM.jpg","https://www.gocamping.or.kr/upload/camp/28/3751paTftWs5NdLi3edEyEjv.jpg","https://www.gocamping.or.kr/upload/camp/28/2140qkqY3uOVIFUBWP9pbuWo.jpg","https://www.gocamping.or.kr/upload/camp/28/8251XinvSHiWceJjhQCdtYME.jpg","https://www.gocamping.or.kr/upload/camp/28/5728KttG2i8bcJc9iSXpJ9Vj.jpg","https://www.gocamping.or.kr/upload/camp/28/3068zetiy9PHHKknUP2U03bq.png"],"layout":["https://www.gocamping.or.kr/upload/camp/28/2813ttfoHjScIRsXwEjGMUMg.png"],"guide":[{"title":"일반캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"일반","values":["40,000","50,000","50,000","50,000"]},{"label":"일반 (개인 카라반 사용 시)","values":["40,000","50,000","50,000","50,000"]}]}}],"fees":[{"won":40000,"label":"일반캠핑 · 일반","period":"평상시 주중"},{"won":50000,"label":"일반캠핑 · 일반","period":"평상시 주말"},{"won":50000,"label":"일반캠핑 · 일반","period":"성수기 주중"},{"won":50000,"label":"일반캠핑 · 일반","period":"성수기 주말"},{"won":40000,"label":"일반캠핑 · 일반 (개인 카라반 사용 시)","period":"평상시 주중"},{"won":50000,"label":"일반캠핑 · 일반 (개인 카라반 사용 시)","period":"평상시 주말"},{"won":50000,"label":"일반캠핑 · 일반 (개인 카라반 사용 시)","period":"성수기 주중"},{"won":50000,"label":"일반캠핑 · 일반 (개인 카라반 사용 시)","period":"성수기 주말"}],"checked_at":"2026-10-20T03:50: