 노키즈존으로 운영된다. 가까운 거리에 국립회문산자연휴양림이 있어 캠핑과 겸해 연계 여행을 즐길 수 있다.","updated":"2024-12-02","facilities":[{"k":"주요시설","v":"일반야영장(13면) · 자동차야영장사이트(7면)","items":["일반야영장(13면)","자동차야영장사이트(7면)"]},{"k":"바닥형태 (단위:면)","v":"파쇄석 (15) · 테크 (5)","items":["파쇄석 (15)","테크 (5)"]},{"k":"캠핑장비대여","v":"캠핑장 문의","items":["캠핑장 문의"]},{"k":"반려동물 출입","v":"불가능"},{"k":"화로대","v":"개별"},{"k":"안전시설현황","v":"소화기 (14)","items":["소화기 (14)"]}],"photos":["https://www.gocamping.or.kr/upload/camp/100902/6352KIxRA39SOmegS1fMAM6c.jpg","https://www.gocamping.or.kr/upload/camp/100902/3841a5fFyVkodLYW54Yyj46N.jpg","https://www.gocamping.or.kr/upload/camp/100902/0416XhtqSOM76km9ZMlVPxs0.jpg","https://www.gocamping.or.kr/upload/camp/100902/97725YViTChRUcqd7Wq06eQc.jpg"],"layout":["https://www.gocamping.or.kr/upload/camp/100902/0552Z1MGiYBam0NxabqLOcg2.jpg"],"guide":[{"title":"일반캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"일반","values":["40,000 ~40,000","60,000 ~60,000","40,000 ~40,000","60,000 ~60,000"]}]}},{"title":"오토캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"오토캠핑","values":["40,000 ~40,000","60,000 ~60,000","40,000 ~40,000","60,000 ~60,000"]}]},"images":["https://www.gocamping.or.kr/upload/camp/cvntl/873/6310CTFLEMQ4jl7hNnsWti9O.jpg","https://www.gocamping.or.kr/upload/camp/cvntl/872/8490mpWxkCpvwyD6abdxYsiz.jpg"]}],"checked_at":"2026-10-20T04:24:31.252Z"}}