r/bsite/camp/info/read.do?c_no=1234","at":"2026-04-09T00:00:00+09:00","quote":null},{"code":"RV","label":"캠핑카·트레일러","count":null,"sub":null,"grade":"CONFIRMED","src":"gocamping","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=1234","at":"2026-04-09T00:00:00+09:00","quote":"트레일러 입장 가능"}],"house_rules":{"v":1,"tags":[{"k":"BIG_DOG","quote":"반려동물 동반: 가능(소형견)","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=1234","src":"한국관광공사 고캠핑 운영자 등록값","at":"2026-04-09T00:00:00+09:00","g":"c","label":"반려견 제한","icon":"paw"}],"rules":[{"cat":"ban","text":"충동 계약 금지 : 현장 분위기에 휩쓸리지 말고 충분히 비교 후 결정","url":"https://bambyul.co.kr/","at":"2026-10-20T01:10:16.946Z","src":"운영자 홈페이지"},{"cat":"limit","text":"일부 박람회는 사진 촬영이 제한될 수 있으므로 체크리스트·메모지 를 꼭 챙기세요.","url":"https://bambyul.co.kr/","at":"2026-10-20T01:10:16.946Z","src":"운영자 홈페이지"}],"ops":[],"notices":[]},"gcd":{"url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=1234","info":{"주소":"충청북도 충주시 앙성면 모점리 169-4","문의처":"043-854-1133 , 010-2822-1133","캠핑장 유형":"자동차야영장","운영기간":"봄, 여름, 가을, 겨울","운영일":"평일+주말","예약방법":"-","주변이용가능시설":""},"intro":"밤별 캠핑장은 충북 충주시 앙성면에 위치했다. 충주시청을 기점으로 약 36km 거리에 있으며, 자동차를 타고 충원대로, 북부로, 앙암로를 차례로 거치면 닿는다. 도착까지 소요시간은 45분 남짓이다. 이곳은 도로와 인접해 접근이 쉽고 숲에 조성한 덕분에 자연을 벗 삼아 캠핑을 즐길 수 있다. 캠핑장에는 파쇄석 50면, 데크 30면, 잔디 10면으로 이뤄진 일반 야영장 80면을 배치했다. 개인 트레일러와 카라반 입장이 가능하며, 이용료는 야영장과 동일하다. 관리소에서는 릴선, 화로대, 난방기구, 식기를 빌려준다. 매점은 캠핑장 중앙에 위치했고, 장작, 육류, 유기농 밤, 일회용품, 부식 등 다양한 품목을 판매 중이다. 캠핑장은 연중 운영하며, 예약은 현장접수와 온라인 실시간으로만 받는다.\n캠핑장 인근 관광지로 다양한 효능이 있는 앙성 탄산온천과 조선시대의 석조여래입상 충주 강천리 석불입상 있다. 한우암소구이를 맛볼 수 있는 음식점 오시며가시며도 있다.","updated":"2026-04-09","facilities":[{"k":"주요시설","v":"일반야영장(80면) · 카라반(20면)","items":["일반야영장(80면)","카라반(20면)"]},{"k":"기타 정보","v":"개인 트레일러 입장가능","items":["개인 트레일러 입장가능"]},{"k":"사이트 간격","v":"7M"},{"k":"바닥형태 (단위:면)","v":"잔디 (10) · 파쇄석 (60) · 테크 (30)","items":["잔디 (10)","파쇄석 (60)","테크 (30)"]},{"k":"사이트 크기","v":"4 X 6 : 30개 · 6 X 9 : 50개"},{"k":"캠핑장비대여","v":"릴선 · 화로대 · 난방기구 · 식기","items":["릴선","화로대","난방기구","식기"]},{"k":"반려동물 출입","v":"소형견만 가능"},{"k":"화로대","v":"개별"},{"k":"안전시설현황","v":"소화기 (20) · 방화수 (4) · 화재감지기 (10)","items":["소화기 (20)","방화수 (4)","화재감지기 (10)"]}],"photos":["https://www.gocamping.or.kr/upload/camp/1234/5810ABIjxGJhU0tPriX4IHtr.jpg","https://www.gocamping.or.kr/upload/camp/1234/8169ToCcmPkupLZYnwGiRZCe.jpg","https://www.gocamping.or.kr/upload/camp/1234/4920WWUFxVMJmXpHOZjzMsVU.jpg","https://www.gocamping.or.kr/upload/camp/1234/726476uaZ2r1IBd3t9j8p5dk.jpg","https://www.gocamping.or.kr/upload/camp/1234/85939ITzeNAqXCtgQPUOtQBZ.jpg","https://www.gocamping.or.kr/upload/camp/1234/8995uzB0Dm7soGPlwWApPKEM.jpg","https://www.gocamping.or.kr/upload/camp/1234/7611wwhQygDxPdkRJtHRBz9D.jpg","https://www.gocamping.or.kr/upload/camp/1234/5803DLt2qTsAya9uhe1G5Osb.jpg","https://www.gocamping.or.kr/upload/camp/1234/2641szxXDgp3njDM8h1qfLKb.jpg","https://www.gocamping.or.kr/upload/camp/1234/8315xGYArWRbPgwkGGxXtOHr.jpg","https://www.gocamping.or.kr/upload/camp/1234/8737drfzAqISRlIvEPuBEA2n.jpg","https://www.gocamping.or.kr/upload/camp/1234/9096EYe4tjXe5vXTpkyGxKx0.jpg","https://www.gocamping.or.kr/upload/camp/1234/1814ohMHCQQfkym9XsSV9Mno.jpg","https://www.gocamping.or.kr/upload/camp/1234/6986Gt834K1KAPTqkkn9vK08.jpg","https://www.gocamping.or.kr/upload/camp/1234/3708PHbmcTE2bj2BDXUXjHym.jpg","https://www.gocamping.or.kr/upload/camp/1234/6194NBLhJjaGS97ajqhEfPmg.jpg","https://www.gocamping.or.kr/upload/camp/1234/0955yCYB1se1Ros2P8nQS2X2.jpg"],"layout":["https://www.gocamping.or.kr/upload/camp/1234/0791VLDQZq6FuoqpNTTmHjPF.jpg"],"guide":[{"title":"일반캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"일반","values":["35,000 ~50,000","35,000 ~50,000","35,000 ~50,000","35,000 ~50,000"]},{"label":"일반 (개인 카라반 사용 시)","values":["350,000 ~50,000","35,000 ~50,000","35,000 ~50,000","35,000 ~50,000"]}]}}],"checked_at":"2026-10-20T03:24:26.066Z"}}