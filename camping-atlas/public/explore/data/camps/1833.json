l":"https://www.geochang.go.kr/ssd/Index.do","date":"2026-01-01"},"period":null}],"mentions":[],"conflict":false}},"stats":{"facts":5,"reviews_used":0,"roundups_skipped":0}},"rv":{"n":2,"p":[],"c":[],"details":{"pros":[],"cons":[],"issues":[]}},"house_rules":{"v":1,"tags":[{"k":"NO_PET","quote":"반려동물 동반: 불가능","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=1833","src":"한국관광공사 고캠핑 운영자 등록값","at":"2024-01-22T00:00:00+09:00","g":"c","label":"반려견 불가","icon":"paw"},{"k":"NO_FIRE","quote":"화기 사용 전면 금지","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=1833","src":"한국관광공사 고캠핑 운영자 등록 및 공식 소개 전수조사","at":"2024-01-22T00:00:00+09:00","g":"c","label":"화기 불가","icon":"flame"}],"rules":[],"ops":[],"notices":[]},"gcd":{"url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=1833","info":{"주소":"경상남도 거창군 위천면 강천리 3번지","문의처":"055-940-8530","캠핑장 유형":"일반야영장","운영기간":"봄, 여름, 가을","운영일":"평일+주말","예약방법":"온라인실시간예약","주변이용가능시설":"계곡 물놀이"},"intro":"덕유산 자락 국가 지정 명승 제53호 ‘수승대 관광지’ 내 위치한 수승대야영장은 일반야영 사이트(데크) 86개와 취사장, 화장실, 샤워장(온수시설) 등 각종 편의시설을 갖추고 있는 거창군 직영 야영장으로 캠핑 애호가들에게 큰 사랑을 받고있다. 앞·뒤로 시원한 그늘을 만들어주는 소나무 숲과 맑은 덕유산 계곡물을 즐길 수 있는 수승대야영장은 4계절 관광지로 알려져 매년 5만여 명 이상의 이용객들이 찾는 명소이다.\n야영 성수기인 7월~8월 중 거창 수승대야영장을 찾으면, 계곡물을 가둬 수위를 적정하게 조절한 야외 수영장에서 아이와 어른 모두 안심하고 물놀이를 즐길 수 있다. 또 거창국제연극제 기간(7월말~8월초)에 수승대 야영장을 찾는 관광객은 쏟아지는 별빛 아래 인생 연극 한 편을 감상할 수 있는 특권도 누릴 수 있다.\n그 외에도 수승대 관광지에는 목공체험을 할 수 있는 목재문화체험관, 계곡을 가로지르는 240m 길이의 아찔한 수승대 출렁다리, 겨울철에 운영되는 눈썰매장 등 다양한 즐길 거리가 있는 사계절 야영장으로 가족 단위 야영객은 꼭 한번 들러보기를 권장한다.\n아울러 ‘수승대 관광지’ 내에는 자동차 야영장인 수승대 오토캠핑장도 별도운영 되고 있어 카라반이나 캠핑카 등을 이용한 캠핑 애호가들의 방문도 환영한다.","updated":"2024-01-22","facilities":[{"k":"주요시설","v":"일반야영장(84면)","items":["일반야영장(84면)"]},{"k":"기타 정보","v":"개인 트레일러 입장가능","items":["개인 트레일러 입장가능"]},{"k":"바닥형태 (단위:면)","v":"테크 (84)","items":["테크 (84)"]},{"k":"사이트 크기","v":"4 X 3 : 84개"},{"k":"캠핑장비대여","v":"캠핑장 문의","items":["캠핑장 문의"]},{"k":"반려동물 출입","v":"불가능"},{"k":"화로대","v":"불가"},{"k":"안전시설현황","v":"소화기 (42)","items":["소화기 (42)"]}],"photos":["https:/