도 운영 중이다. 부대시설로는 펜션, 카페, 잔디광장, 유기동 채소 온실 등이 있다. 인근에 칠곡양떼목장 등 칠곡의 유명 관광지가 수두룩해 연계 여행에 나서기 순조롭다.","updated":"2024-12-02","facilities":[{"k":"주요시설","v":"자동차야영장사이트(8면)","items":["자동차야영장사이트(8면)"]},{"k":"기타 부대시설","v":"카페, 펜션, 잔디광장, 유기농 채소 온실","items":["카페, 펜션, 잔디광장, 유기농 채소 온실"]},{"k":"바닥형태 (단위:면)","v":"파쇄석 (8)","items":["파쇄석 (8)"]},{"k":"글램핑 내부시설","v":"침대 · 에어컨 · 냉장고 · 난방기구","items":["침대","에어컨","냉장고","난방기구"]},{"k":"캠핑장비대여","v":"캠핑장 문의","items":["캠핑장 문의"]},{"k":"반려동물 출입","v":"가능"},{"k":"화로대","v":"개별"},{"k":"안전시설현황","v":"소화기 (8) · 화재감지기 (4)","items":["소화기 (8)","화재감지기 (4)"]}],"photos":["https://www.gocamping.or.kr/upload/camp/101174/4724UrEoZt4laUfIGDJV5E7U.jpg","https://www.gocamping.or.kr/upload/camp/101174/0852Afx9EFPIoYQp4pl18rNi.jpg","https://www.gocamping.or.kr/upload/camp/101174/2143YMtzlwGXmsyQ2RpemM0n.jpg","https://www.gocamping.or.kr/upload/camp/101174/5473HihyZ9Af27IuzMsmNEDy.jpg","https://www.gocamping.or.kr/upload/camp/101174/6669tFXWQknckt7lqCqMFM0k.jpg","https://www.gocamping.or.kr/upload/camp/101174/7838JH98LRqZmWNUMc2dqp27.jpg","https://www.gocamping.or.kr/upload/camp/101174/4112GiUt1WzBcJX9afd2YbcK.jpg","https://www.gocamping.or.kr/upload/camp/101174/1131F5uMaCU8mcmtnJ7InB5M.jpg","https://www.gocamping.or.kr/upload/camp/101174/4112w7udv1C8PFZuFUHhgjDM.jpg","https://www.gocamping.or.kr/upload/camp/101174/7849WS1vwBq1u5gbDttRtQFA.jpg"],"layout":["https://www.gocamping.or.kr/upload/camp/101174/6212lI8g7dy70dh38qP9sh76.jpg"],"guide":[{"title":"오토캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"오토캠핑","values":["40,000 ~40,000","60,000 ~60,000","40,000 ~40,000","60,000 ~60,000"]}]}},{"title":"글램핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"글램핑","values":["150,000 ~150,000","150,000 ~150,000","150,000 ~150,000","150,000 ~150,000"]}]},"images":["https://www.gocamping.or.kr/upload/camp/cvntl/802/4756NO6My7uthPQIucbjQRAl.jpg","https://www.gocamping.or.kr/upload/camp/cvntl/801/6103GvejVsg6pJSrXVPLvFoc.jpg","https