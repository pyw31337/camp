/camp/info/read.do?c_no=640","src":"한국관광공사 고캠핑 운영자 등록값","at":"2026-10-27T00:00:00+09:00","g":"c","label":"반려견 불가","icon":"paw"}],"rules":[],"ops":[],"notices":[]},"gcd":{"url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=640","info":{"주소":"강원특별자치도 영월군 김삿갓면 내리계곡로 1061","문의처":"070-8064-5833","캠핑장 유형":"일반야영장","운영기간":"봄, 여름, 가을, 겨울","운영일":"평일+주말","예약방법":"온라인실시간예약","주변이용가능시설":"계곡 물놀이, 수영장"},"intro":"강원특별자치도 영월군 김삿갓면에 위치한 느티나무캠핑장은 사계절 온수풀을 운영하면서 넓은 계곡을 품은 캠핑장이다. 아이들을 위한 프로그램과 무료 조식 등의 다양한 이벤트를 진행하고 있으며 쾌적한 사이트 크기와 나무그늘을 자랑한다. 계곡에서는 물놀이와 카약을 즐길 수 있으며, 어른들을 위한 무료막걸리 체험 이벤트도 진행된다. 시즌별로 다양한 이벤트로 가족캠핑, 키즈캠핑을 원하는 고객들에게 인기 많은 캠핑장이다. 영월, 제천 방면에서 김삿갓, 봉화 방면으로 진행하면 천혜의 내리계곡을 접한 느티나무캠핑장을 만날 수 있다.","updated":"2024-12-11","facilities":[{"k":"주요시설","v":"일반야영장(38면)","items":["일반야영장(38면)"]},{"k":"사이트 간격","v":"1M"},{"k":"바닥형태 (단위:면)","v":"파쇄석 (38)","items":["파쇄석 (38)"]},{"k":"사이트 크기","v":"6 X 10 : 38개"},{"k":"캠핑장비대여","v":"캠핑장 문의","items":["캠핑장 문의"]},{"k":"반려동물 출입","v":"불가능"},{"k":"화로대","v":"개별"},{"k":"안전시설현황","v":"소화기 (18)","items":["소화기 (18)"]}],"guide":[{"title":"일반캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"일반","values":["45,000","70,000","70,000","90,000"]}]}}],"fees":[{"won":45000,"label":"일반캠핑 · 일반","period":"평상시 주중"},{"won":70000,"label":"일반캠핑 · 일반","period":"평상시 주말"},{"won":70000,"label":"일반캠핑 · 일반","period":"성수기 주중"},{"won":90000,"label":"일반캠핑 · 일반","period":"성수기 주말"}],"checked_at":"2026-10-20T04:23:01.280Z"}}