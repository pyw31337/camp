00522/3d38887e-l.webp","w":720,"h":480}],"operator_snippets":[{"text":"펜션시설","url":"https://www.idongjak.or.kr/resort/page/member/login.php?url=https%3A%2F%2Fwww.idongjak.or.kr%2Fresort%2Fpage%2Freservation_new%2Freservation.02.php"},{"text":"펜션&본관","url":"https://www.idongjak.or.kr/resort/page/member/login.php?url=https%3A%2F%2Fwww.idongjak.or.kr%2Fresort%2Fpage%2Freservation_new%2Freservation.02.php"},{"text":"예약확인 및 취소","url":"https://www.idongjak.or.kr/resort/page/member/login.php?url=https%3A%2F%2Fwww.idongjak.or.kr%2Fresort%2Fpage%2Freservation_new%2Freservation.02.php"},{"text":"공지사항","url":"https://www.idongjak.or.kr/resort/page/member/login.php?url=https%3A%2F%2Fwww.idongjak.or.kr%2Fresort%2Fpage%2Freservation_new%2Freservation.02.php"},{"text":"선상낚시 이용요금","url":"https://www.idongjak.or.kr/resort/page/enjoy/enjoy.01.php"},{"text":"이용시간대","url":"https://www.idongjak.or.kr/resort/page/enjoy/enjoy.01.php"},{"text":"오전, 오후 체험낚시 요금","url":"https://www.idongjak.or.kr/resort/page/enjoy/enjoy.01.php"},{"text":"이용요금 : 3만원 ~ 6만원(장비 지참시 1만원 할인)","url":"https://www.idongjak.or.kr/resort/page/enjoy/enjoy.01.php"},{"text":"고카트 이용요금","url":"https://www.idongjak.or.kr/resort/page/enjoy/enjoy.01.php"},{"text":"이용요금 : 15,000 ~ 50,000","url":"https://www.idongjak.or.kr/resort/page/enjoy/enjoy.01.php"},{"text":"바지락캐기 이용요금","url":"https://www.idongjak.or.kr/resort/page/enjoy/enjoy.01.php"},{"text":"기본요금(1인)","url":"https://www.idongjak.or.kr/resort/page/enjoy/enjoy.01.php"},{"text":"대인(중학생부터 성인) 10,000원 , 소인(5살부터 초등학생) 8,000원","url":"https://www.idongjak.or.kr/resort/page/enjoy/enjoy.01.php"},{"text":"만14세 미만 아동은 회원가입이 불가하며, 필요시 법정대리인이 회원가입하여 이용하시기 바랍니다.","url":"https://www.idongjak.or.kr/resort/page/member/join.01.php"},{"text":"동작구시설관리공단 홈페이지는 본 약관을 사전 고지 없이 변경할 수 있으며, 변경된 약관은 동작구시설관리공 단 홈페이지 내에 공지하며, 공지와 동시에 그 효력이 발생됩니다.","url":"https://www.idongjak.or.kr/resort/page/member/join.01.php"},{"text":"회원이 변경된 약관에 동의하지 않는 경우, 본인의 회원등록을 취소(회원탈퇴)할 수 있으며 계속 사용의 경우는 약관 변경에 대한 동의로 간주됩니다.","url":"https://www.idongjak.or.kr/resort/page/member/join.01.php"},{"text":"본 약관에 명시되지 않은 사항은 전기통신기본법, 전기통신사업법, 정보통신윤리위원회 심의규정, 정보통신 윤 리강령, 프로그램보호법 및 기타 관련 법령의 규정에 의합니다.","url":"https://www.idongjak.or.kr/resort/page/member/join.01.php"},{"text":"동작구시설관리공단 홈페이지는 다음 각 호에 해당하는 이용계약에 대하여는 가입을 취소할 수 있습니다.","url":"https://www.idongjak.or.kr/resort/page/member/join.01.php"},{"text":"4) 동작구시설관리공단 홈페이지를 이용하여 법령과 본 약관이 금지하는 행위를 하는 경우","url":"https://www.idongjak.or.kr/resort/page/member/join.01.php"},{"text":"단, 전기통신기본법 등 법률의 규정에 의해 국가기관의 요구가 있는 경우, 범죄에 대한 수사상의 목적이 있거 나 정보통신윤리위원회의 요청이 있는 경우 또는 기타 관계법령에서 정한 절차에 따른 요청이 있는 경우, 귀하가 동작구시설관리공단 홈페이지에 제공…","url":"https://www.idongjak.or.kr/resort/page/member/join.01.php"},{"text":"동작구시설관리공단 홈페이지는 이용자가 본 약관의 내용에 위배되는 행동을 한 경우, 임의로 서비스 사용을 제한 및 중지할 수 있습니다.","url":"https://www.idongjak.or.kr/resort/page/member/join.01.php"},{"text":"장기간 휴면 회원인 경우 안내 메일 또는 공지사항 발표 후 1주일간의 통지 기간을 거쳐 서비스 사용을 중지할 수 있습니다.","url":"https://www.idongjak.or.kr/resort/page/member/join.01.php"},{"text":"동작구시설관리공단 홈페이지가 통제할 수 없는 사유로 인한 서비스중단의 경우(시스템관리자의 고의, 과실 없 는 디스크장애, 시스템다운 등)에 사전통지가 불가능하며 타인(통신회사, 기간통신사업자 등)의 고의, 과실로 인한 시스템중단 등의 경우에는 통지하…","url":"https://www.idongjak.or.kr/resort/page/member/join.01.php"},{"text":"국가비상사태, 정전, 서비스 설비의 장애 또는 서비스 이용의 폭주 등으로 정상적인 서비스 제공이 불가능할 경우, 서비스의 전부 또는 일부를 제한하거나 중지할 수 있습니다.","url":"https://www.idongjak.or.kr/resort/page/member/join.01.php"},{"text":"다만 이 경우 그 사유 및 기간 등을 이용자에게 사전 또는 사후에 공지합니다.","url":"https://www.idongjak.or.kr/resort/page/member/join.01.php"},{"text":"다만, 전기통신관련법령 등 관계법령에 의하여 관계 국가기관 등의 요구가 있는 경우에는 그러하지 아니합니다.","url":"https://www.idongjak.or.kr/resort/page/member/join.01.php"},{"text":"13) 타인의 의사에 반하여 광고성 정보 등 일정한 내용을 지속적으로 전송하는 행위","url":"https://www.idongjak.or.kr/resort/page/member/join.01.php"},{"text":"16) 기타 전기통신사업법 제53조 제1항과 전기통신사업법 시행령 16조(불온통신)에 위배되는 행위","url":"https://www.idongjak.or.kr/resort/page/member/join.01.php"},{"text":"제 13 조 (양도금지) 1.","url":"https://www.idongjak.or.kr/resort/page/member/join.01.php"},{"text":"동작구시설관리공단 홈페이지는 천재지변, 전쟁 및 기타 이에 준하는 불가항력으로 인하여 서비스를 제공할 수 없는 경우에는 서비스 제공에 대한 책임이 면제됩니다.","url":"https://www.idongjak.or.kr/resort/page/member/join.01.php"},{"text":"그러나 위의 이용약관은 필수사항으로 동의를 거부할 경우 회원가입이 제한됩니다.","url":"https://www.idongjak.or.kr/resort/page/member/join.01.php"},{"text":"- 이용료 결제 및 서비스 등의 공급에 관한 기록 : 5년","url":"https://www.idongjak.or.kr/resort/page/member/join.01.php"},{"text":"그러나 위의 개인정보 제3자 제공 동의서은 필수사항으로 동의를 거부할 경우 회원가입이 제한됩니다.","url":"https://www.idongjak.or.kr/resort/page/member/join.01.php"},{"text":"그러나 개인정보 수집 및 이용 동의서에 동의를 거부할 경우 수집·이용목적 달성에 제한을 받을 수 있습니다.","url":"https://www.idongjak.or.kr/resort/page/member/join.01.php"}],"field_conditions":{"version":2,"status":"SURVEYED","parking":{"state":"SURVEYED","mode":"SITE_ADJACENT","tent_side":true,"cart_required":false,"shared_nearby":false,"drop_off_external":null,"auto_camping_sites":null},"shelter_setup":{"state":"UNKNOWN","max_tents":null,"max_tarps":null,"canopy_allowed":null,"note":null},"power":{"state":"CONFIRMED","available":true,"limit_w":null,"regulatory_reference_w":600,"breaker_capacity":null,"statutory_standard":true,"high_power_mention":null},"ground":{"state":"CONFIRMED","types":[{"type":"DECK","count":7}]},"charcoal":{"state":"CONFIRMED","allowed":true},"firewood":{"state":"CONFIRMED","allowed":true,"sold":null},"fire_pit":{"state":"CONFIRMED","arrangement":"개별"},"site_size":{"state":"UNKNOWN","groups":[]},"sanitary":{"state":"CONFIRMED","toilets_count":2,"showers_count":2,"sinks_count":1,"private_bathroom":false,"private_bathroom_state":"UNKNOWN","hot_water":"제공","note":"공용 화장실 2개소 / 샤워실 2개소"},"features":["EXPERIENCE"],"rental_offers":[],"source":{"label":"한국관광공사 고캠핑 운영자 등록 및 공식 소개 전수조사","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=100522","checked_at":"2024-04-19T00:00:00+09:00","tier":"A"}},"rv":{"n":2,"p":[["가성비 좋음",1]],"c":[],"details":{"pros":[{"topic":"가성비 좋음","count":1,"samples":[{"title":"여름휴가 숙소 추천! 가성비 좋고 누구나 이용 가능한...","u