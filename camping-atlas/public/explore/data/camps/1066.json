 낚시터이용은 무료다. 낚시대 대여는 1일 1만원(미끼포함), 텐트대여도 가능하다. 캠핑장에는 화장실, 샤워장, 개수대, 매점 등 편의시설이 잘 갖춰져 있다.","updated":"2026-10-12","facilities":[{"k":"주요시설","v":"일반야영장(35면)","items":["일반야영장(35면)"]},{"k":"기타 정보","v":"개인 트레일러 입장가능","items":["개인 트레일러 입장가능"]},{"k":"바닥형태 (단위:면)","v":"파쇄석 (35)","items":["파쇄석 (35)"]},{"k":"사이트 크기","v":"6 X 7 : 35개"},{"k":"캠핑장비대여","v":"캠핑장 문의","items":["캠핑장 문의"]},{"k":"반려동물 출입","v":"소형견만 가능"},{"k":"화로대","v":"개별"},{"k":"안전시설현황","v":"소화기 (10)","items":["소화기 (10)"]}],"photos":["https://www.gocamping.or.kr/upload/camp/1066/7726Slc7g1eETxm3CYrIbQHm.jpg","https://www.gocamping.or.kr/upload/camp/1066/5671HpFPgNSlhdNY5j7GDDwt.jpg","https://www.gocamping.or.kr/upload/camp/1066/3799AvmiD6LlDwlWUMJz9INw.jpg","https://www.gocamping.or.kr/upload/camp/1066/6152jWJ1rbeyHyInt2e4q3X7.jpg","https://www.gocamping.or.kr/upload/camp/1066/8634JFt9o6HqHsDtDlenBifR.jpg"],"layout":["https://www.gocamping.or.kr/upload/camp/1066/9636witanqBfkzkuskEGAZmr.jpg"],"guide":[{"title":"일반캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"일반","values":["30,000","30,000","30,000","30,000"]}]},"images":["https://www.gocamping.or.kr/upload/camp/cvntl/54/77624PBD7TaxUeywPKp1OnwB.jpg"]}],"fees":[{"won":30000,"label":"일반캠핑 · 일반","period":"평상시 주중"},{"won":30000,"label":"일반캠핑 · 일반","period":"평상시 주말"},{"won":30000,"label":"일반캠핑 · 일반","period":"성수기 주중"},{"won":30000,"label":"일반캠핑 · 일반","period":"성수기 주말"}],"checked_at":"2026-10-20T03:02:02.258Z"}}