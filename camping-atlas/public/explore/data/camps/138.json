람을 맞으며 멋지게 자전거를 탈 수 도 있다. 자전거를 타다 힘이 들면 잠시 앉아 휴식할 수 있는 공간도 마련되어 있다. 넓은 장소에 푸른 들판이 펼쳐져있어 지상낙원의 느낌을 주는 캠핑장이다.\n족구장, 축구장, 야구장 등 레저 활동을 할 수 있는 운동장이 있어 아이들이 축구를 하며 마음껏 소리 지르고 내달리며 노는 모습이 활기차다.","updated":"2024-09-23","facilities":[{"k":"주요시설","v":"자동차야영장사이트(190면)","items":["자동차야영장사이트(190면)"]},{"k":"기타 정보","v":"개인 트레일러 입장가능","items":["개인 트레일러 입장가능"]},{"k":"바닥형태 (단위:면)","v":"잔디 (137)","items":["잔디 (137)"]},{"k":"사이트 크기","v":"9 X 9 : 77개 · 11 X 8 : 60개"},{"k":"캠핑장비대여","v":"캠핑장 문의","items":["캠핑장 문의"]},{"k":"반려동물 출입","v":"불가능"},{"k":"화로대","v":"개별"},{"k":"안전시설현황","v":"소화기 (30)","items":["소화기 (30)"]}],"photos":["https://www.gocamping.or.kr/upload/camp/138/0681Ct1GiF1ZpDndTltFshBb.jpg","https://www.gocamping.or.kr/upload/camp/138/07390o33XoBlPSH5mwPXrYTF.jpg","https://www.gocamping.or.kr/upload/camp/138/5771NwmqPOHqQzV03LwrEXAk.jpg","https://www.gocamping.or.kr/upload/camp/138/2229IEGAwnCCCQmIrYIw2YQp.jpg","https://www.gocamping.or.kr/upload/camp/138/6421AzASOdmp7yRl4iOPxIXA.jpg","https://www.gocamping.or.kr/upload/camp/138/6254F8S3EQ2cwrT2tOXa9pv8.jpg","https://www.gocamping.or.kr/upload/camp/138/76030krsNc17gA39djQd27Sr.jpg","https://www.gocamping.or.kr/upload/camp/138/7154gCG9UFsppvb23KQkq2at.jpg"],"guide":[{"title":"일반캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"일반","values":["30,000","40,000","30,000","40,000"]}]}}],"fees":[{"won":30000,"label":"일반캠핑 · 일반","period":"평상시 주중"},{"won":40000,"label":"일반캠핑 · 일반","period":"평상시 주말"},{"won":30000,"label":"일반캠핑 · 일반","period":"성수기 주중"},{"won":40000,"label":"일반캠핑 · 일반","period":"성수기 주말"}],"checked_at":"2026-10-20T04:28:38.772Z"}}