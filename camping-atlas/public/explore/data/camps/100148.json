 25분 안팎이다. 캠핑장에는 파쇄석으로 이뤄진 오토캠핑 사이트 15면이 마련돼 있다. 사이트 크기는 가로 8m 세로 6m 등 여러 가지다. 카라반과 트레일러 동반 입장이 가능하다. 바비큐 파티를 즐길 수 있는 피크닉 프로그램도 운영 중이다. 주변에는 운문산군립공원과 운문사가 있다.","updated":"2024-11-27","facilities":[{"k":"주요시설","v":"일반야영장(15면) · 자동차야영장사이트(15면)","items":["일반야영장(15면)","자동차야영장사이트(15면)"]},{"k":"기타 정보","v":"개인 트레일러 입장가능","items":["개인 트레일러 입장가능"]},{"k":"사이트 간격","v":"3M"},{"k":"바닥형태 (단위:면)","v":"파쇄석 (15)","items":["파쇄석 (15)"]},{"k":"캠핑장비대여","v":"릴선","items":["릴선"]},{"k":"반려동물 출입","v":"가능"},{"k":"화로대","v":"개별"},{"k":"안전시설현황","v":"소화기 (14) · 방화수 (1) · 방화사 (1) · 화재감지기 (2)","items":["소화기 (14)","방화수 (1)","방화사 (1)","화재감지기 (2)"]}],"photos":["https://www.gocamping.or.kr/upload/camp/100148/3856ZQAVstl85RYWdpWMQONK.jpg","https://www.gocamping.or.kr/upload/camp/100148/9660Fvy5t4Z6kqkgu4bzS7Pk.jpg","https://www.gocamping.or.kr/upload/camp/100148/54061d8LtbaoWRMnzYJyUUKl.jpg","https://www.gocamping.or.kr/upload/camp/100148/3516nB6tp9EDAMyjM6bx9Lx7.jpg"],"layout":["https://www.gocamping.or.kr/upload/camp/100148/5966s508wZ6svvor0r4r5pHQ.jpg"],"guide":[{"title":"일반캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"일반","values":["50,000","50,000","50,000","50,000"]},{"label":"일반 (개인 카라반 사용 시)","values":["50,000","50,000","50,000","50,000"]}]}},{"title":"오토캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"오토캠핑","values":["50,000 ~50,000","50,000 ~50,000","0","0"]}]}}],"fees":[{"won":50000,"label":"일반캠핑 · 일반","period":"평상시 주중"},{"won":50000,"label":"일반캠핑 · 일반","period":"평상시 주말"},{"won":50000,"label":"일반캠핑 · 일반","period":"성수기 주중"},{"won":50000,"label":"일반캠핑 · 일반","period":"성수기 주말"},{"won":50000,"label":"일반캠핑 · 일반 (개인 카라반 사용 시)","period":"평상시 주중"},{"won":50000,"label":"일반캠핑 · 일반 (개인 카라반 사용 시)","period":"평상시 주말"},{"won":50000,"label":"일반캠핑 · 일반 (개인 카라반 사용 시)","period":"성수기 주중"},{"won":50000,"label":"일반캠핑 · 일반 (개인 카라반 사용 시)","period":"성수기 주말"}],"checked_at":"2026-10-20T04:26:21.620Z"}}