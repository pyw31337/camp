bs/board.php?bo_table=w5_2"},{"text":"주차는 가능한가요?","url":"http://provenceglamping.com/bbs/board.php?bo_table=w5_2"},{"text":"- 청도 프로방스 포토랜드 주차장을 이용하면 되요.","url":"http://provenceglamping.com/bbs/board.php?bo_table=w5_2"},{"text":"- 내비게이션에 '청도 프로방스 글램핑' ,'청도 프로방스', '청도 프로방스 주차장'을 찍고 오시면 되요.","url":"http://provenceglamping.com/bbs/board.php?bo_table=w5_2"},{"text":"- 주차하신 후 내려오신 방향쪽으로 올라오시면 글램핑장이 보이실 거에요!","url":"http://provenceglamping.com/bbs/board.php?bo_table=w5_2"}],"rv":{"n":11,"p":[["주차 편함·옆 주차",1]],"c":[],"details":{"pros":[{"topic":"주차 편함·옆 주차","count":1,"samples":[{"title":"청도 아이와 가기좋은 분위기좋은 내돈내산 하비리조트 럭셔리글램핑","url":"https://blog.naver.com/cjdeun92/224422765216","date":"2026-09-26"}]}],"cons":[],"issues":[]}},"nearby_licensed":{"CONVENIENCE":{"m":537,"name":"지에스25용암온천점","addr":"경상북도 청도군 화양읍 온천길 23, 청도 용암웰빙스파","lat":35.68887,"lng":128.7191,"n5":13},"OTC_MEDICINE":{"m":539,"name":"씨유 청도용암점","addr":"경상북도 청도군 화양읍 온천길 31, 1층","lat":35.68895,"lng":128.71829,"n5":6},"MART":{"m":592,"name":"청도농협 로컬푸드 직매장","addr":"경상북도 청도군 화양읍 온천길 12","lat":35.68914,"lng":128.72029,"n5":15},"BUTCHER":{"m":1025,"name":"신촌농장","addr":"경상북도 청도군 화양읍 삼신리 526-41","lat":35.69331,"lng":128.71766,"n5":23},"FUEL":{"m":1832,"name":"남성현주유소","addr":"경상북도 청도군 화양읍 남성현로 528","lat":35.7005,"lng":128.71621,"n5":10},"PHARMACY":{"m":4304,"name":"사랑약국","addr":"경상북도 청도군 화양읍 청화로 79-5","lat":35.6484,"lng":128.73659,"n5":5},"VET":{"m":3702,"name":"청도축협동물병원","addr":"경상북도 청도군 화양읍 청려로 1790","lat":35.65101,"lng":128.71364,"n5":4}},"site_types":[{"code":"PITCH","label":"일반 사이트","count":1,"sub":null,"grade":"CONFIRMED","src":"gocamping","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=100592","at":"2026-08-12T00:00:00+09:00","quote":null},{"code":"GLAMPING","label":"글램핑","count":10,"sub":null,"grade":"CONFIRMED","src":"gocamping","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=100592","at":"2026-08-12T00:00:00+09:00","quote":null}]}