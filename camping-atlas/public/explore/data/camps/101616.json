reserve.html"},{"text":"퇴실 시 객실 내 쓰레기는 분리수거한 후(주차장 분리수거장) 객실 점검을 받으신 후 퇴실하셔야 합니다.","url":"http://starlightcamping.net/contents/reserve.html"},{"text":"바비큐(숯+그릴) 4~6인기준 3만원의 비용이 추가됩니다.","url":"http://starlightcamping.net/contents/reserve.html"},{"text":"외부에서 버너, 숯 등 모든 화기 반입금지 : 위반 시 퇴실 조치됩니다.","url":"http://starlightcamping.net/contents/reserve.html"},{"text":"객실의 안전과 화재예방을 위해 객실 내에서 생선이나 고기 등을 굽는 직화 방식은 허용되지 않으며, 개인적으로 준비해 오는 취사도구(그릴, 숯, 전기/전열기구 등)은 반입이 금지되어 있습니다.","url":"http://starlightcamping.net/contents/reserve.html"},{"text":"반려동물 동반 시 입실이 불가하며, 해당 사유로 환불받을 수 없습니다.","url":"http://starlightcamping.net/contents/reserve.html"}],"rv":{"n":1,"p":[["반려견 동반 편함",1]],"c":[],"details":{"pros":[{"topic":"반려견 동반 편함","count":1,"samples":[{"title":"가평 반려견 동반 계곡 캠핑 | 별빛담은펜션 1박 2일, 명지산 계곡물에 삼식이와 꼬리를 담그다","url":"https://blog.naver.com/munbakplay/224366917706","date":"2026-08-04"}]}],"cons":[],"issues":[{"issue":"반려견 동반 규정 변경","count":1}]}},"nearby_licensed":{"CONVENIENCE":{"m":3187,"name":"이마트24 SMART  가평채움점","addr":"경기도 가평군 조종면 운악청계로 898","lat":37.889,"lng":127.35221,"n5":3},"OTC_MEDICINE":{"m":4274,"name":"세븐일레븐 조종 운악리점","addr":"경기도 가평군 조종면 운악청계로 705","lat":37.87348,"lng":127.35684,"n5":1},"MART":{"m":926,"name":"상판수퍼","addr":"경기도 가평군 조종면 명지산로 327, 상판슈퍼","lat":37.90143,"lng":127.37265,"n5":1},"BUTCHER":{"m":3611,"name":"새벽숲농장","addr":"경기도 가평군 조종면 꽃동네길 60, 가평꽃동네 환희의 집","lat":37.88486,"lng":127.3504,"n5":1},"FUEL":{"m":6966,"name":"화현셀프7주유소","addr":"경기도 포천시 화현면 금강로 3926","lat":37.90535,"lng":127.30095,"n5":0},"PHARMACY":{"m":7793,"name":"백화점약국","addr":"경기도 포천시 일동면 화동로 1046-2, 1층","lat":37.9567,"lng":127.31746,"n5":0},"VET":{"m":7784,"name":"일동동물병원","addr":"경기도 포천시 일동면 화동로 1044-1","lat":37.95649,"lng":127.31735,"n5":0}},"site_types":[{"code":"AUTO","label":"오토캠핑","count":null,"sub":null,"grade":"CONFIRMED","src":"kakao_local","url":"http://place.map.kakao.com/2015371768","at":"2026-10-16T05:36:44.661Z","quote":"여행 > 숙박 > 야영,캠핑장 > 오토캠핑장"},{"code":"HOUSE","label":"숙박동","count":n