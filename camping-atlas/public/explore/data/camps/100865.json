동장을 비롯해 펜션, 노래방, 세미나실 등이 있다. 주변에 경주불국사 등 경주의 유명 관광지가 즐비해 연계 관광에 나서기 좋다.","updated":"2024-12-02","facilities":[{"k":"주요시설","v":"자동차야영장사이트(34면)","items":["자동차야영장사이트(34면)"]},{"k":"기타 부대시설","v":"펜션, 노래방, 세미나실","items":["펜션, 노래방, 세미나실"]},{"k":"바닥형태 (단위:면)","v":"잔디 (22) · 파쇄석 (12)","items":["잔디 (22)","파쇄석 (12)"]},{"k":"캠핑장비대여","v":"캠핑장 문의","items":["캠핑장 문의"]},{"k":"반려동물 출입","v":"가능"},{"k":"화로대","v":"개별"},{"k":"안전시설현황","v":"소화기 (17)","items":["소화기 (17)"]}],"photos":["https://www.gocamping.or.kr/upload/camp/100865/8964UbiF1Qtc3NdoItjQdtMa.jpg","https://www.gocamping.or.kr/upload/camp/100865/1527xwL6NxTONZWxWO1NtKIs.jpg","https://www.gocamping.or.kr/upload/camp/100865/7707eLxYBq5WwBCSpnZVUVAy.jpg","https://www.gocamping.or.kr/upload/camp/100865/5189kaGZFYUJoHfr9BAHHgqm.jpg","https://www.gocamping.or.kr/upload/camp/100865/781717kkVmpCJIk5xBbH4F7p.jpg"],"layout":["https://www.gocamping.or.kr/upload/camp/100865/4445269dpqnWbfZbiQkLWaI5.jpg"],"guide":[{"title":"오토캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"오토캠핑","values":["40,000 ~40,000","40,000 ~40,000","40,000 ~40,000","40,000 ~40,000"]}]},"images":["https://www.gocamping.or.kr/upload/camp/cvntl/755/6881ESLW7XrgRp83I5dMfx9o.jpg"]}],"checked_at":"2026-10-20T04:24:20.116Z"}}