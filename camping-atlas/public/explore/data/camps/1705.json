pstatic.net/MjAxNjExMjJfMTA2/MDAxNDc5ODAzNzE4NDIx.P-3g8WcGMw0ux3E9vonjf9X3smM_E-h5fIQh559XNMwg.GDM6-09LHnFnqqlqBlyM4YgeFvHABRDT8C46riirpt4g.JPEG.stargusl/DSC01950.JPG?type=w773","url":"https://blog.naver.com/stargusl/220868692121","src":"네이버블로그","w":773,"h":515,"date":"2016-11-23","sure":true}],"posts":[{"t":"blog","title":"캠핑/ 단양솔티천오토캠핑장","snippet":"실제로 캠핑하는 날 하루 자고 일어나면 그렇게 몸이 가뿐할수가 없습니다~~굿~~! 큰 소나무가 많아서 애들 해먹도 맘 놓고 걸수 있어요~ 자~~ 저희 아지트가 세팅되었습니다~ 아래를 참고해 보세요~ 솔티천오토캠핑장 사이트 배치도 인데요~ 저희는 맨 왼쪽 계곡 바로 앞 9번 데크사이트 …","url":"https://blog.naver.com/stargusl/220868692121","src":"김세희 블로그","thumb":"https://search4.kakaocdn.net/argon/130x130_85_c/Dcmz1S7piUs","date":"2016-11-23"}]},"social_checked_at":"2026-10-19T16:55:00+09:00","operator_snippets":[{"text":"소나무집펜션(Redpinehouse.com)","url":"http://redpinehouse.com/?ckattempt=1"},{"text":"펜션소개","url":"http://redpinehouse.com/?ckattempt=1"},{"text":"소나무집펜션","url":"http://redpinehouse.com/?ckattempt=1"},{"text":"내륙 최고의 관광지 단양, 펜션 바로 곁에 청정계곡 새밭계곡이 있습니다.","url":"http://redpinehouse.com/?ckattempt=1"},{"text":"펜션경관","url":"http://redpinehouse.com/?ckattempt=1"},{"text":"단양 소나무집펜션의 네이버 블로그 입니다.","url":"http://redpinehouse.com/?ckattempt=1"},{"text":"그리고 소나무집펜션 지킴이가 직접 작성한 기록입니다.","url":"http://redpinehouse.com/?ckattempt=1"},{"text":"단양펜션","url":"http://redpinehouse.com/?ckattempt=1"},{"text":"특별한 힐링여행은 소나무집펜션에서","url":"http://redpinehouse.com/?ckattempt=1"},{"text":"소나무집펜션은 소백산의 청정계곡 새밭계곡에 있는 힐링 펜션 입니다.","url":"http://redpinehouse.com/?ckattempt=1"},{"text":"겨울에는 꿈의 한 장면인듯한 소백의 설경을 감상 할수 있으며, 여름에는 계곡의 캠핑에 아주 좋은 펜션 입니다.","url":"http://redpinehouse.com/?ckattempt=1"},{"text":"캠핑 여행의 특별함은 바비큐죠 ^^ 소나무집펜션은 모든 객실마다 바비큐를 즐길수 있는 시설을 완비 하였습니다.","url":"http://redpinehouse.com/?ckattempt=1"},{"text":"소백산 자연림 샤워 !","url":"http://redpinehouse.com/?ckattempt=1"},{"text":"하지만 대한민국의 명산중 하나인 소백산의 품속에 들어가지도 못하고 포기 하기는 아쉽기에 소나무집펜션의 힐링 코스에 \"소백 자연림 샤워\" 힐링 체험을 준비 하였습니다.","url":"http://redpinehouse.com/?ckattempt=1"},{"text":"소백산을 일반 운동화 차림으로 간단히 산책하며 깊은 숲의 청정의 피톤치드와 계곡의 음이온에 샤워를 할 수 있습니다 ^^","url":"http://redpinehouse.com/?ckattempt=1"},{"text":"펜션안내","url":"http://redpinehouse.com/?ckattempt=1"},{"text":"소백산의 주봉인 비로봉, 국망봉, 신선봉의 물들이 모두 합쳐 청정계곡 새밭계곡이 소나무집펜션 테라스 바로 아래에 있습니다.","url":"http://redpinehouse.com/?ckattempt=1"},{"text":"Copyright © 소나무집펜션(Redpinehouse.com) 2019.","url":"http://redpinehouse.com/?ckattempt=1"},{"text":"· 이용요금은 1회(2인 기준) 20000원 입니다.","url":"http://redpinehouse.com/bbs/content.php?co_id=s_guide"},{"text":"1인당 추가시 5,000원 추가요금이 발생합니다.","url":"http://redpinehouse.com/bbs/content.php?co_id=s_guide"},{"text":"객실금액을 제외한 추가인원, 옵션 등의 추가금액은 현장결제입니다.","url":"http://redpinehouse.com/bbs/content.php?co_id=s_guide"},{"text":"예약 인원에서 인원이 추가되는 경우 펜션에 미리 연락을 주시기 바랍니다.","url":"http://redpinehouse.com/bbs/content.php?co_id=s_guide"},{"text":"최대 인원 초과 시 입실이 불가능할 수 있으며, 해당 사유로 환불 받을 수 없습니다.","url":"http://redpinehouse.com/bbs/content.php?co_id=s_guide"},{"text":"반려동물 동반 시 입실이 거부될 수 있으며, 해당 사유로 환불 받을 수 없습니다.","url":"http://redpinehouse.com/bbs/content.php?co_id=s_guide"},{"text":"미성년자는 혼숙이 불가능하며, 동성일 경우 보호자 동반이나 동의가 있을 경우에만 입실이 가능합니다.","url":"http://redpinehouse.com/bbs/content.php?co_id=s_guide"},{"text":"다음 이용 고객을 위해 입실, 퇴실 시간을 준수해 주시기 바랍니다.","url":"http://redpinehouse.com/bbs/content.php?co_id=s_guide"},{"text":"-객실의 안전과 화재예방을 위해 객실 내에서 생선이나 고기 등을 굽는 직화 방식은 허용되지 않으며, 개인적으로 준비해 오는 취사도구(그릴, 숯, 전기/전열기구 등)은 반입이 금지되어 있습니다.","url":"http://redpinehouse.com/bbs/content.php?co_id=s_guide"},{"text":"-객실 내에서의 흡연은 금지되어 있으며, 지정된 장소를 이용해 주시기 바랍니다.","url":"http://redpinehouse.com/bbs/content.php?co_id=s_guide"},{"text":"-다른 이용객에게 피해를 줄 수 있는 무분별한 오락, 음주, 고성방가는 삼가주시기 바랍니다.","url":"http://redpinehouse.com/bbs/content.php?co_id=s_guide"},{"text":"소나무펜션을 소개 합니다","url":"http://redpinehouse.com/bbs/content.php?co_id=s_pview"},{"text":"■ 소나무집펜션은 소백산 아래 첫 동네 새밭계곡에 자리하고 있습니다.","url":"http://redpinehouse.com/bbs/content.php?co_id=s_pview"},{"text":"이에 불가에 구봉팔문이라는 득도의 과정이 있는데 바로 그 구봉중 새밭문봉이 있어 팔문안에 있는 유일한 마을 입니다.","url":"http://redpinehouse.com/bbs/content.php?co_id=s_pview"},{"text":"소나무집펜션의 테라스에서 차한잔 들고 내려서면 바로 이 새밭계곡입니다.","url":"http://redpinehouse.com/bbs/content.php?co_id=s_pview"},{"text":"■ 소나무집펜션의 특별함 ......","url":"http://redpinehouse.com/bbs/content.php?co_id=s_pview"},{"text":"특별한 힐링여행은 소나무집펜션 에서","url":"http://redpinehouse.com/bbs/content.php?co_id=s_pview"},{"text":"하지만 대한민국의 명산중 하나인 소백산의 품속에 들어가지도 못하고 포기 하기는 아쉽기에 소나무집 의 힐링 코스에 \"소백 자연림 샤워\" 힐링 체험을 준비 하였습니다.","url":"http://redpinehouse.com/bbs/content.php?co_id=s_pview"},{"text":"새밭계곡은 수량이 넉넉하여 물놀이에 좋고","url":"http://redpinehouse.com/bbs/content.php?co_id=s_sowal"},{"text":"이곳 소백산 산촌마을 방문객들이 전문 등산 차림 없이","url":"http://redpinehouse.com/bbs/content.php?co_id=s_sowal"},{"text":"새밭마을을 관통하고 산마루 펜션을 지나","url":"http://redpinehouse.com/bbs/content.php?co_id=s_sowal"},{"text":"청정 계곡의 오염 때문에 계곡 진입도 금지되어 있습니다.","url":"http://redpinehouse.com/bbs/content.php?co_id=s_sowal"}],"field_conditions":{"version":2,"status":"CONFIRMED","parking":{"state":"UNKNOWN","mode":"UNKNOWN","tent_side":null,"cart_required":null,"shared_nearby":null,"drop_off_external":null,"auto_camping_sites":null},"shelter_setup":{"state":"UNKNOWN","max_tents":null,"max_tarps":null,"canopy_allowed":null,"note":null},"power":{"state":"CONFIRMED","available":true,"limit_w":null,"regulatory_reference_w":600,"breaker_capacity":null,"statutory_standard":true,"high_power_mention":null},"ground":{"state":"UNKNOWN","types":[]},"charcoal":{"state":"UNKNOWN","allowed":null},"firewood":{"state":"UNKNOWN","allowed":null,"sold":null},"fire_pit":{"state":"UNKNOWN","arrangement":null},"site_size":{"state":"UNKNOWN","groups":[]},"sanitary":{"state":"UNKNOWN","toilets_count":null,"showers_count":null,"sinks_count":null,"private_bathroom":false,"private_bathroom_state":"UNKNOWN","hot_water":null,"note":null},"features":["VALLEY","EXPERIENCE"],"rental_offers":[],"source":{"label":"한국관광공사 고캠핑 운영자 등록 및 공식 소개 전수조사","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=1705","checked_at":"2025-0