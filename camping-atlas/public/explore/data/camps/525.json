B2%A4%ED%8A%B8%20%28%EA%B5%AC%20%EA%BF%88%EA%BE%B8%EB%8A%94%20%EC%BA%A0%ED%95%91%EC%9E%A5%29"},{"text":"캠핑장 가운데로는 수영장과 트램펄린이 있어 아이들의 노는 모습을 한 눈에 볼 수 있어 좋다.","url":"https://noricamp.com/site/%EB%93%9C%EB%A6%BC%EC%9D%B4%EB%B2%A4%ED%8A%B8%20%28%EA%B5%AC%20%EA%BF%88%EA%BE%B8%EB%8A%94%20%EC%BA%A0%ED%95%91%EC%9E%A5%29"},{"text":"수영장과 트램펄린만 있으면 아이들은 언제 어디서건 에너자이저가 되어 하루종일 신나게 논다.","url":"https://noricamp.com/site/%EB%93%9C%EB%A6%BC%EC%9D%B4%EB%B2%A4%ED%8A%B8%20%28%EA%B5%AC%20%EA%BF%88%EA%BE%B8%EB%8A%94%20%EC%BA%A0%ED%95%91%EC%9E%A5%29"},{"text":"글램핑 내부에는 에어컨, TV, 밥솥, 작은 냉장고, 전기포트, 테이블, 의자, 선풍기 등이 구비되어 있으며, 씽크대와 화장실, 샤워실은 공용시설을 이용하면 된다.","url":"https://noricamp.com/site/%EB%93%9C%EB%A6%BC%EC%9D%B4%EB%B2%A4%ED%8A%B8%20%28%EA%B5%AC%20%EA%BF%88%EA%BE%B8%EB%8A%94%20%EC%BA%A0%ED%95%91%EC%9E%A5%29"},{"text":"화장실 2개","url":"https://noricamp.com/site/%EB%93%9C%EB%A6%BC%EC%9D%B4%EB%B2%A4%ED%8A%B8%20%28%EA%B5%AC%20%EA%BF%88%EA%BE%B8%EB%8A%94%20%EC%BA%A0%ED%95%91%EC%9E%A5%29"},{"text":"샤워장 2개","url":"https://noricamp.com/site/%EB%93%9C%EB%A6%BC%EC%9D%B4%EB%B2%A4%ED%8A%B8%20%28%EA%B5%AC%20%EA%BF%88%EA%BE%B8%EB%8A%94%20%EC%BA%A0%ED%95%91%EC%9E%A5%29"},{"text":"개수대 2개","url":"https://noricamp.com/site/%EB%93%9C%EB%A6%BC%EC%9D%B4%EB%B2%A4%ED%8A%B8%20%28%EA%B5%AC%20%EA%BF%88%EA%BE%B8%EB%8A%94%20%EC%BA%A0%ED%95%91%EC%9E%A5%29"},{"text":"와이파이","url":"https://noricamp.com/site/%EB%93%9C%EB%A6%BC%EC%9D%B4%EB%B2%A4%ED%8A%B8%20%28%EA%B5%AC%20%EA%BF%88%EA%BE%B8%EB%8A%94%20%EC%BA%A0%ED%95%91%EC%9E%A5%29"},{"text":"장작 판매","url":"https://noricamp.com/site/%EB%93%9C%EB%A6%BC%EC%9D%B4%EB%B2%A4%ED%8A%B8%20%28%EA%B5%AC%20%EA%BF%88%EA%BE%B8%EB%8A%94%20%EC%BA%A0%ED%95%91%EC%9E%A5%29"},{"text":"화로대 사용 개별","url":"https://noricamp.com/site/%EB%93%9C%EB%A6%BC%EC%9D%B4%EB%B2%A4%ED%8A%B8%20%28%EA%B5%AC%20%EA%BF%88%EA%BE%B8%EB%8A%94%20%EC%BA%A0%ED%95%91%EC%9E%A5%29"},{"text":"물놀이장","url":"https://noricamp.com/site/%EB%93%9C%EB%A6%BC%EC%9D%B4%EB%B2%A4%ED%8A%B8%20%28%EA%B5%AC%20%EA%BF%88%EA%BE%B8%EB%8A%94%20%EC%BA%A0%ED%95%91%EC%9E%A5%29"},{"text":"트램펄린","url":"https://noricamp.com/site/%EB%93%9C%EB%A6%BC%EC%9D%B4%EB%B2%A4%ED%8A%B8%20%28%EA%B5%AC%20%EA%BF%88%EA%BE%B8%EB%8A%94%20%EC%BA%A0%ED%95%91%EC%9E%A5%29"},{"text":"반려동물 동반 가능(소형견)","url":"https://noricamp.com/site/%EB%93%9C%EB%A6%BC%EC%9D%B4%EB%B2%A4%ED%8A%B8%20%28%EA%B5%AC%20%EA%BF%88%EA%BE%B8%EB%8A%94%20%EC%BA%A0%ED%95%91%EC%9E%A5%29"},{"text":"개인 트레일러 입장","url":"https://noricamp.com/site/%EB%93%9C%EB%A6%BC%EC%9D%B4%EB%B2%A4%ED%8A%B8%20%28%EA%B5%AC%20%EA%BF%88%EA%BE%B8%EB%8A%94%20%EC%BA%A0%ED%95%91%EC%9E%A5%29"},{"text":"사이트 구성 오토 25개","url":"https://noricamp.com/site/%EB%93%9C%EB%A6%BC%EC%9D%B4%EB%B2%A4%ED%8A%B8%20%28%EA%B5%AC%20%EA%BF%88%EA%BE%B8%EB%8A%94%20%EC%BA%A0%ED%95%91%EC%9E%A5%29"},{"text":"글램핑 10개","url":"https://noricamp.com/site/%EB%93%9C%EB%A6%BC%EC%9D%B4%EB%B2%A4%ED%8A%B8%20%28%EA%B5%AC%20%EA%BF%88%EA%BE%B8%EB%8A%94%20%EC%BA%A0%ED%95%91%EC%9E%A5%29"},{"text":"데크 5","url":"https://noricamp.com/site/%EB%93%9C%EB%A6%BC%EC%9D%B4%EB%B2%A4%ED%8A%B8%20%28%EA%B5%AC%20%EA%BF%88%EA%BE%B8%EB%8A%94%20%EC%BA%A0%ED%95%91%EC%9E%A5%29"},{"text":"글램핑 내부 침대, TV, 에어컨, 냉장고, 유무선인터넷, 난방기구","url":"https://noricamp.com/site/%EB%93%9C%EB%A6%BC%EC%9D%B4%EB%B2%A4%ED%8A%B8%20%28%EA%B5%AC%20%EA%BF%88%EA%BE%B8%EB%8A%94%20%EC%BA%A0%ED%95%91%EC%9E%A5%29"},{"text":"동계 캠핑 준비물 체크리스트 보기","url":"https://noricamp.com/site/%EB%93%9C%EB%A6%BC%EC%9D%B4%EB%B2%A4%ED%8A%B8%20%28%EA%B5%AC%20%EA%BF%88%EA%BE%B8%EB%8A%94%20%EC%BA%A0%ED%95%91%EC%9E%A5%29"},{"text":"리드글램핑","url":"https://noricamp.com/site/%EB%93%9C%EB%A6%BC%EC%9D%B4%EB%B2%A4%ED%8A%B8%20%28%EA%B5%AC%20%EA%BF%88%EA%BE%B8%EB%8A%94%20%EC%BA%A0%ED%95%91%EC%9E%A5%29"},{"text":"당일 피크닉부터 기념일의 프리미엄 글램핑까지, 1박 요금으로 캠핑장을 다섯 가지 이야기로 나눴습니다.","url":"https://noricamp.com/price"},{"text":"요금 정보가 있는 캠핑장 1,724 곳","url":"https://noricamp.com/price"},{"text":"고기 한 판 굽고 해 질 녘에 돌아오는 피크닉·먹캠, 그리고 1박 2만 원 이하로 머무를 수 있는 알뜰한 야영지를 모았습니다.","url":"https://noricamp.com/price"},{"text":"평균 1박 16,000원","url":"https://noricamp.com/price"},{"text":"알뜰한 첫 1박","url":"https://noricamp.com/price"},{"text":"전기 한 구, 개수대와 화장실이 갖춰진 기본에 충실한 사이트.","url":"https://noricamp.com/price"},{"text":"국립공원·지자체 야영장과 동네 오토캠핑장이 많은 가격대입니다.","url":"https://noricamp.com/price"},{"text":"내 장비로 떠나는 첫 1박을 계획한다면 여기서 시작해 보세요.","url":"https://noricamp.com/price"},{"text":"#국립공원 #지자체 야영장 #오토캠핑 #첫 캠핑","url":"https://noricamp.com/price"},{"text":"천동오토캠핑장","url":"https://noricamp.com/price"},{"text":"연천재인폭포오토캠핑장","url":"https://noricamp.com/price"},{"text":"평균 1박 35,000원","url":"https://noricamp.com/price"},{"text":"가족이 함께 떠나는 주말","url":"https://noricamp.com/price"},{"text":"주말 오토캠핑의 정석","url":"https://noricamp.com/price"},{"text":"넓은 데크와 파쇄석, 깨끗한 샤워장과 매점, 아이들이 뛰어놀 놀이터까지.","url":"https://noricamp.com/price"},{"text":"주말 가족 캠핑에서 가장 많이 고르는, 시설과 가격의 균형이 좋은 가격대입니다.","url":"https://noricamp.com/price"},{"text":"#오토캠핑 #가족 캠핑 #데크·파쇄석 #편의시설","url":"https://noricamp.com/price"},{"text":"평균 1박 54,000원","url":"https://noricamp.com/price"},{"text":"감성 한 스푼, 글램핑·카라반","url":"https://noricamp.com/price"},{"text":"침구와 냉난방이 갖춰진 글램핑과 카라반으로 장비 없이 가볍게 떠날 수 있는 가격대입니다.","url":"https://noricamp.com/price"},{"text":"#글램핑 #카라반 #장비 없이 #커플 캠핑","url":"https://noricamp.com/price"},{"text":"햇살가득애견캠핑장","url":"https://noricamp.com/price"},{"text":"평균 1박 95,000원","url":"https://noricamp.com/price"},{"text":"개별 화장실과 바비큐 데크, 프라이빗 풀과 넓은 객실까지.","url":"https://noricamp.com/price"},{"text":"기념일이나 가족 여행처럼 특별한 하룻밤을 위한 프리미엄 글램핑·카라반을 모았습니다.","url":"https://noricamp.com/price"},{"text":"#프리미엄 글램핑 #프라이빗 #기념일 #풀빌라형","url":"https://noricamp.com/price"},{"text":"김포한강오토캠핑장","url":"https://noricamp.com/price"},{"text":"평균 1박 194,000원","url":"https://noricamp.com/price"},{"text":"요금은 캠핑장 홈페이지·예약 페이지·블로그 후기·국립공원/자연휴양림 공공 요금표에서 모은 1박 최저 요금(사이트 기준)입니다.","url":"https://noricamp.com/price"},{"text":"잘못된 요금은","url":"https://noricamp.com/price"},{"text":"반려동물 동반","url":"https://noricamp.com/guide"},{"text":"물놀이 가능","url":"https://noricamp.com/guide"},{"text":"오토캠핑","url":"https://noricamp.com/guide"},{"text":"동계 캠핑 준비물 침낭·난방·안전 체크리스트","url":"https://noricamp.com/guide"},{"text":"동계 캠핑 준비물 체크리스트 - 침낭·난방·안전 - 노리캠프","url":"https://noricamp.com/guide/winter-camping"},{"text":"동계 캠핑 준비물","url":"https://noricamp.com/guide/winter-camping"},{"text":"동계 캠핑 준비물 체크리스트","url":"https://noricamp.com/guide/winter-camping"},{"text":"잘 때 따뜻하게 , 그리고 난방은 안전하게 .","url":"https://noricamp.com/guide/winter-camping"},{"text":"동계 침낭","url":"https://noricamp.com/guide/winter-camping"},{"text":"전기 릴선","url":"https://noricamp.com/guide/winter-camping"},{"text":"1 동계 침낭","url":"https://noricamp.com/guide/winter-camping"},{"text":"쿠팡에서 동계 침낭 보기","url":"https://noricamp.com/guide/winter-camping"},{"text":"3 전기요·전기장판","url":"https://noricamp.com/guide/winter-camping"},{"text":"전기를 쓸 수 있는 사이트라면 가장 손쉬운 난방 보조입니다.","url":"https://noricamp.com/guide/winter-camping"},{"text":"다만 캠핑장마다 사이트당 쓸 수 있는 전력이 정해져 있어,","url":"https://noricamp.com/guide/winter-camping"},{"text":"예약 전에 캠핑장의 전기 허용 용량(W)을 확인하고, 소비전력이 낮은 제품 고르기","url":"https://noricamp.com/guide/winter-camping"},{"text":"캠핑장 상세의 '시설/편의' 탭에서 전기 사용 가능 여부를 볼 수 있어요","url":"https://noricamp.com/guide/winter-camping"},{"text":"쿠팡에서 캠핑 전기요 보기","url":"https://noricamp.com/guide/winter-camping"},{"text":"난로·화로를 텐트 근처에서 쓴다면","url":"https://noricamp.com/guide/winter-camping"},{"text":"숯·화로대는 불씨가 남아 있어도 텐트 안에 들이지 않기","url":"https://noricamp.com/guide/winter-camping"},{"text":"6 전기 릴선","url":"https://noricamp.com/guide/winter-camping"},{"text":"겨울에는 전기 사용량이 늘어나는 만큼","url":"https://noricamp.com/guide/winter-camping"},{"text":"쓰려는 전기제품의 소비전력 합계가 릴선 정격 용량보다 작은지 확인","url":"https://noricamp.com/guide/winter-camping"},{"text":"전기가 없는 사이트라면 핫팩과 방한 소품이 체감 온도를 크게 바꿉니다.","url":"https://noricamp.com/guide/winter-camping"},{"text":"글램핑 장비 부담이 적은 숙소형","url":"https://noricamp.com/guide/winter-camping"},{"text":"카라반 실내에서 자는 캠핑","url":"https://noricamp.com/guide/winter-camping"},{"text":"오토캠핑 차 옆에서 짐 걱정 없이","url":"https://noricamp.com/guide/winter-camping"},{"text":"캠핑장 상세의 '시설/편의' 탭에서 전기·온수·장작 판매 여부를, '날씨' 탭에서 9일 예보를 확인할 수 있어요.","url":"https://noricamp.com/guide/winter-camping"},{"text":"침낭·매트·전기요로 보온하세요.","url":"https://noricamp.com/guide/winter-camping"},{"text":"동계 침낭은 몇 도짜리를 사야 하나요?","url":"https://noricamp.com/guide/winter-camping"},{"text":"전기가 없는 사이트에서는 어떻게 따뜻하게 자나요?","url":"https://noricamp.com/guide/winter-camping"},{"text":"바닥 단열 매트를 겹쳐 깔고, 동계 침낭에 라이너나 담요를 더하는 것이 기본입니다.","url":"https://noricamp.com/guide/winter-camping"},{"text":"당일·피크닉 캠핑 캠핑장 (1박 0~2만 원) - 노리캠프","url":"https://noricamp.com/price/day"},{"text":"1박 0~2만 원","url":"https://noricamp.com/price/day"},{"text":"요금은 캠핑장 홈페이지·예약 페이지·블로그 후기·공공 요금표에서 모은 참고 정보입니다.","url":"https://noricamp.com/price/day"},{"text":"피카부 피크닉앤글램핑 서울YMCA도봉산점","url":"https://noricamp.com/price/day"},{"text":"1박 20,000원~","url":"https://noricamp.com/price/day"},{"text":"1박 15,000원~","url":"https://noricamp.com/price/day"},{"text":"낙동강레포츠밸리구지오토캠핑장","url":"https://noricamp.com/price/day"},{"text":"1박 10,000원~","url":"https://noricamp.com/price/day"},{"text":"낙동강레포츠밸리 구지오토캠핑장은 대구광역시 달서군 구지면에 자리했다.","url":"https://noricamp.com/price/day"},{"text":"낙동강을 배경으로 펼쳐진 이곳은 카라반 12대, 오토캠핑장 11면이 있다.","url":"https://noricamp.com/price/day"},{"text":"카라반 내부는 침대, TV, 취사시설, 화장실, 샤워실 등 일상생활을 하기에도 불편함이 없는 물품으로 채웠다.","url":"https://noricamp.com/price/day"},{"text":"외부에는 어닝 아래 목재로 된 전용 데크를 마련했으며, 바비큐를 즐길 수 있는 테이블, 의자 등의 시설을 갖췄다.","url":"https://noricamp.com/price/day"},{"text":"카라반 구역 바로 옆에 붙어 있는 오토캠핑장은 파쇄석으로 이뤄졌다.","url":"https://noricamp.com/price/day"},{"text":"반려동물의 출입도 가능하다.","url":"https://noricamp.com/price/day"},{"text":"전기 온수 파쇄석","url":"https://noricamp.com/price/day"},{"text":"다리를 건너 입구에 들어서면 주차장이 보이고 A, B, C 동으로 나뉜 야영장 사이트가 조성되어 있다.","url":"https://noricamp.com/price/day"},{"text":"하단에 위치한 A동은 24개 사이트가 있으며, 차량은 주차장에 별도로 주차하고 텐트만 설치할 수 있다.","url":"https://noricamp.com/price/day"},{"text":"B동 24개, C동 12개의 사이트는 자동차와 카라반을 동반할 수 있다.","url":"https://noricamp.com/price/day"},{"text":"야영장 예약 시 주차료는 별도로 지불해야 한다.","url":"https://noricamp.com/price/day"},{"text":"반려동물 온수 맨흙","url":"https://noricamp.com/price/day"},{"text":"1박 14,000원~","url":"https://noricamp.com/price/day"},{"text":"숲속의 집, 야영장, 산림욕장, 산책로, 물놀이장, 어린이놀이터 등의 시설을 갖추고 있다.","url":"https://noricamp.com/price/day"},{"text":"온수 데크","url":"https://noricamp.com/price/day"},{"text":"파쇄석과 테크 바닥의 47개 야영 사이트에서 전기와 무선인터넷을 이용할 수 있으며, 온수 시설과 장작 판매 서비스를 갖추고 있습니다.","url":"https://noricamp.com/price/day"},{"text":"놀이터와 운동시설이 있고 인근 산책로와 수영장을 이용할 수 있습니다.","url":"https://noricamp.com/price/day"},{"text":"반려동물 전기 온수 파쇄석","url":"https://noricamp.com/price/day"},{"text":"오토캠핑은 309면을 운영 중이며, 이 가운데 61면에서 전기를 사용할 수 있다.","url":"https://noricamp.com/price/day"},{"text":"화로 사용은 모든 사이트에서 가능하다.","url":"https://noricamp.com/price/day"},{"text":"캐러밴 전용 사이트 8면도 마련했는데, 전기를 사용할 경우 4,000원을 추가로 부담해야 한다.","url":"https://noricamp.com/price/day"},{"text":"넓은 캠핑장이지만 곳곳에 개수대, 샤워장, 화장실을 비치해 불편함이 없다.","url":"https://noricamp.com/price/day"},{"text":"매점을 운영하지 않지만, 캠핑장에서 10분 거리에 대형 마트가 있다.","url":"https://noricamp.com/price/day"},{"text":"전기 파쇄석","url":"https://noricamp.com/price/day"},{"text":"알파인 텐트 30여 동이 들어갈 만큼 넓지만 주말에는 자리가 없을 정도로 붐비므로 자리가 없을 경우 대항마을에 있는 정감 있고 친절한 민박을 이용해도 좋다.","url":"https://noricamp.com/price/day"},{"text":"캠핑장 바로 옆에 맑고 깨끗한 계곡물이 흐르고 있어 물놀이하기에 최적이며, 여름철 가족 단위 방문객들에게 특히 인기가 많습니다.","url":"https://noricamp.com/price/day"},{"text":"편의시설 역시 최근 설치되어 화장실, 샤워실, 개수대 등 관리동 건물이 깨끗하게 유지되고 있습니다.","url":"https://noricamp.com/price/day"},{"text":"양주 VIP캠핑장은 접근성 또한 뛰어나 도심에서 차로 짧은 시간 안에 도착할 수 있어 주말 나들이 장소로도 안성맞춤입니다.","url":"https://noricamp.com/price/day"},{"text":"자동차를 이용하는 캠퍼는 공영주차장을 이용해야 한다.","url":"https://noricamp.com/price/day"},{"text":"1일 주차 요금은 10,000원이다.","url":"https://noricamp.com/price/day"},{"text":"입장료는 4,000원이며, 6~7세 2,000원, 5세 이하 무료다.","url":"https://noricamp.com/price/day"},{"text":"임대 텐트 지역에는 4인 텐트 26면, 6인 텐트 78면을 마련했으며, 이용료에 입장료를 포함한다.","url":"https://noricamp.com/price/day"},{"text":"6인 텐트 가운데 냉난방기를 구비한 사이트는 별도의 전기 사용료를 받는다.","url":"https://noricamp.com/price/day"},{"text":"냉난방기를 갖춘 텐트의 전기 사용료도 별도로 내야 한다.","url":"https://noricamp.com/price/day"},{"text":"반려동물 온수","url":"https://noricamp.com/price/day"},{"text":"무녀도 오토캠핑장","url":"https://noricamp.com/price/day"},{"text":"1박 18,000원~","url":"https://noricamp.com/price/day"},{"text":"휴양림은 객실 36개, 야영장 14개의 사이트를 가지고 있으며, 휴양림에는 청소년 심신수련과 자연체험학습 공간인 숲속 수련장이 있으며 정자, 산장, 철교, 산책로, 등산로, 운동장, 임간학교, 잔디광장, 삼림욕장, 출렁다리, 피크닉장, 물놀이장, 자…","url":"https://noricamp.com/price/day"},{"text":"예약인과 입실인이 동일해야하며, 반드시 신분증을 지참해야 한다.","url":"https://noricamp.com/price/day"},{"text":"삼락생태공원 오토캠핑장은 부산시 사상구 삼락동 삼락생태공원 내 낙동강변에 자리 잡고 있는 부산광역시 최초의 오토캠핑장이다.","url":"https://noricamp.com/price/day"},{"text":"캠핑장은 데크 오토사이트 62면과 파쇄석 일반사이트 50면을 비롯해 샤워실 3동과 화장실 3동, 족구장 2면 등의 편의시설을 갖추고 있다.","url":"https://noricamp.com/price/day"},{"text":"오토 사이트만 전기 사용이 가능하며, 신청은 삼락오토캠핑장 홈페이지에서 하면 되고, 선착순으로 예약 접수한다.","url":"https://noricamp.com/price/day"},{"text":"전기 온수 잔디","url":"https://noricamp.com/price/day"},{"text":"67개의 테크 사이트에서 전기와 무선인터넷을 이용할 수 있으며, 산책로와 운동장 등 부대시설과 마트, 편의점이 갖춰져 있습니다.","url":"https://noricamp.com/price/day"},{"text":"반려동물 전기 테크","url":"https://noricamp.com/price/day"},{"text":"1박 5,000원~","url":"https://noricamp.com/price/day"},{"text":"바닥은 타일로 되어 있으며 화장실, 샤워장, 취사장, 세탁실 등의 부대시설을 갖추고 있다.","url":"https://noricamp.com/price/day"},{"text":"알뜰한 첫 1박 캠핑장 (1박 2~4만 원) - 노리캠프","url":"https://noricamp.com/price/budget"},{"text":"1박 2~4만 원","url":"https://noricamp.com/price/budget"},{"text":"1박 25,000원~","url":"https://noricamp.com/price/budget"},{"text":"잔디 사이트에서 물놀이와 등산·트래킹을 즐길 수 있으며, 개수대 등 기본 부대시설을 갖추고 있습니다.","url":"https://noricamp.com/price/budget"},{"text":"캠핑장에는 자동차 야영장 30면, 글램핑 7개 동을 마련했다.","url":"https://noricamp.com/price/budget"},{"text":"자동차 야영장은 파쇄석으로 이뤄졌으며, 사이트 크기는 가로 7m 세로 7m다.","url":"https://noricamp.com/price/budget"},{"text":"글램핑 객실 내부에는 침대, 에어컨, 냉장고, 전자레인지, 전기밥솥, 식기류, 개수대, 화장실, 샤워장 등이 있다.","url":"https://noricamp.com/price/budget"},{"text":"외부 전용 데크에는 의자 일체형 테이블을 비치했다.","url":"https://noricamp.com/price/budget"},{"text":"1박 40,000원~","url":"https://noricamp.com/price/budget"},{"text":"1박 32,000원~","url":"https://noricamp.com/price/budget"},{"text":"충주시청을 기점으로 약 15km 거리에 있으며, 차량을 이용해 국원대로, 충주호수로, 지등로를 달리면 도착한다.","url":"https://noricamp.com/price/budget"},{"text":"사이트 크기는 가로 6m 세로 13~16m이다.","url":"https://noricamp.com/price/budget"},{"text":"캠핑장은 봄, 여름, 가을 운영하며, 예약은 전화로만 받는다.","url":"https://noricamp.com/price/budget"},{"text":"반려견은 소형견만 동반 입장이 가능하다.","url":"https://noricamp.com/price/budget"},{"text":"의령 거장산 오토캠핑장","url":"https://noricamp.com/price/budget"},{"text":"1박 35,000원~","url":"https://noricamp.com/price/budget"},{"text":"의령 거장산 오토캠핑장은 경남 의령군 궁류면에 위치한 자동차야영장입니다.","url":"https://noricamp.com/price/budget"},{"text":"황매산 오토캠핑장","url":"https://noricamp.com/price/budget"},{"text":"황매산 오토캠핑장은 황매산 정상부근(해발 850미터)에 위치하고 있어, 자연속에서 캠핑을 즐길 수 있는 곳이다.","url":"https://noricamp.com/price/budget"},{"text":"충분한 나무그늘 사이트와 600여대의 주차공간이 있으며, 야생화 단지와 대규모 군립 수목원도 조성 중에 있다.","url":"https://noricamp.com/price/budget"}],"field_conditions":{"version":2,"status":"SURVEYED","parking":{"state":"SURVEYED","mode":"SITE_ADJACENT","tent_side":true,"cart_required":false,"shared_nearby":false,"drop_off_external":null,"auto_camping_sites":25},"shelter_setup":{"state":"UNKNOWN","max_tents":null,"max_tarps":null,"canopy_allowed":null,"note":null},"power":{"state":"CONFIRMED","available":true,"limit_w":null,"regulatory_reference_w":600,"breaker_capacity":null,"statutory_standard":true,"high_power_mention":null},"ground":{"state":"CONFIRMED","types":[{"type":"CRUSHED_STONE","count":20},{"type":"DECK","count":5}]},"charcoal":{"state":"CONFIRMED","allowed":true},"firewood":{"state":"CONFIRMED","allowed":true,"sold":true},"fire_pit":{"state":"CONFIRMED","arrangement":"개별"},"site_size":{"state":"CONFIRMED","groups":[{"width_m":8,"depth_m":8,"count":25}]},"sanitary":{"state":"CONFIRMED","toilets_count":2,"showers_count":2,"sinks_count":2,"private