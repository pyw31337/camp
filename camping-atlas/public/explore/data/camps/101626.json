fs5a.com/sub4.php?num=4_1"},{"text":"#글램핑 금액안내","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"주말 : 30만원","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"주말 : 9만원","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"주말 : 100,000, A6 주중","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"주말 : 90,000","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"주말 : 15만원","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"# 입실/퇴실 안내","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"입실시간 : 오후 3시~8시","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"퇴실시간 : 오전 11시","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"20시 이후 입실 시 사전 문의","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"# 인원 추가 안내","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"3세 미만 영·유아는 추가요금이 없습니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"기준 인원 초과 시 추가 인원에 대한 비용이 별도로 발생할 수 있습니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"최대 인원 초과 시 입실이 불가능할 수 있으며, 해당 사유로 환불받을 수 없습니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"예약 인원에서 인원이 추가되는 경우 펜션에 미리 연락을 주시기 바랍니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"예약인원(영·유아 포함) 외에 초과 인원은 입실 불가합니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"# 수영장 이용 및 안전 수칙 안내","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"안전수칙을 위반하여 발생하는 모든 사고에 대해 업체에 책임이 없음을 알려드립니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"※ 이용수칙 위반 시 퇴실조치 됩니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"동계(동절기) - 15:00 ~ 19:00","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"수영장 이용 시간은 10:00~15:00 까지 입니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"수영장 이용 시 래시가드/아쿠아슈즈 사용을 권장합니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"수영장 수심이 낮으므로 장난을 치거나 다이빙을 금지합니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"물놀이는 응급사고의 위험이 있으므로, 수영장은 혼자 이용할 수 없습니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"수영장 내 음식물 반입을 금하며, 음주 후 수영은 절대 금지(이용 불가)입니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"# 유아 및 어린이 안전 수칙","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"유아와 어린이는 반드시 보호자가 있어야 이용이 가능합니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"주변 바닥이 미끄러울 수 있으니 보호자의 주의가 필요합니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"유아와 어린이의 단독 출입 및 이용을 제한합니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"# 불멍&바비큐 시설 이용 안내","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"이용 안내사항을 준수해 주시기 바랍니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"바비큐 : 30,000원","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"불멍 : 30,000원 (현장결제)","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"바베큐장 이용시간은 15:00 ~ 21:00 까지 입니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"공동바베큐장 이용시간은 17:00 ~ 21:00 까지 입니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"객실 이용고객은 불멍 1시간 서비스이며 수영장 및 찜질방은 무료로 이용이 가능합니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"불멍 1시간 서비스 초과시 1만원이 추가됩니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"불멍타임은 23:00 까지 입니다","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"유의사항 안내","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"# 퇴실","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"퇴실 시 음식물 및 기타 쓰레기는 분리수거 해 주시고, 식기류는 세척해 주시기 바랍니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"다음 이용 고객을 위해 퇴실 시간을 준수해 주시기 바랍니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"퇴실 시 간단한 정리 부탁드립니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"# 금연","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"금연구역과 객실에서 흡연 시 퇴실 조치 됩니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"별도로 마련된 흡연장소를 이용해 주시기 바랍니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"# 화재예방 및 소음","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"화재 발생과 안전을 위해 불꽃놀이와 촛불 등의 사용을 금합니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"안전 및 화재예방을 위해 객실 내에서 생선이나 고기 등을 굽는 직화 방식은 허용되지 않습니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"개인적으로 준비해 오는 개인화기, 난방기, 취사도구(그릴, 숯, 전기, 전열기구, 가스버너, 에어프라이어 등)는 반입 금지입니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"22:00 매너 타임 시간을 준수해 주시기 바랍니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"다른 이용객에게 피해를 줄 수 있는 무분별한 오락, 음주, 고성방가는 삼가주시기 바랍니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"강제 퇴실의 사유가 될 수 있습니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"# 미성년자","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"법적으로 미성년자 예약 및 혼숙이 금지되어 있습니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"미성년자는 보호자의 동반 없이는 숙박 및 예약을 하실 수 없습니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"또한 미성년자의 예약 및 이용은 숙소 규정에 따라 결정되며 해당 사유로 환불받을 수 없습니다.","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"환불규정 안내","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"# 환불수수료 안내","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"이용 7일 전 예약 취소","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"이용 6일 전 예약 취소","url":"http://xn--202-hb9li00bnmpfs5a.com/sub4.php?num=4_1"},{"text":"이용 5일 전 예약 취소","url":"http://xn--2