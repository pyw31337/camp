ing.kimgoon.kr/guide/category/gear"},{"text":"한파에도 따뜻한 겨울 캠핑을 위해서는 적절한 난방 장비가 필수입니다.","url":"https://camping.kimgoon.kr/guide/category/gear"},{"text":"가스 히터, 전기 히터, 장작 난로까지 캠핑 난방 장비 종류와 올바른 사용법을 상세히 정리했습니다.","url":"https://camping.kimgoon.kr/guide/category/gear"},{"text":"텐트 종류별 장단점 비교 - 돔·터널·쉘터·티피 가이드","url":"https://camping.kimgoon.kr/guide/category/gear"}],"site_types":[{"code":"AUTO","label":"오토캠핑","count":null,"sub":null,"grade":"OPERATOR","src":"operator_homepage","url":"https://camping.kimgoon.kr/campings/100723","at":"2026-10-19T01:40:37.238Z","quote":"80 SS 오토캠핑장"},{"code":"GLAMPING","label":"글램핑","count":null,"sub":null,"grade":"OPERATOR","src":"operator_homepage","url":"https://camping.kimgoon.kr/campings/100723","at":"2026-10-19T01:40:37.238Z","quote":"팔공산글램핑"},{"code":"CARAVAN","label":"카라반","count":null,"sub":null,"grade":"OPERATOR","src":"operator_homepage","url":"https://camping.kimgoon.kr/campings/100723","at":"2026-10-19T01:40:37.238Z","quote":"80포레스트카라반캠프"},{"code":"CAR_CAMP","label":"차박","count":null,"sub":null,"grade":"OPERATOR","src":"operator_homepage","url":"https://camping.kimgoon.kr/about","at":"2026-10-19T01:40:37.238Z","quote":"차박을 계획한다면 지역별 차박지 추천 에서 차박 가능한 자동차야영장만 골라볼 수 있어요."},{"code":"EQUIPPED","label":"장비 포함","count":null,"sub":null,"grade":"OPERATOR","src":"operator_homepage","url":"https://camping.kimgoon.kr/guide/category/gear","at":"2026-10-19T01:40:37.238Z","quote":"텐트 종류별 장단점 비교 - 돔·터널·쉘터·티피 가이드"}]}