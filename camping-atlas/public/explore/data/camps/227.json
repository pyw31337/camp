 수 있는 식당을 운영한다.","updated":"2026-09-21","facilities":[{"k":"주요시설","v":"자동차야영장사이트(38면)","items":["자동차야영장사이트(38면)"]},{"k":"사이트 간격","v":"1M"},{"k":"바닥형태 (단위:면)","v":"파쇄석 (38)","items":["파쇄석 (38)"]},{"k":"사이트 크기","v":"6 X 15 : 10개 · 7 X 12 : 4개 · 6 X 10 : 14개"},{"k":"캠핑장비대여","v":"캠핑장 문의","items":["캠핑장 문의"]},{"k":"반려동물 출입","v":"불가능"},{"k":"화로대","v":"개별"},{"k":"안전시설현황","v":"소화기 (20) · 방화수 (2) · 방화사 (2) · 화재감지기 (3)","items":["소화기 (20)","방화수 (2)","방화사 (2)","화재감지기 (3)"]}],"photos":["https://www.gocamping.or.kr/upload/camp/227/1197MSWlJLlAADhkZv4XvZzg.jpg","https://www.gocamping.or.kr/upload/camp/227/5024IkxCYE5aSUMnkqOPgITl.jpg","https://www.gocamping.or.kr/upload/camp/227/2333DDRhyyMn5lkrwUN9govj.jpg","https://www.gocamping.or.kr/upload/camp/227/2431p7SXkbhQlh54IqspV3Db.jpg","https://www.gocamping.or.kr/upload/camp/227/401622m8FvwADEVr9Ujh3Uct.jpg","https://www.gocamping.or.kr/upload/camp/227/3988hDm13qUgK57v9dCRZEyd.jpg","https://www.gocamping.or.kr/upload/camp/227/7737NccU8ofjHerD6eAbZI6C.jpg","https://www.gocamping.or.kr/upload/camp/227/0616GJFRCAkQnyvhRTWDvY2T.jpg","https://www.gocamping.or.kr/upload/camp/227/9858Geqd5p7AFCSGrKV8H0CG.jpg","https://www.gocamping.or.kr/upload/camp/227/1956ezZpAg2u4WId8nPCZ5A3.jpg","https://www.gocamping.or.kr/upload/camp/227/7308jBYYuu7IS6IEGxiIl3PL.jpg"],"guide":[{"title":"일반캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"일반","values":["45,000","45,000","50,000","50,000"]}]}},{"title":"오토캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"오토캠핑","values":["45,000","45,000","50,000","50,000"]}]},"images":["https://www.gocamping.or.kr/upload/camp/cvntl/570/18931V8uBoeWvjAWHnBmD1iR.jpg","https://www.gocamping.or.kr/upload/camp/cvntl/569/8132Xl3RQqZ0UlgsPHofRhpt.jpg","https://www.gocamping.or.kr/upload/camp/cvntl/568/55526ElmxJFp6oqBZhrdAwFx.jpg","https://www.gocamping.or.kr/upload/camp/cvntl/567/0342Jdc2umiF6FEhH2vyGYOH.jpg"]}],"fees":[{"won":45000,"label":"일반캠핑 · 일반","period":"평상시 주중"},{"w