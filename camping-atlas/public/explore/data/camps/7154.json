":["파쇄석 (30)"]},{"k":"사이트 크기","v":"7 X 7 : 30개"},{"k":"글램핑 내부시설","v":"침대 · 에어컨 · 냉장고 · 유무선인터넷 · 난방기구 · 취사도구 · 내부화장실 · 내부샤워실","items":["침대","에어컨","냉장고","유무선인터넷","난방기구","취사도구","내부화장실","내부샤워실"]},{"k":"캠핑장비대여","v":"캠핑장 문의","items":["캠핑장 문의"]},{"k":"반려동물 출입","v":"불가능"},{"k":"화로대","v":"불가"},{"k":"안전시설현황","v":"소화기 (22) · 화재감지기 (7)","items":["소화기 (22)","화재감지기 (7)"]}],"photos":["https://www.gocamping.or.kr/upload/camp/7154/5640BryEIfccHVpdIC6cuHIN.jpg","https://www.gocamping.or.kr/upload/camp/7154/9370w9Br6mw1zyCIGVsEOOMy.jpg","https://www.gocamping.or.kr/upload/camp/7154/6740qxhxJwaterV12ENtZFxa.jpg","https://www.gocamping.or.kr/upload/camp/7154/3465PkI3hkNBwFUeyVsuA3qB.jpg","https://www.gocamping.or.kr/upload/camp/7154/4779uHamzHLr3hQHA8md7JL6.jpg","https://www.gocamping.or.kr/upload/camp/7154/7449GUNwdRPpnIqF5bCwIAi6.jpg","https://www.gocamping.or.kr/upload/camp/7154/08662AoMqFdGSV5xaevVtihX.jpg","https://www.gocamping.or.kr/upload/camp/7154/0663EPENY6u6vAX7VzP32xvl.jpg","https://www.gocamping.or.kr/upload/camp/7154/00991I36zLxsruuObLNZIUXj.jpg","https://www.gocamping.or.kr/upload/camp/7154/4649VyDbkYPN95WB5Onx4zCF.jpg","https://www.gocamping.or.kr/upload/camp/7154/6893NkqlVIcBfossavC5iXTF.jpg","https://www.gocamping.or.kr/upload/camp/7154/5090uHBr5GbW7UFkDnsAtWFN.jpg","https://www.gocamping.or.kr/upload/camp/7154/7083vnxPUIVWT8GhIxOb8u6Z.jpg","https://www.gocamping.or.kr/upload/camp/7154/43502brGpv26IUNBtRI3F0yC.jpg","https://www.gocamping.or.kr/upload/camp/7154/1901qcrLjNESfVS6dqz4C3nv.jpg","https://www.gocamping.or.kr/upload/camp/7154/175494Cd4UXfe1XKwExgoyhb.jpg","https://www.gocamping.or.kr/upload/camp/7154/4478BJycZPj2Fu5jw3dToD4C.jpg","https://www.gocamping.or.kr/upload/camp/7154/2492FPXn72dopUKpmAqmsRAL.jpg","https://www.gocamping.or.kr/upload/camp/7154/3134PJRsTc7XE6neesB0fwB8.jpg","https://www.gocamping.or.kr/upload/camp/7154/1261wN1hRAReTxU6UiHqZ3cn.jpg"],"layout":["https://www.gocamping.or.kr/upload/camp/7154/9645MvKBZ2769AJ5uaaR8ECt.jpg"],"guide":[{"title":"오