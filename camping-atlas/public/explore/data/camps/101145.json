true},{"t":"만석이면 원하는 날짜·사이트에 빈자리 알림을 걸어 둔다.","v":true}],"open_rules":[],"next":[],"warnings":[]},"photos":[{"t":"camps/101145/a5e980da-t.webp","l":"camps/101145/a5e980da-l.webp","w":720,"h":479}]}