실이 있다. 외부 공간에는 그늘막 아래로 테이블과 의자를 비치했다. 매점을 겸한 관리소에서는 캠핑에 필요한 용품을 사거나 빌릴 수 있다.","updated":"2026-07-31","facilities":[{"k":"주요시설","v":"자동차야영장사이트(13면) · 카라반(4면)","items":["자동차야영장사이트(13면)","카라반(4면)"]},{"k":"기타 정보","v":"개인 트레일러 입장가능","items":["개인 트레일러 입장가능"]},{"k":"바닥형태 (단위:면)","v":"파쇄석 (13)","items":["파쇄석 (13)"]},{"k":"사이트 크기","v":"10 X 1 : 13개"},{"k":"카라반 내부시설","v":"침대 · 에어컨 · 냉장고 · 유무선인터넷 · 난방기구","items":["침대","에어컨","냉장고","유무선인터넷","난방기구"]},{"k":"캠핑장비대여","v":"캠핑장 문의","items":["캠핑장 문의"]},{"k":"반려동물 출입","v":"불가능"},{"k":"화로대","v":"개별"},{"k":"안전시설현황","v":"소화기 (10) · 화재감지기 (4)","items":["소화기 (10)","화재감지기 (4)"]}],"photos":["https://www.gocamping.or.kr/upload/camp/2052/2600PnaUziAglZ4VGIt1ryon.jpg","https://www.gocamping.or.kr/upload/camp/2052/8557uY1coKxQ6I568RS0QhFZ.jpg","https://www.gocamping.or.kr/upload/camp/2052/4987GZpQ1AUcJs2LZ27uK26S.jpg","https://www.gocamping.or.kr/upload/camp/2052/91896Uo7pccnV8iALq2WPBd7.jpg","https://www.gocamping.or.kr/upload/camp/2052/1583oeORqYdFB7HDnkdFe0Yr.jpg","https://www.gocamping.or.kr/upload/camp/2052/5546i9YwuYunMLslDGDPujJ7.jpg","https://www.gocamping.or.kr/upload/camp/2052/0533hKgIMDt4UgR90ZlqP3qX.jpg","https://www.gocamping.or.kr/upload/camp/2052/477718COl0dyypc3LgHhKzAZ.jpg","https://www.gocamping.or.kr/upload/camp/2052/775241xwQwMrOmAAVU40ujwh.jpg","https://www.gocamping.or.kr/upload/camp/2052/96402zO0nxREmxrqNqSgER6y.jpg","https://www.gocamping.or.kr/upload/camp/2052/6054TCyX8LlVSCge4WAFYvxK.jpg","https://www.gocamping.or.kr/upload/camp/2052/5536tQfRtvg8DvAo8aftsgZB.jpg"],"guide":[{"title":"오토캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"오토캠핑","values":["20,000","25,000","25,000","25,000"]}]}},{"title":"카라반","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"카라반","values":["60,000 ~80,000","80,000 ~100,000","100,000 ~120,000","100,000 ~120,000"]}]}}],"fees":[{"won":20000,"label":"오토캠핑 · 오토캠핑","period":"평상시 주중"},{"won":25000,"label":"오토캠핑 · 오토캠핑","period":"평상시 주말"},{"won":25000,"l