620/6570fAdOcNHiu3Nd1weu0XmP.jpg","https://gocamping.or.kr/upload/camp/100620/82298KQ5TBmtWx220jdrCg4Z.jpg","https://gocamping.or.kr/upload/camp/100620/6014YgQwl7NPzoxmi3XpDqjK.jpg","https://gocamping.or.kr/upload/camp/100620/1706Jfam2SMZf2iQNeRcLpnk.jpg","https://gocamping.or.kr/upload/camp/100620/9860qSw6t9AUWcTR2cDsi4Zl.jpg","https://gocamping.or.kr/upload/camp/100620/3794dwTboI9KvjZuN598bVgn.jpg","https://gocamping.or.kr/upload/camp/100620/9251sVH24VJruKg7gwQoT0a4.jpg"],"img_dup":1,"photos":[{"t":"camps/100620/1a5cbfec-t.webp","l":"camps/100620/1a5cbfec-l.webp","w":720,"h":480},{"t":"camps/100620/f8c9925c-t.webp","l":"camps/100620/f8c9925c-l.webp","w":1000,"h":1095}],"operator_snippets":[{"text":"영도마리노오토캠핑장","url":"https://www.yeongdo.go.kr/marinocamping/main.web"},{"text":"영도 마리노 오토캠핑장","url":"https://www.yeongdo.go.kr/marinocamping/main.web"},{"text":"바다와 바람과 불빛이 하나되는 곳 영도 마리노 오토캠핑장","url":"https://www.yeongdo.go.kr/marinocamping/main.web"},{"text":"입실시간 : 14:00 (카라반 15:00)","url":"https://www.yeongdo.go.kr/marinocamping/main.web"},{"text":"퇴실시간 : 12:00","url":"https://www.yeongdo.go.kr/marinocamping/main.web"},{"text":"마리노 오토 캠핑장","url":"https://www.yeongdo.go.kr/marinocamping/main.web"},{"text":"차량에 매달아 끌고 다닐 수 있는 숙박시설로, 냉난방 겸용 에어컨, 침상, 소파, 화장실 등 주거 편의기능을 갖추고 있습니다.","url":"https://www.yeongdo.go.kr/marinocamping/main.web"},{"text":"캠핑 설치구역 옆에 차량을 주차할 수 있는 오토캠핑은 차량을 이용한 캠핑시설이나 전기시설을 이용하기에 적합합니다.","url":"https://www.yeongdo.go.kr/marinocamping/main.web"},{"text":"차량은 주차장에 주차해주시기 바랍니다.","url":"https://www.yeongdo.go.kr/marinocamping/main.web"},{"text":"불멍하기 하기 좋은 계절","url":"https://www.yeongdo.go.kr/marinocamping/main.web"},{"text":"캠핑장 소개 | 영도마리노오토캠핑장","url":"https://www.yeongdo.go.kr/marinocamping/00001/00006/00006.web"},{"text":"바다를 보며 힐링할 수 있는 도심 속 공간, 영도 마리노 오토캠핑장을 찾아주셔서 감사합니다.","url":"https://www.yeongdo.go.kr/marinocamping/00001/00006/00006.web"},{"text":"영도 마리노 오토캠핑장은 부산항대교 하부 공간에 조성된 캠핑장으로 도심 가까이에 있어 접근성이 좋아,","url":"https://www.yeongdo.go.kr/marinocamping/00001/00006/00006.web"},{"text":"이용안내 | 영도마리노오토캠핑장","url":"https://www.yeongdo.go.kr/marinocamping/00001/00007.web"},{"text":"도심 속 캠핑장 특성상, 차량 소음과 인근 조선소의 작업 소음이 약간 있으니, 이용에 참고하시기 바랍니다.","url":"https://www.yeongdo.go.kr/marinocamping/00001/00007.web"},{"text":"입실 및 퇴실","url":"https://www.yeongdo.go.kr/marinocamping/00001/00007.web"},{"text":"예약자 본인이 반드시 입실하셔야 하며, 예약내역을 타인에게 양도·양수할 수 없습니다(직계 가족이라도 불가하며, 양도 적발 시 해당 예약은 환불금 없이 즉시 취소되며 양도자는 6개월 예약 제한 조치함).","url":"https://www.yeongdo.go.kr/marinocamping/00001/00007.web"},{"text":"예약자 외 이른 입실은 가족관계인 경우(예약자 기준 부모, 배우자, 자녀)에만 가능하며, 가족관계를 증빙할 수 있는 서류를 지참해야 합니다.","url":"https://www.yeongdo.go.kr/marinocamping/00001/00007.web"},{"text":"이 경우 예약자는 반드시 20시까지 관리사무소에 체크인하여야 하며, 시간 초과 시 양도∙양수로 간주하여 일행이 퇴장됨을 양지 바랍니다.","url":"https://www.yeongdo.go.kr/marinocamping/00001/00007.web"},{"text":"취사(음식의 조리 및 불 이용), 캠핑 및 주차는 지정된 곳에서만 할 수 있습니다.","url":"https://www.yeongdo.go.kr/marinocamping/00001/00007.web"},{"text":"부설주차장 내에서는 캠핑카를 포함한 모든 차량에서의 숙박이 금지되어 있습니다.","url":"https://www.yeongdo.go.kr/marinocamping/00001/00007.web"},{"text":"22시부터 다음 날 07시까지 매너타임으로, 다른 야영객 및 지역주민에게 불편을 끼치는 주취소란 및 고성방가 등 소음발생 행위는 자제하여 주시기 바랍니다.","url":"https://www.yeongdo.go.kr/marinocamping/00001/00007.web"},{"text":"부설주차장을 포함한 캠핑장의 모든 공간에서 캠핑카 및 이동식 트레일러(카라반)의 이용은 금지되어 있습니다.","url":"https://www.yeongdo.go.kr/marinocamping/00001/00007.web"},{"text":"차량이용","url":"https://www.yeongdo.go.kr/marinocamping/00001/00007.web"},{"text":"부설 주차장 내 숙박 불가합니다.","url":"https://www.yeongdo.go.kr/marinocamping/00001/00007.web"},{"text":"샤워장과 개수대에서 물을 이용할 경우에는 최대한 절수 바랍니다.","url":"https://www.yeongdo.go.kr/marinocamping/00001/00007.web"},{"text":"샤워실 이용시간 제한","url":"https://www.yeongdo.go.kr/marinocamping/00001/00007.web"},{"text":"쾌적한 샤워실 운영을 위하여","url":"https://www.yeongdo.go.kr/marinocamping/00001/00007.web"},{"text":"캠핑장 내에는 다중 이용시설로 애완동물은 구역 내 출입을 일체 금지하며, 적발 시 동반자와함께 즉각 퇴실 조치합니다.","url":"https://www.yeongdo.go.kr/marinocamping/00001/00007.web"},{"text":"찾아오시는 길 | 영도마리노오토캠핑장","url":"https://www.yeongdo.go.kr/marinocamping/00001/00008.web"},{"text":"부산항대교로 진입하시지 말고 1차로(영도 마리노 오토캠핑장 방향)로 직진하시기 바랍니다.","url":"https://www.yeongdo.go.kr/marinocamping/00001/00008.web"},{"text":"카라반 소개 | 영도마리노오토캠핑장","url":"https://www.yeongdo.go.kr/marinocamping/00002/00010.web"},{"text":"영도 마리노 오토캠핑장의 카라반은 총 15대로 4인용 4대(1번~4번)와 6인용 11대(5번~15번)로 구성되어 있습니다.","url":"https://www.yeongdo.go.kr/marinocamping/00002/00010.web"},{"text":"내부에 화장실, 샤워실 등을 이용할 수 있으며, 냉난방시설·냉장고·TV 등이 구비되어 있어 편리하게 여행을 즐기실 수 있습니다.","url":"https://www.yeongdo.go.kr/marinocamping/00002/00010.web"},{"text":"1 4인용 카라반에 한해 정원 외 1인 추가인원 이용이 가능합니다.","url":"https://www.yeongdo.go.kr/marinocamping/00002/00010.web"},{"text":"2 전기·수도·주차(1대/1일) 포함","url":"https://www.yeongdo.go.kr/marinocamping/00002/00010.web"},{"text":"온수기, 냉난방기, 침대(침구), TV, 전기레인지, 냉장고, 전자레인지, 전기밥솥, 주방용품(냄비, 프라이팬, 식기 등) 등","url":"https://www.yeongdo.go.kr/marinocamping/00002/00010.web"},{"text":"카라반 앞 야외테이블, 화로 구비되어 있습니다.(숯, 그릴망, 토치 등 개별 준비 필요)","url":"https://www.yeongdo.go.kr/marinocamping/00002/00010.web"},{"text":"입·퇴실 시간","url":"https://www.yeongdo.go.kr/marinocamping/00002/00010.web"},{"text":"카라반 입실 시간 : 15시","url":"https://www.yeongdo.go.kr/marinocamping/00002/00010.web"},{"text":"카라반 퇴실 시간 : 12시","url":"https://www.yeongdo.go.kr/marinocamping/00002/00010.web"},{"text":"다음 이용자의 원활한 이용을 위하여 입퇴실시간 준수 부탁드립니다.","url":"https://www.yeongdo.go.kr/marinocamping/00002/00010.web"}],"field_conditions":{"version":2,"status":"SURVEYED","parking":{"state":"SURVEYED","mode":"SITE_ADJACENT","tent_side":true,"cart_required":false,"shared_nearby":false,"drop_off_external":null,"auto_camping_sites":40},"shelter_setup":{"state":"UNKNOWN","max_tents":null,"max_tarps":null,"canopy_allowed":null,"note":null},"power":{"state":"CONFIRMED","available":true,"limit_w":null,"regulatory_reference_w":600,"breaker_capacity":null,"statutory_standard":true,"high_power_mention":null},"ground":{"state":"CONFIRMED","types":[{"type":"CRUSHED_STONE","count":12