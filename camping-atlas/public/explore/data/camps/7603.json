603/0413pM8JftVPoxQWU2BB5kFB.jpg","https://gocamping.or.kr/upload/camp/7603/1489BPkl3ATqnOw1S3i5MCoK.jpg","https://gocamping.or.kr/upload/camp/7603/1094feTSjWBbqmMhUVOnFQcy.jpg","https://gocamping.or.kr/upload/camp/7603/8503TstmLbjf9zv2L0JcYHuK.jpg","https://gocamping.or.kr/upload/camp/7603/4456umWPDp170QwWb0cTGGZt.jpg","https://gocamping.or.kr/upload/camp/7603/9855MIhfKeib8oBVnyfYcHBe.jpg","https://gocamping.or.kr/upload/camp/7603/6557XGAnuTIQ7nsQBvCoPndm.jpg","https://gocamping.or.kr/upload/camp/7603/26742FEvOPzL4HJYsvGxoSAJ.jpg"],"img_dup":1,"photos":[{"t":"camps/7603/18703ddc-t.webp","l":"camps/7603/18703ddc-l.webp","w":720,"h":479},{"t":"camps/7603/b6252429-t.webp","l":"camps/7603/b6252429-l.webp","w":1280,"h":729}],"operator_snippets":[{"text":"패밀리랜드 카라반캠핑장","url":"https://familylandcamping.com/index.html"},{"text":"카라반캠핑장","url":"https://familylandcamping.com/index.html"},{"text":"이용요금","url":"https://familylandcamping.com/index.html"},{"text":"예약확인/취소","url":"https://familylandcamping.com/index.html"},{"text":"글램핑 캠핑장에서","url":"https://familylandcamping.com/index.html"},{"text":"눈썰매장 할인권","url":"https://familylandcamping.com/index.html"},{"text":"차량 출입 동선 안내","url":"https://familylandcamping.com/index.html?mode=2&mode2=3"},{"text":"차량 이용 시 우치 관리소 삼거리에서 용전 방향은 우회전, 일곡 방향은 좌회전","url":"https://familylandcamping.com/index.html?mode=2&mode2=3"},{"text":"전주 → 정읍 → 장성JC → 북광주IC → 북광주톨게이트 → 북광주교차로 → 추성로 우치공원 방면으로 우측도로 289m 이동 → 월출교차로 → 용산교 → 대야교차로 → 광주패밀리랜드 카라반 캠핑장","url":"https://familylandcamping.com/index.html?mode=2&mode2=3"},{"text":"순천JC → 순천IC → 호남고속도로 → 고창담양고속도로 → 북광주교차로 → 추성로 우치공원 방면으로 우측도로 289m 이동 → 월출교차로 → 용산교 → 대야교차로 → 광주패밀리랜드 카라반 캠핑장","url":"https://familylandcamping.com/index.html?mode=2&mode2=3"},{"text":"차량 출입동선 안내","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"입실 시 예약 확인을 위하여 반드시 신분증을 지참해주십시오.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"입실 이후 카라반 변경, 인원 변동이 불가합니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"반려동물의 출입을 금합니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"자전거, 인라인 스케이트, 원동기, 킥보드 등 차량을 제외한 이동 수단 반입을 금합니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"캠핑장 내 공 놀이, 배드민턴, 플라잉 디스크 등의 놀이는 불가하오니 해당 놀이를 원하실 경우 캠핑장 옆 잔디광장을 이용하시기 바랍니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"카라반 내 구이, 튀김 등의 요리는 불가합니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"카라반 및 캠핑장 내에서는 성냥, 라이터, 폭죽, 휴대용 버너 등 화기 도구의 사용을 금합니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"카라반 내 흡연을 금합니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"개인 카라반, 캠핑카, 텐트, 천막, 해먹 설치를 금합니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"고성방가, 욕설, 폭력 등 타인에게 불쾌감을 줄 수 있는 행위를 금합니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"외출, 취침 시 카라반 출입문과 창문을 잠궈 사고를 예방하시길 바랍니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"야외 데크는 오후 11시 30분까지 이용이 가능합니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"카라반 1대당 출입이 가능한 차량은 1대며 추가 차량의 경우 외부 주차장을 이용해주십시오.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"(예약 시 출입을 원하는 차량번호를 반드시 입력하십시오.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"미입력시 캠핑장 내 차량을 출입할 수 없습니다.)","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"캠핑장 내 출입한 차량의 경우 퇴실 전까지 이동이 불가하오니 이점 참고하시기 바랍니다.(이동하고자 하는 차량의 경우 외부 주차장에 주차해 주시기 바랍니다)","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"캠핑장 내 사고 예방 및 대처를 위해 지정 인원 이외 방문객과 추가 인원은 이용하실 수 없습니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"놀이공원, 동물원 운영시간 외 무단 출입 시 과태료 부과 및 민형사상 책임이 발생할 수 있습니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"입실 시간은 오후 14시부터 21시까지입니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"신분증을 지참하고 관리사무소를 방문하시여 카라반 열쇠 수령 및 이용법에 대해서 안내받으시기 바랍니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"예약 시 입력한 입실 시간을 준수해주세요.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"예약 시 기재한 차량만 입장할 수 있습니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"차량은 카라반당 한 대씩만 입장 가능하며 입실 이후 패밀리랜드 놀이공원 운영시간 중에는 차량 이동은 불가합니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"(입실 이후 차량 이동을 원하는 분은 외부 주차장을 이용해주시기 바랍니다)","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"캠핑장 카라반 입실 이전에 광주패밀리랜드 및 동물원을 이용할 고객은 차량을 외부 주차장에 주차 후 캠핑장 입실 시간에 맞추어 차량을 캠핑장으로 이동하여 주시기 바랍니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"퇴실 시간은 오전 11시입니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"11시 이후 퇴실은 30분 단위로 추가 요금이 발생합니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"13시 이후 퇴실시 1박 요금이 청구됩니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"퇴실 전 정리정돈과 사용하신 집기 세척 부탁드립니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"퇴실 전 쓰레기는 분리수거 후 지정된 장소에 버려주시기 바랍니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"(분리수거장 : 캠핑장 입구 관리사무소 맞은편)","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"퇴실 전 대여용품이 있는 경우 반납해주시기 바랍니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"퇴실 이후 광주패밀리랜드 및 동물원을 이용하실 고객님은 차량을 외부 주차장으로 이동하시고 광주패밀리랜드 및 동물원을 이용해주시기 바랍니다.","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"쓰레기 처리장소 안내","url":"https://familylandcamping.com/index.html?mode=2"},{"text":"HOME > 카라반캠핑장 > 소개","url":"https://familylandcamping.com/index.html?mode=1&mode2=1"},{"text":"푸른 하늘과 맑은 호수가 맞닿아 있는, 패밀리랜드 카라반 캠핑장에 오신걸 환영합니다.","url":"https://familylandcamping.com/index.html?mode=1&mode2=1"},{"text":"패밀리랜드 카라반 캠핑장은 우치공원 내 잔디광장 7천여㎡ 부지에 조성된 럭셔리 글램핑장으로 도심 속 자연에서 낭만을 즐길 수 있는 힐링 공간입니다.","url":"https://familylandcamping.com/index.html?mode=1&mode2=1"},{"text":"저희 캠핑장의 모든 카라반은 최신형 편의시설이 갖춰져 있으며, 국내에서 볼수 없는 미국 포레스트리비사의 초대형 카라반을 설치하여 압도적인 스케일을 자랑하고 있습니다.","url":"https://familylandcamping.com/index.html?mode=1&mode2=1"},{"text":"이제껏 느껴보지 못한 캠핑을 패밀리랜드 카라반 캠핑장에서 느껴보십시오.","url":"https://familylandcamping.com/index.html?mode=1&mode2=1"},{"text":"HOME > 카라반캠핑장 > 시설안내","url":"https://familylandcamping.com/index.html?mode=1&mode2=2"},{"text":"카라반 종류는 4인용 루비, 6인용 에메랄드 A(입식 테이블), 에메랄드 B(좌식 테이블), 다이아몬드 4가지 타입으로 구성되어있습니다.","url":"https://familylandcamping.com/index.html?mode=1&mode2=2"},{"text":"기준 정원 외에 이용이 불가하며 비품 또한 추가 지급되지 않으니 참고해 주시기 바랍니다.","url":"https://familylandcamping.com/index.html?mode=1&mode2=2"},{"text":"(외부장비 사용 및 주변 나뭇가지를 모아 사용하시는 경우에는 퇴실 조치하며 이에 따른 환불은 불가합니다.)","url":"https://familylandcamping.com/index.html?mode=1&mode2=2"},{"text":"카라반 이용 중 카라반 내/외부 시설을 파손하는 경우 '부품교체비와 수리기간 카라반 판매불가에 따른 보상 비용'이 발생되오니 이용에 주의하여 주시기 바랍니다.","url":"https://familylandcamping.com/index.html?mode=1&mode2=2"},{"text":"보상 금액은 '카라반 정상 판매가 50% * 수리 기간'로 책정됩니다.","url":"https://familylandcamping.com/index.html?mode=1&mode2=2"},{"text":"카라반 비품 목록","url":"https://familylandcamping.com/index.html?mode=1&mode2=2"},{"text":"가전 : TV, wi-fi 공유기, 인덕션, 전기밥솥, 냉난방기, 냉장고, 전기포트, 전자레인지","url":"https://familylandcamping.com/index.html?mode=1&mode2=2"},{"text":"HOME > 이용안내 > 이용요금","url":"https://familylandcamping.com/index.html?mode=2&mode2=2"},{"text":"카라반 이용요금","url":"https://familylandcamping.com/index.html?mode=2&mode2=2"},{"text":"카라반명","url":"https://familylandcamping.com/index.html?mode=2&mode2=2"},{"text":"(토요일, 공휴일 전일)","url":"https://familylandcamping.com/index.html?mode=2&mode2=2"},{"text":"(주중, 주말 동일)","url":"https://familylandcamping.com/index.html?mode=2&mode2=2"},{"text":"95,000원","url":"https://familylandcamping.com/index.html?mode=2&mode2=2"},{"text":"105,000원","url":"https://familylandcamping.com/index.html?mode=2&mode2=2"},{"text":"130,000원","url":"https://familylandcamping.com/index.html?mode=2&mode2=2"},{"text":"120,000원","url":"https://familylandcamping.com/index.html?mode=2&mode2=2"},{"text":"160,000원","url":"https://familylandcamping.com/index.html?mode=2&mode2=2"},{"text":"17