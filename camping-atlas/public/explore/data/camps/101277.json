tps://blog.naver.com/iliana_96/224238117976","src":"기록의 온도","date":"2026-04-02"}],"social_checked_at":"2026-10-20T07:23:00+09:00","operator_snippets":[{"text":"글램핑 | 여주 더힐글램핑","url":"https://www.thehillglamping.net/"},{"text":"글램핑 1호","url":"https://www.thehillglamping.net/"},{"text":"글램핑 2호","url":"https://www.thehillglamping.net/"},{"text":"글램핑 3호","url":"https://www.thehillglamping.net/"},{"text":"글램핑 4호","url":"https://www.thehillglamping.net/"},{"text":"카라반 1호","url":"https://www.thehillglamping.net/"},{"text":"카라반 2호","url":"https://www.thehillglamping.net/"},{"text":"카라반 3호","url":"https://www.thehillglamping.net/"},{"text":"개별온수풀(글램핑객실)","url":"https://www.thehillglamping.net/"},{"text":"공용개수대","url":"https://www.thehillglamping.net/"},{"text":"공용샤워실","url":"https://www.thehillglamping.net/"},{"text":"공용화장실","url":"https://www.thehillglamping.net/"},{"text":"아름다운 석양과 자연 경관을 품은 여주 속 나지막한 언덕위에 자리잡은 더힐글램핑","url":"https://www.thehillglamping.net/"},{"text":"동여주IC에서 2.7km, 수도권에서 평일기준 50분 거리에 위치한 더힐글램핑은 드넓은 개별 정원에서 바베큐, 불멍을 온전히 즐길 수 있습니다.","url":"https://www.thehillglamping.net/"},{"text":"글램핑장에서는 365일 이용하실 수 있는 개별 온수 풀이 마련되어있고 방해받지 않고 쉬실 수 있도록 각 사이트 간격이 최대한 넓게 설치되어 있으며 모든 사이트에서 탁트인 시원한뷰를 통해 여주의 드넓은 자연을 감\u0000\u0000상할 수 있습니다.","url":"https://www.thehillglamping.net/"},{"text":"글램핑 최대 90평, 카라반 최대 120평, 캠핑사이트 최대 160평","url":"https://www.thehillglamping.net/"},{"text":"개별 온수풀이 있는","url":"https://www.thehillglamping.net/"},{"text":"최신식 글램핑","url":"https://www.thehillglamping.net/"},{"text":"글램핑장에는 개별화장실 및 용품들이","url":"https://www.thehillglamping.net/"},{"text":"감성 카라반","url":"https://www.thehillglamping.net/"},{"text":"카라반테크에는 지붕이 설치되어 있어","url":"https://www.thehillglamping.net/"},{"text":"개수대 및 샤워시설 등 최신식으로 설치되어 있습니다.","url":"https://www.thehillglamping.net/"},{"text":"여주 더힐글램핑만의 특별한 포인트를 확\u0000인해보세요!","url":"https://www.thehillglamping.net/"},{"text":"더힐글램핑장 매점이용 가능","url":"https://www.thehillglamping.net/"},{"text":"캠핑의 꽃 바베큐&불멍타임","url":"https://www.thehillglamping.net/"},{"text":"글램핑/카라반 각 개인 호실 정원에서 진행","url":"https://www.thehillglamping.net/"},{"text":"탁트인 시원한 뷰가 있는 여주 더힐글램핑","url":"https://www.thehillglamping.net/"},{"text":"업체명 더힐글램핑","url":"https://www.thehillglamping.net/"},{"text":"Copyright &copy; 더힐글램핑","url":"https://www.thehillglamping.net/"},{"text":"오시는길 | 여주 더힐글램핑","url":"https://www.thehillglamping.net/%EC%98%A4%EC%8B%9C%EB%8A%94%EA%B8%B8"},{"text":"주차정보","url":"https://www.thehillglamping.net/%EC%98%A4%EC%8B%9C%EB%8A%94%EA%B8%B8"},{"text":"개별 주차 가능","url":"https://www.thehillglamping.net/%EC%98%A4%EC%8B%9C%EB%8A%94%EA%B8%B8"},{"text":"예약안내 | 여주 더힐글램핑","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"더힐글램핑 예약시 안내사항을 확인해주세요.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"입,퇴실 안내","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"글램핑, 카라반, 캠핑장","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"- 입실 시간 15:00","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"퇴실 시간 11:00","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"(입실은 밤 9시까지입니다-일몰후 체크인 연락주세요)","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"매너 타임","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"- 23시부터 다음날 아침 7시까지 매너타임 꼭 지켜주세요.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"- 매너 타임부터는 TV나 음악, 목소리를 최대한 줄여주세요.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"- 일체의 큰 소음을 내실 수 없으며, 캠핑장 내 이동 제한 됩니다.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"조기 입실","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"늦은 퇴실","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"주말 및 공유일은 조기 입실, 늦은 퇴실이 불가합니다.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"인원 추가 안내","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"어른 2인 초과 입장 금지입니다.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"24개월 이상 미성년 자녀의 경우 추가요금 10,000원","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"예약인원 외 입실을 엄격히 금하며, 인원 규정 미준수 시 환불 없이 퇴실 조치 될 수 있습니다.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"예약 및 취소 환불규정","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"구매 후 예약 상황에 따라 예약 불가 및 예약 취소가 될 수 있습니다.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"예약 전 취소 수수료를 꼭 확인 부탁드립니다.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"예약 전 실시간 예약창 [유의사항/환불규정] 내 숙소 취소 수수료 규정 내용을 반드시 확인 부탁드립니다.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"예약 취소 및 변경 요청은 숙소로 문의 부탁드립니다.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"취소수수료는 예약시점과는 무관하게 '입실일로부터 남은 날짜' 기준으로 부과됩니다.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"예약후 이용일 변경 불가합니다.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"기존 예약건 취소 후 재예약하셔야 합니다.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"중복예약 취소, 업체 요청에 의한 취소, 법령에 의한 취소 등은 반드시 해당 숙소를 통하여 도움을 받으십시오.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"미성년자는 예약이 불가하며, 보호자 동반 없이 이용 불가합니다.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"현장 적발시 환불 없이 퇴실 처리 됩니다.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"이용 시 주의사항","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"반려동물은 입실이 불가합니다.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"미성년자는 보호자의 동행 없이는 투숙이 불가합니다.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"무분별한 오락, 음주 및 고성방가로 타인에게 피해를 줄 경우 부득이하게 강제 퇴실 조치합니다.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"(카라반의 경우 특히 주의해 주세요)","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"외부 반입한 장작, 숯은 사용이 불가합니다.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"퇴실시 음식물을 비롯한 모든 쓰레기는 분리수거해 주시고, 사용하신 주방 기구는 세척 후 건조 부탁드립니다.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"객실 내 절대 금연입니다.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"이용이 제한될 수 있으니 예약 전 확인해 주세요.","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"},{"text":"글램핑, 카라반 퇴실 시 퇴실 점검 부탁드립니다.(관리실에 전화주세요)","url":"https://www.thehillglamping.net/%EC%98%88%EC%95%BD%EC%95%88%EB%82%B4"}],"field_conditions":{"version":2,"status":"SURVEYED","parking":{"state":"SURVEYED","mode":"SITE_ADJACENT","tent_side":true,"cart_required":false,"shared_nearby":false,"drop_off_external":null,"auto_camping_sites":null},"shelter_setup":{"state":"UNKNOWN","max_tents":null,"max_tarps":null,"canopy_allowed":null,"note":null},"power":{"state":"UNKNOWN","available":null,"limit_w":null,"regulatory_reference_w":null,"breaker_capacity":null,"statutory_standard":false,"high_power_mention":null},"ground":{"state":"UNKNOWN","types":[]},"charcoal":{"state":"SURVEYED","allowed":true},"firewood":{"state":"SURVEYED","allowed":true,"sold":null},"fire_pit":{"state":"SURVEYED","arrangement":"개별"},"site_size":{"state":"UNKNOWN","groups":[]},"sanitary":{"state":"CONFIRMED","toilets_count":null,"showers_count":null,"sinks_count":null,"private_bathroom":true,"private_bathroom_state":"SURVEYED","hot_water":"제공","note":"단