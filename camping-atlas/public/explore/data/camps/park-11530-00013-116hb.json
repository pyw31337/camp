태공원에는 산책할 수 있는 산책로와 생태탐방, 체험학습 등을 할 수 있는 장소가 마련되어 있고, 아이들을 위한 생태놀이터도 있습니다.","천왕산 책쉼터 이용시간 은 10:00~18:00가지 운영하며, 휴무일 은 매주 월요일, 이용은 누구나 가능합니다.","천왕산 가족캠핑장 관리사무실과 매점","매점에서는 텐트를 포함하여 캠핑에 필요한 용품을 판매/대여하고 있고, 음료와 스낵, 부식, 얼음 등 먹거리와 게임과 완구까지 판매하고 있습니다.","매점 이용시간은 평일 14:00~21:00, 주말/성수기 10:00~22:00입니다.","매월 10일 10시 에 다음달 이용에 대한 예약이 선착순으로 진행되며, 잔여 데크에 대해서는 수시예약으로 진행됩니다.","지금처럼 여름 시즌에 주말 예약하려고 들어가니 이미 빈자리가 없더군요.","천왕산 가족캠핑장 은 총면적 2만 7,550㎡ 규모로 일반 캠핑장 12면과 오토 캠핑장 18면 이 있습니다."]}],"cafe":[{"t":"cafe","title":"구로구 천왕근린공원 정비 완료…가족캠핑장 재개장","snippet":"구로구(구청장 장인홍)는 ‘천왕근린공원(항골지구) 정비사업’을 완료하고 임시 휴장...이용 편의와 안전성을 높였다. 기존 캠핑데크를 교체·확장하고 상단부에는...","url":"https://cafe.daum.net/wowtodaykorea/Wi7F/37","src":"와우투데이","thumb":"https://search1.kakaocdn.net/argon/130x130_85_c/KB6vjttAxY9","date":"2026-04-13"}],"social_checked_at":"2026-10-24T09:41:00+09:00","social_merged":true,"field_conditions":{"version":2,"status":"CONFIRMED","parking":{"state":"UNKNOWN","mode":"UNKNOWN","tent_side":null,"cart_required":null,"shared_nearby":null,"drop_off_external":null,"auto_camping_sites":null},"shelter_setup":{"state":"UNKNOWN","max_tents":null,"max_tarps":null,"canopy_allowed":null,"note":null},"power":{"state":"UNKNOWN","available":null,"limit_w":null,"regulatory_reference_w":null,"breaker_capacity":null,"statutory_standard":false,"high_power_mention":null},"ground":{"state":"UNKNOWN","types":[]},"charcoal":{"state":"UNKNOWN","allowed":null},"firewood":{"state":"UNKNOWN","allowed":null,"sold":null},"fire_pit":{"state":"UNKNOWN","arrangement":null},"site_size":{"state":"UNKNOWN","groups":[]},"sanitary":{"state":"UNKNOWN","toilets_count":null,"showers_count":null,"sinks_count":null,"private_bathroom":false,"private_bathroom_state":"UNKNOWN","hot_water":null,"note":null},"features":["EXPERIENCE"],"rental_offers":[],"source":{"label":"한국관광공사 고캠핑 운영자 등록 및 공식 소개 전수조사","url":null,"checked_at":"2026-11-02","tier":"A"}},"rv":{"n":21,"p":[["가족·모임 힐링",3],["조용·한적",2],["아이들 놀기 좋음",2],["사이트 넓음",1]],"c":[],"details":{"