 한다.","updated":"2026-09-03","facilities":[{"k":"주요시설","v":"일반야영장(16면)","items":["일반야영장(16면)"]},{"k":"기타 부대시설","v":"방갈로형식의 방이 있음.","items":["방갈로형식의 방이 있음."]},{"k":"사이트 간격","v":"3M"},{"k":"바닥형태 (단위:면)","v":"잔디 (16) · 자갈 (6)","items":["잔디 (16)","자갈 (6)"]},{"k":"사이트 크기","v":"5 X 6 : 16개"},{"k":"캠핑장비대여","v":"캠핑장 문의","items":["캠핑장 문의"]},{"k":"반려동물 출입","v":"불가능"},{"k":"화로대","v":"개별"},{"k":"안전시설현황","v":"소화기 (16) · 화재감지기 (6)","items":["소화기 (16)","화재감지기 (6)"]}],"photos":["https://www.gocamping.or.kr/upload/camp/703/4538Is88YRlLQn5kvvQu981c.jpg","https://www.gocamping.or.kr/upload/camp/703/3654nQvuqiCoKFYrgkyjraRu.jpg","https://www.gocamping.or.kr/upload/camp/703/77572QFB0oQmY3DiusSCI2FS.jpg","https://www.gocamping.or.kr/upload/camp/703/9544P6CuBgUxdhMBKGvm244F.jpg","https://www.gocamping.or.kr/upload/camp/703/4096nnz8pyIAlDNh0FXgT3MP.jpg","https://www.gocamping.or.kr/upload/camp/703/6255qCdHcOFq3CxD55XVtTAA.jpg","https://www.gocamping.or.kr/upload/camp/703/5425D2SxiLZDem1lU66E92bH.jpg","https://www.gocamping.or.kr/upload/camp/703/284942bN4jGwd5Uhb1POX4Qw.jpg","https://www.gocamping.or.kr/upload/camp/703/6742mG7HI7ycER0pRor6zHKP.jpg","https://www.gocamping.or.kr/upload/camp/703/4749kHMkqDZwG572z0aBbrS2.jpg","https://www.gocamping.or.kr/upload/camp/703/7792Mg6CspvxsFlf0uHiVO7S.jpg","https://www.gocamping.or.kr/upload/camp/703/2324POfz5KSZ1TuH8Ut3XHdO.jpg","https://www.gocamping.or.kr/upload/camp/703/4002jFVZYhBgSiUk3pS7KRKl.jpg","https://www.gocamping.or.kr/upload/camp/703/67458JLhuhstsZhT3jA4QWca.jpg","https://www.gocamping.or.kr/upload/camp/703/76872EgKzrGfJRlWIPCn0GMz.jpg"],"layout":["https://www.gocamping.or.kr/upload/camp/703/0990jHNEpNZFOfki6Pil9Blh.jpg"],"guide":[{"title":"일반캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"일반","values":["40,000 ~40,000","40,000 ~40,000","40,000 ~40,000","40,000 ~40,000"]}]}}],"checked_at":"2026-10-20T03:08:19.502Z"}}