71/2564n3R3fQJpJ5parGPJa6z6.jpg","https://gocamping.or.kr/upload/camp/100471/3142ogChDCUgXLDuzKvEZZm1.jpg","https://gocamping.or.kr/upload/camp/100471/3349j3ub7dRj2aRJdhik2sVw.jpg","https://gocamping.or.kr/upload/camp/100471/1378q96rHHcXTrQ9w8txSoUq.jpg","https://gocamping.or.kr/upload/camp/100471/7385mRNA07ULZJh83feHJQEo.jpg"],"img_dup":1,"photos":[{"t":"camps/100471/f41bb376-t.webp","l":"camps/100471/f41bb376-l.webp","w":720,"h":453}],"operator_snippets":[{"text":"ABOUT 캠핑&펜션 소개","url":"http://www.saesolcamping.co.kr/default/"},{"text":"CAMPING&ROOMS 캠핑&펜션 미리보기","url":"http://www.saesolcamping.co.kr/default/"},{"text":"폐수 오염없는 계곡 옆 캠핑장&펜션","url":"http://www.saesolcamping.co.kr/default/"},{"text":"넉넉한 인심 힐링펜션","url":"http://www.saesolcamping.co.kr/default/"},{"text":"화장실 비데, 세탁기, 1인샤워실, 매점, 365일 온수제공","url":"http://www.saesolcamping.co.kr/default/"},{"text":"캠핑&펜션 미리보기 CAMPING&ROOMS PREVIEW","url":"http://www.saesolcamping.co.kr/default/"},{"text":"깨끗하고 안전한 펜션객실을 미리","url":"http://www.saesolcamping.co.kr/default/"},{"text":"새솔캠핑&펜션 주변의 관광지를 둘러보며","url":"http://www.saesolcamping.co.kr/default/"},{"text":"궁금하신 점은 전화로 문의해 주세요!","url":"http://www.saesolcamping.co.kr/default/"},{"text":"캠핑장 비성수기 요금 할인합니다","url":"http://www.saesolcamping.co.kr/default/"},{"text":"캠핑-펜션 공통사항 정리해봤어요","url":"http://www.saesolcamping.co.kr/default/"},{"text":"캠핑장+펜션","url":"http://www.saesolcamping.co.kr/default/"},{"text":"대표적인 청정지역인 강원도 영월 법흥계곡 새솔캠핑&펜션입니다.","url":"http://www.saesolcamping.co.kr/default/introduce/s01.php?topmenu=1&amp;submenu=1"},{"text":"개선할 점이나 아이디어 있으시면 언제든 말씀해주세요\" 즐거운 추억 만들기 도우미 펜션지기 드림","url":"http://www.saesolcamping.co.kr/default/introduce/s01.php?topmenu=1&amp;submenu=1"},{"text":"영월 새솔캠핑&펜션으로 오시는 길을 알려드립니다.","url":"http://www.saesolcamping.co.kr/default/introduce/s02.php?topmenu=1&amp;submenu=2"},{"text":"공지 캠핑장 비성수기 요금 할인합니다 관리자 2023-05-08 775","url":"http://www.saesolcamping.co.kr/default/community/s01.php?topmenu=5&amp;submenu=1"},{"text":"공지 11월~3월 캠핑 장박 환영 합니다!","url":"http://www.saesolcamping.co.kr/default/community/s01.php?topmenu=5&amp;submenu=1"},{"text":"3 캠핑-펜션 공통사항 정리해봤어요 관리자 2022-07-23 1195","url":"http://www.saesolcamping.co.kr/default/community/s01.php?topmenu=5&amp;submenu=1"},{"text":"2 옛 [영월 에이스펜션]이 [영월 새솔캠핑&펜..","url":"http://www.saesolcamping.co.kr/default/community/s01.php?topmenu=5&amp;submenu=1"},{"text":"1 영월 새솔캠핑&펜션이 새롭게 시작합니다 관리자 2022-07-18 560","url":"http://www.saesolcamping.co.kr/default/community/s01.php?topmenu=5&amp;submenu=1"},{"text":"이 이용약관(이하 '약관'이라 합니다)은 영월 새솔캠핑&펜션과 이용 고객(이하 '회원'이라 합니다)간에 영월 새솔캠핑&펜션이 제공하는 서비스(http://www.saesolcamping.co.kr 이하 “웹사이트” 또는 '서비스'라 합니다)의 가입조…","url":"http://www.saesolcamping.co.kr/default/user/agreement.php?topmenu=user&amp;submenu=1"},{"text":"개정된 약관은 정당한 절차에 따라 웹사이트를 통해 공지함으로써 효력을 발휘합니다.","url":"http://www.saesolcamping.co.kr/default/user/agreement.php?topmenu=user&amp;submenu=1"},{"text":"회원은 회사의 확인조치에 대하여 적극 협력하여야 하며, 만일 이를 준수하지 아니할 경우 회사는 회원이 등록한 정보가 부정한 것으로 처리할 수 있습니다.","url":"http://www.saesolcamping.co.kr/default/user/agreement.php?topmenu=user&amp;submenu=1"},{"text":"(4) 회사는 회원에 대하여 등급별로 구분하여 이용시간, 이용회수, 서비스 메뉴 등을 세분하여 이용에 차등을 둘 수 있습니다.","url":"http://www.saesolcamping.co.kr/default/user/agreement.php?topmenu=user&amp;submenu=1"},{"text":"제 8 조 (이용 신청의 승낙과 제한)","url":"http://www.saesolcamping.co.kr/default/user/agreement.php?topmenu=user&amp;submenu=1"},{"text":"(3) 회사는 서비스 이용신청이 다음 각 호에 해당하는 경우에는 그 신청에 대하여 승낙 제한사유가 해소될 때까지 승낙을 유보할 수 있습니다.","url":"http://www.saesolcamping.co.kr/default/user/agreement.php?topmenu=user&amp;submenu=1"},{"text":"(4) 회사는 이용신청고객이 관계 법령에서 규정하는 미성년자일 경우에 서비스별 안내에서 정하는 바에 따라 승낙을 보류할 수 있습니다.","url":"http://www.saesolcamping.co.kr/default/user/agreement.php?topmenu=user&amp;submenu=1"},{"text":"(2) 이용자ID는 원칙적으로 변경이 불가하며 부득이한 사유로 인하여 변경 하고자 하는 경우에는 해당 ID를 해지하고 재가입해야 합니다.","url":"http://www.saesolcamping.co.kr/default/user/agreement.php?topmenu=user&amp;submenu=1"},{"text":"(3) 회사는 개인정보 보호를 위해 보안시스템을 구축하며 개인정보취급방침을 공시하고 준수합니다.","url":"http://www.saesolcamping.co.kr/default/user/agreement.php?topmenu=user&amp;submenu=1"},{"text":"(2) 회원은 약관에서 규정하는 사항과 기타 회사가 정한 제반 규정, 공지사항 등 회사가 공지하는 사항 및 관계 법령을 준수하여야 하며, 기타 회사의 업무에 방해가 되는 행위, 회사의 명예를 손상시키는 행위, 타인에게 피해를 주는 행위를 해서는 안됩…","url":"http://www.saesolcamping.co.kr/default/user/agreement.php?topmenu=user&amp;submenu=1"},{"text":"또한 회원은 이와 같은 영업활동으로 회사가 손해를 입은 경우, 회원은 회사에 대해 손해배상의무를 지며, 회사는 해당 회원에 대해 서비스 이용제한 및 적법한 절차를 거쳐 손해배상 등을 청구할 수 있습니다.","url":"http://www.saesolcamping.co.kr/default/user/agreement.php?topmenu=user&amp;submenu=1"},{"text":"제 12 조 (서비스 이용 시간)","url":"http://www.saesolcamping.co.kr/default/user/agreement.php?topmenu=user&amp;submenu=1"},{"text":"단, 회사는 시스템 정기점검, 증설 및 교체를 위해 회사가 정한 날이나 시간에 서비스를 일시 중단할 수 있으며, 예정되어 있는 작업으로 인한 서비스 일시 중단은 웹사이트를 통해 사전에 공지합니다.","url":"http://www.saesolcamping.co.kr/default/user/agreement.php?topmenu=user&amp;submenu=1"},{"text":"제 5 장 계약 해지 및 이용 제한","url":"http://www.saesolcamping.co.kr/default/user/agreement.php?topmenu=user&amp;submenu=1"},{"text":"제 18 조 (서비스 이용제한)","url":"http://www.saesolcamping.co.kr/default/user/agreement.php?topmenu=user&amp;submenu=1"},{"text":"회사는 회원이 서비스 이용내용에 있어서 본 약관 제 11조 내용을 위반하거나, 다음 각 호에 해당하는 경우 서비스 이용 제한, 초기화, 이용계약 해지 및 기타 해당 조치를 할 수 있습니다.","url":"http://www.saesolcamping.co.kr/default/user/agreement.php?topmenu=user&amp;submenu=1"},{"text":"- 공공질서 및 미풍양속에 위반되는 저속, 음란한 내용 또는 타인의 명예나 프라이버시를 침해할 수 있는 내용의 정보, 문장, 도형, 음향, 동영상을 전송, 게시, 전자우편 또는 기타의 방법으로 타인에게 유포하는 행위","url":"http://www.saesolcamping.co.kr/default/user/agreement.php?topmenu=user&amp;submenu=1"},{"text":"(1) 회사는 천재지변, 전쟁, 기간통신사업자의 서비스 중지 및 기타 이에 준하는 불가항력으로 인하여 서비스를 제공할 수 없는 경우에는 서비스 제공에 대한 책임이 면제됩니다.","url":"http://www.saesolcamping.co.kr/default/user/agreement.php?topmenu=user&amp;submenu=1"},{"text":"(2) 회사는 불특정다수 회원에게 통지를 해야 할 경우 공지 게시판을 통해 7일 이상 게시함으로써 개별 통지에 갈음할 수 있습니다.","url":"http://www.saesolcamping.co.kr/default/user/agreement.php?topmenu=user&amp;submenu=1"},{"text":"(1) 이 약관에 명시되지 않은 사항은 전기통신사업법 등 대한민국의 관계법령과 상관습에 따릅니다.","url":"http://www.saesolcamping.co.kr/default/user/agreement.php?topmenu=user&amp;submenu=1"},{"text":"영월 새솔캠핑&펜션은 귀하의 개인정보 보호를 매우 중요시하며, 『정보통신망 이용촉진등에 관한법률』상의 개인정보보호 규정 및 정보통신부가 제정한 『개인정보 보호지침』을 준수하고 있습니다.","url":"http://www.saesolcamping.co.kr/default/user/privacy.php?topmenu=user&amp;submenu=2"},{"text":"\"영월 새솔캠핑&펜션\"은 개인정보보호방침을 통하여 귀하께서 제공하시는 개인정보가 어떠한 용도와 방식으로 이용되고 있으며 개인정보 보호를 위해 어떠한 조치가 취해지고 있는지 알려드립니다.","url":"http://www.saesolcamping.co.kr/default/user/privacy.php?topmenu=user&amp;submenu=2"},{"text":"(2) 개인정보의 처리를 위탁하는 경우에는 위탁계약 등을 통하여 서비스제공자의 개인정보보호 관련 지시엄수, 개인정보에 관한 비밀유지, 제3자 제공의 금지 및 사고시의 책임부담 등을 명확히 규정하고 당해 계약내용을 서면 또는 전자적으로 보관하겠습니다.","url":"http://www.saesolcamping.co.kr/default/user/privacy.php?topmenu=user&amp;submenu=2"},{"text":"맑은 계곡물에 오페수가 정수돼 안전한 개울 놀이터","url":"http://www.saesolcamping.co.kr/default/introduce/s01.php?topmenu=1&amp;submenu=1","image":"http://www.saesolcamping.co.kr/default/img/wowweb/sub/images/s01_gree02_beta.jpg","ocr":true},{"text":"= 3662 온수가 제공되는 캠핑장 옥외 개수대","url":"http://www.saesolcamping.co.kr/default/introduce/s01.php?topmenu=1&amp;submenu=1","image":"http://www.saesolcamping.co.kr/default/img/wowweb/sub/images/s01_gree02_beta.jpg","ocr":true},{"text":"바로 옆 Ab 주말농장 무상 제공(선착순, 펜션지기와 상의)","url":"http://www.saesolcamping.co.kr/default/introduce/s01.php?topmenu=1&amp;submenu=1","image":"http://www.saesolcamping.co.kr/default/img/wowweb/sub/images/s01_gree02_beta.jpg","ocr":true},{"text":"= SESS 가격과 SSst 인심의 펜션지기","url":"http://www.saesolcamping.co.kr/default/introduce/s01.php?topmenu=1&amp;submenu=1","image":"http://www.saesolcamping.co.kr/default/img/wowweb/sub/images/s01_gree02_beta.jpg","ocr":true}],"field_conditions":{"version":2,"status":"CONFIRMED","parking":{"state":"UNKNOWN","mode":"UNKNOWN","tent_side":null,"cart_required":null,"shared_nearby":null,"drop_off_external":null,"auto_camping_sites":null},"shelter_setup":{"state":"UNKNOWN","max_tents":null,"max_tarps":null,"canopy_allowed":null,"note":n