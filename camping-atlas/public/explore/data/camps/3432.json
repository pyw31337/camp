있어 어른아이 모두 시간가는 줄 모르고 달린다. 숲속애 캠핑장은 산속에 있어 추울 것 같지만 양쪽 능선이 바람을 막아주어 날씨가 추워서 추위를 느끼지 바람이 불어서 춥지는 않다.","updated":"2024-09-26","facilities":[{"k":"주요시설","v":"일반야영장(56면) · 개인카라반사이트(2면)","items":["일반야영장(56면)","개인카라반사이트(2면)"]},{"k":"기타 정보","v":"개인 트레일러 입장가능","items":["개인 트레일러 입장가능"]},{"k":"사이트 간격","v":"1M"},{"k":"바닥형태 (단위:면)","v":"파쇄석 (56)","items":["파쇄석 (56)"]},{"k":"사이트 크기","v":"7 X 9 : 49개"},{"k":"캠핑장비대여","v":"텐트 · 릴선 · 난방기구","items":["텐트","릴선","난방기구"]},{"k":"반려동물 출입","v":"소형견만 가능"},{"k":"화로대","v":"개별"},{"k":"안전시설현황","v":"소화기 (35) · 방화수 (5) · 방화사 (5) · 화재감지기 (4)","items":["소화기 (35)","방화수 (5)","방화사 (5)","화재감지기 (4)"]}],"photos":["https://www.gocamping.or.kr/upload/camp/3432/5313n2DPH7u00OZNinAB0ez9.jpg","https://www.gocamping.or.kr/upload/camp/3432/1637ty6SZ44iJR3vsPwUZlHJ.jpg","https://www.gocamping.or.kr/upload/camp/3432/7423XDDmtDBqw8ka2N8EwHeu.jpg","https://www.gocamping.or.kr/upload/camp/3432/3188iIY7gJb6dQQPaZvaloiI.jpg","https://www.gocamping.or.kr/upload/camp/3432/8971nhwM65tDfAuzkmHiJvmT.jpg"],"layout":["https://www.gocamping.or.kr/upload/camp/3432/51604MByWXPuHANMGnhRN1iZ.jpg"],"guide":[{"title":"일반캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"일반","values":["35,000 ~25,000","35,000 ~25,000","40,000 ~30,000","40,000 ~30,000"]}]}}],"checked_at":"2026-10-20T04:28:33.296Z"}}