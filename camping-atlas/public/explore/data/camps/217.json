tps://www.starcampingland.com/"},{"text":"뉴 카라반","url":"https://www.starcampingland.com/"},{"text":"스파 카라반","url":"https://www.starcampingland.com/"},{"text":"패밀리 카라반","url":"https://www.starcampingland.com/"},{"text":"카라반 개별 바베큐장","url":"https://www.starcampingland.com/"},{"text":"야외 수영장","url":"https://www.starcampingland.com/"},{"text":"별자리 글램핑 A,B,C","url":"https://www.starcampingland.com/"},{"text":"객실 예약은 보호자가 하셔야하며, 입실 시 동의서를 꼭 지참하여 주시기 바랍니다.","url":"https://www.starcampingland.com/reserinfo.php"},{"text":"동의서를 챙겨오지 않으셨을 경우 입실이 불가합니다.","url":"https://www.starcampingland.com/reserinfo.php"},{"text":"올바른 예약 문화를 위해 환불수수료 정책을 적용하고 있습니다.","url":"https://www.starcampingland.com/reserinfo.php"},{"text":"자세한 환불규정은 실시간예약 달력을 확인해 주시기 바랍니다.","url":"https://www.starcampingland.com/reserinfo.php"},{"text":"입실시간 이용당일 오후 3시 입니다.","url":"https://www.starcampingland.com/reserinfo.php"},{"text":"퇴실시간은 마지막 이용일 오전 11시까지 입니다.","url":"https://www.starcampingland.com/reserinfo.php"},{"text":"예약 시 안내문구, 환불규정을 숙지하시고 예약하시기 바랍니다.","url":"https://www.starcampingland.com/reserinfo.php"},{"text":"입실시 내시는 보증금 5만원은 퇴실시 청소가 끝난 15시에 일괄적으로 반환됩니다.","url":"https://www.starcampingland.com/reserinfo.php"},{"text":"최대인원 외 추가 입실이 불가하며, 환불 또한 불가합니다.","url":"https://www.starcampingland.com/reserinfo.php"},{"text":"기준인원 초과시 1인당 유아(0~7세) : 10,000원","url":"https://www.starcampingland.com/reserinfo.php"},{"text":"성인(8세~) : 20,000원의 추가 요금이 발생합니다.","url":"https://www.starcampingland.com/reserinfo.php"},{"text":"예시) 2박시 추가인원 비용 -> 2박 기준 4만원 X 2박 = 8만원","url":"https://www.starcampingland.com/reserinfo.php"},{"text":"보호자가 동반하지 않는 미성년자는 어떤 경우에도 입실이 불가합니다.","url":"https://www.starcampingland.com/reserinfo.php"},{"text":"애완동물 입실은 금하오니 양해 바랍니다.","url":"https://www.starcampingland.com/reserinfo.php"},{"text":"안전한 휴식을 위해 객실내 불꽃, 촛불, 그릴, 숯 등의 반입을 금지합니다.","url":"https://www.starcampingland.com/reserinfo.php"},{"text":"퇴실시 지정된 장소에 음식물 쓰레기를 비롯한 재활용품, 일반 쓰레기를 배출해 주시기 바랍니다.","url":"https://www.starcampingland.com/reserinfo.php"},{"text":"* 위 규정을 위반할 시 강제 퇴실 되실 수 있음을 사전에 알려드립니다.","url":"https://www.starcampingland.com/reserinfo.php"},{"text":"환불안내","url":"https://www.starcampingland.com/reserinfo.php"},{"text":"아래의 환불규정을 꼭 숙지하신 후 예약해 주시기 바랍니다.","url":"https://www.starcampingland.com/reserinfo.php"},{"text":"- 보호자 동반 없는 미성년자 예약 발견 시 환불 없이 예약 취소됩니다.","url":"https://www.starcampingland.com/reserinfo.php"},{"text":"- 예약일 변경 시 발생하는 수수료도 취소 수수료가 동일하게 적용되오니 예약 시 신중하게 생각하시고 결정해 주시기 바랍니다.","url":"https://www.starcampingland.com/reserinfo.php"},{"text":"* 아래의 환불수수료 정책을 꼭 확인해 주시기 바랍니다.","url":"https://www.starcampingland.com/reserinfo.php"},{"text":"기본 취소 수수료","url":"https://www.starcampingland.com/reserinfo.php"}],"field_conditions":{"version":2,"status":"SURVEYED","parking":{"state":"UNKNOWN","mode":"UNKNOWN","tent_side":null,"cart_required":null,"shared_nearby":null,"drop_off_external":null,"auto_camping_sites":null},"shelter_setup":{"state":"UNKNOWN","max_tents":null,"max_tarps":null,"canopy_allowed":null,"note":null},"power":{"state":"CONFIRMED","available":true,"limit_w":null,"regulatory_reference_w":600,"breaker_capacity":null,"statutory_standard":true,"high_power_mention":null},"ground":{"state":"UNKNOWN","types":[]},"charcoal":{"state":"SURVEYED","allowed":true},"firewood":{"state":"SURVEYED","allowed":true,"sold":true},"fire_pit":{"state":"SURVEYED","arrangement":"개별"},"site_size":{"state":"UNKNOWN","groups":[]},"sanitary":{"state":"UNKNOWN","toilets_count":null,"showers_count":null,"sinks_count":null,"private_bathroom":false,"private_bathroom_state":"UNKNOWN","hot_water":"제공","note":null},"features":["SWIMMING_POOL","TRAMPOLINE","PLAYGROUND","EXPERIENCE","FOREST_TRAIL"],"rental_offers":[],"source":{"label":"한국관광공사 고캠핑 운영자 등록 및 공식 소개 전수조사","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=217","checked_at":"2024-06-24T00:00:00+09:00","tier":"A"}},"spec":{"version":1,"generated_at":"2026-10-19T02:21:18.274Z","fields":{"EXTRA_PERSON_FEE":{"grade":"OFFICIAL_TEXT","values":[