om/reservation.php?id=2"},{"text":"애완견을 비롯한 반려동물의 동반 출입은 절대 불가합니다.","url":"http://www.dinoglamping.com/reservation.php?id=2"},{"text":"동반 입실 시 환불 없는 퇴실조치가 가능합니다.","url":"http://www.dinoglamping.com/reservation.php?id=2"},{"text":"퇴실 시 다음 손님을 위한 정리정돈과 설거지, 쓰레기 분리수거는 현대 문화인의 기본 에티켓입니다.","url":"http://www.dinoglamping.com/reservation.php?id=2"},{"text":"심각한 기물 파손, 침구류 오염 등이 발생할 경우 펜션측에 알려 주십시오.","url":"http://www.dinoglamping.com/reservation.php?id=2"},{"text":"객실 내에서는 화재위험물질 (화약, 폭죽 등)은 절대로 사용하실 수 없습니다.","url":"http://www.dinoglamping.com/reservation.php?id=2"},{"text":"환불규정","url":"http://www.dinoglamping.com/reservation.php?id=2"},{"text":"보성 디노글램핑","url":"http://www.dinoglamping.com/about.php"},{"text":"청정 보성 오션뷰 글램핑&오토캠핑장","url":"http://www.dinoglamping.com/about.php"},{"text":"디노글램핑 2024-11-11","url":"http://www.dinoglamping.com/noticeview.php?id=1"}],"field_conditions":{"version":2,"status":"SURVEYED","parking":{"state":"UNKNOWN","mode":"UNKNOWN","tent_side":null,"cart_required":null,"shared_nearby":null,"drop_off_external":null,"auto_camping_sites":null},"shelter_setup":{"state":"UNKNOWN","max_tents":null,"max_tarps":null,"canopy_allowed":null,"note":null},"power":{"state":"CONFIRMED","available":true,"limit_w":null,"regulatory_reference_w":600,"breaker_capacity":null,"statutory_standard":true,"high_power_mention":null},"ground":{"state":"UNKNOWN","types":[]},"charcoal":{"state":"SURVEYED","allowed":true},"firewood":{"state":"SURVEYED","allowed":true,"sold":true},"fire_pit":{"state":"SURVEYED","arrangement":"개별"},"site_size":{"state":"UNKNOWN","groups":[]},"sanitary":{"state":"UNKNOWN","toilets_count":null,"showers_count":null,"sinks_count":null,"private_bathroom":false,"private_bathroom_state":"UNKNOWN","hot_water":"제공","note":null},"features":["SWIMMING_POOL","EXPERIENCE"],"rental_offers":[],"source":{"label":"한국관광공사 고캠핑 운영자 등록 및 공식 소개 전수조사","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=100986","checked_at":"2026-06-30T00:00:00+09:00","tier"