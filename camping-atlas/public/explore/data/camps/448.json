-03-25","facilities":[{"k":"글램핑 내부시설","v":"침대 · 에어컨 · 냉장고 · 유무선인터넷 · 난방기구","items":["침대","에어컨","냉장고","유무선인터넷","난방기구"]},{"k":"캠핑장비대여","v":"캠핑장 문의","items":["캠핑장 문의"]},{"k":"반려동물 출입","v":"불가능"},{"k":"화로대","v":"개별"}],"photos":["https://www.gocamping.or.kr/upload/camp/448/5615WpRQqFi4BcowxgqjxntA.jpg","https://www.gocamping.or.kr/upload/camp/448/7695dCfEWge0vXGhnyOEtCss.jpg","https://www.gocamping.or.kr/upload/camp/448/5344z1XPtdY60tlZqobFrWg5.jpg","https://www.gocamping.or.kr/upload/camp/448/35451FnnTIRuK7NWAKwQBTic.jpg","https://www.gocamping.or.kr/upload/camp/448/0062BDaaIOK3KLAOebKUE8UP.jpg","https://www.gocamping.or.kr/upload/camp/448/2879nzR8YfQbYH0Ggu0xystG.jpg","https://www.gocamping.or.kr/upload/camp/448/6473xAzf3kQzAY9o4ucvcaVK.jpg","https://www.gocamping.or.kr/upload/camp/448/53310CC7FyE3fVwkars5QJti.jpg","https://www.gocamping.or.kr/upload/camp/448/9880Rk5uHWQO9j6Oduy4mP6b.jpg","https://www.gocamping.or.kr/upload/camp/448/9765cCv1CuRiE0tx3PSZkSS5.jpg","https://www.gocamping.or.kr/upload/camp/448/82467fg8IYiktZOQWP0EW02b.jpg","https://www.gocamping.or.kr/upload/camp/448/9602D6tbjBBvt8VqmVCdF6Zx.jpg","https://www.gocamping.or.kr/upload/camp/448/5985LZ7KrvWw7gHGiZEY58f5.jpg"],"layout":["https://www.gocamping.or.kr/upload/camp/448/7900Tr1giZRfDZEpr246qbmg.jpg"],"guide":[{"title":"글램핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"글램핑","values":["59,000 ~99,000","0","109,000 ~149,000","0"]}]}},{"title":"영업배상책임보험","images":["https://www.gocamping.or.kr/upload/camp/448/65581BEcpwPVDPEzeV8zrztq.jpg"]}],"checked_at":"2026-10-20T04:08:25.185Z"}}