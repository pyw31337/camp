lhl.jpg"],"img_dup":1,"photos":[{"t":"camps/100613/c5ab9cba-t.webp","l":"camps/100613/c5ab9cba-l.webp","w":720,"h":479}],"operator_snippets":[{"text":"수유실, 기저귀교환대, 주차, 예약","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"자유로캠핑장 요금 및 프로그램","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"[요금]","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"A존 ~ E존 - 45,000원","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"체크인 - 14:00","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"체크아웃 - 12:00","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"매너타임 - 23:00 ~ 07:00","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"평일 매점 이용 : 09:00~19:00","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"주말 및 공휴일 매점 이용 : 08:00~21:00","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"매너 타임이 잘 지켜지는 곳 이라 가족끼리 가기 좋은 캠핑장이에요.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"관리동 매점 에서 간단한 간식과 라면, 음료 등을 판매해요.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"개수대에 전자레인지, 냉장고 가 있고 화장실과 샤워실 시설 이 있어요.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"D, E 텐트존 이 매점, 화장실과 가까이에 있어요.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"전용 주차 공간 이 있어서 주차가 편해요.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"자유로를 따라 차량 이동이 편리해, 가족 단위로 부담 없이 방문할 수 있습니다.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"사이트 옆 주차는 불가하며, 별도의 공용 주차장 이 제공됩니다.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"화장실, 샤워장, 개수대, 매점이 기본적으로 갖추어져 있습니다.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"화장실과 샤워실은 청결하게 관리되고 있으며, 샤워장 수압은 다소 약하지만 이용에 큰 불편은 없습니다.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"개수대는 07시~22시 30분 까지 이용 가능하며, 주방세제는 비치되어 있으나 수세미는 개인 지참이 필요합니다.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"전자레인지, 냉장고, 전기 사용, 온수, Wi-Fi, 장비 대여, 장작판매 등 편의시설이 제공됩니다.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"이용요금은 비수기 기준 A존 ~ E존 45,000원 이며, 예약은 전용 플랫폼(캠핏)이나 문자 예약을 통해 진행됩니다.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"체크인: 오후 2시","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"체크아웃: 낮 12시","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"매너타임은 23:00 ~ 07:00입니다.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"평일 매점 이용 시간은 09:00~19:00이며, 주말 및 공휴일은 08:00~21:00입니다.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"반려동물은 입장할 수 없습니다.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"도보로 갈만한 명소는 많지 않으니, 주변 관광은 차량 이동이 필요합니다.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"청결한 화장실, 샤워실 등 기본 시설","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"공용 냉장고, Wi-Fi 등 편의시설 갖춤","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"사이트 바로 옆 주차 불가( 공용 주차 이용)","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"반려동물 동반 불가","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"자유로캠핑장에 아이 놀이터나 놀이시설이 있나요?","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"자유로캠핑장에는 별도의 유아 놀이터나 놀이시설이 설치되어 있지 않습니다.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"캠핑장에 화장실, 샤워실, 개수대 등 위생 시설이 잘 갖춰져 있나요?","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"캠핑장 내에 화장실과 샤워실, 개수대 시설이 모두 갖추어져 있습니다.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"샤워실, 화장실은 청결하게 관리되고 있으며, 개수대에는 전자레인지와 냉장고가 마련되어 있어 편리하게 이용하실 수 있습니다.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"사이트 크기와 주차는 어떻게 되나요?","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"사이트 옆에 전용 주차 공간이 마련되어 있어 차량을 가까이에 주차하실 수 있어 편리합니다.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"매점 이용과 캠핑장 내에서 구매 가능한 것은 무엇인가요?","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"캠핑장 내 관리동 매점에서 간단한 간식, 라면, 음료 등을 구매할 수 있습니다.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"매점 운영시간은 평일 09:00~19:00, 주말 및 공휴일 08:00~21:00입니다.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"편의시설(수유실, 기저귀교환대, 유모차대여, 아기의자 등)은 어떻게 되나요?","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"자유로캠핑장에는 수유실과 기저귀교환대, 예약, 주차 시설 등이 있으며, 아기의자와 유모차 대여는 제공되지 않습니다.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"캠핑장 이용 요금 및 체크인/체크아웃 시간, 매너타임은 어떻게 되나요?","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"A존~E존까지 사이트별 1박 기준 이용요금은 45,000원입니다.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"체크인은 14:00부터, 체크아웃은 12:00까지이며, 매너타임(조용히 해야 하는 시간)은 밤 11시부터 아침 7시까지입니다.","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"파주 캠핑장 추천 : 자유로캠핑장 2박 상세 후기","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"아래는 자유로캠핑장 매점 사진 주변에 편의점은...","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"키즈카페 31 위","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"캠핑/글램핑 5 위","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"노천 자쿠지와 키즈 놀이터가 있는 가평 풀빌라","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"고고다이노 키즈호텔","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"놀이와 휴식, 식사 모두 해결 가능한 완벽한 키즈호텔","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"우리 아이의 건강한 성장을 위한 작은 숲 놀이터 체험","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"키즈카페","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"지금 할인중","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"이국적인 분위기의 수영장 카페&펜션","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"다양한 장난감에 물놀이장까지 갖춰진 야외 바비큐장","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"캠핑카페워라벨","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"},{"text":"물놀이터가 있는 셀프 바베큐식당","url":"https://mom-mom.net/travel/places/659dec6dc99d3dcaaf775011"}],"field_conditions":{"version":2,"status":"SURVEYED","parking":{"state":"SURVEYED","mode":"SITE_ADJACENT","tent_side":true,"cart_required":false,"shared_nearby":false,"drop_off_external":null,"auto_camping_sites":null},"shelter_setup":{"state":"UNKNOWN","max_tents":null,"max_tarps":null,"canopy_allowed":null,"note":null},"power":{"state":"CONFIRMED","available":true,"limit_w":null,"regulatory_reference_w":600,"breaker_capacity":null,"statutory_standard":true,"high_power_mention":null},"ground":{"state":"CONFIRMED","types":[{"type":"CRUSHED_STONE","count":33}]},"charcoal":{"state":"CONFIRMED","allowed":true},"firewood":{"state":"CONFIRMED","allowed":true,"sold":true},"fire_pit":{"state":"CONFIRMED","arrangement":"개별"},"site_size":{"state":"UNKNOWN","groups":[]},"sanitary":{"state":"CONFIRMED","toilets_count":1,"showers_count":1,"sinks_count":1,"private_bathroom":false,"private_bathroom_state":"UNKNOWN","hot_water":"제공","note":"공용 화장실 1개소 / 샤워실 1개소"},"features":["SWIMMING_POOL","PLAYGROUND","EXPERIENCE"],"rental_offers":[{"item":"화로대","price_krw":null,"deposit_krw":0,"note":"현장 대여 가능 품목"}],"source":{"label":"한국관광공사 고캠핑 운영자 등록 및 공식 소개 전수조사","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=100613","checked_at":"2024-02-13T00:00:00+09:00","tier":"A"}},"spec":{"version":1,"generated_at":"20