A-A864-454C-B26D-F44CA31C6C6F.jpg?type=w966","url":"https://blog.naver.com/gywn7580242/224067093318","src":"네이버블로그","w":899,"h":1199,"date":"2025-11-06"},{"thumb":"https://search2.kakaocdn.net/argon/130x130_85_c/DYQE0sA3j8c","img":"https://postfiles.pstatic.net/MjAyNjA2MTlfOCAg/MDAxNzgxODczNzE2MTMy.gGS1cj5ldgZzhPxTPVPFhqmaLAb8V_kqTJPjnMoConQg.s_hn8PvFkXCYO1FPHzeWd-3quUi3XvHyIc13R80-IZQg.JPEG/IMG%EF%BC%BF4100.jpg?type=w275","url":"https://blog.naver.com/kandaily/224321950994","src":"네이버블로그","w":275,"h":206,"date":"2026-06-20"}],"social_checked_at":"2026-10-14T08:22:00+09:00","photos_remote":["https://gocamping.or.kr/upload/camp/7670/9800iH4CxC11wzypoRNcUksi.jpg","https://gocamping.or.kr/upload/camp/7670/0878E95G9CaDYWpHOgAm9nua.jpg","https://gocamping.or.kr/upload/camp/7670/1440UdHRPfhRe3OUzgUZK0sy.jpg","https://gocamping.or.kr/upload/camp/7670/5749R4vieEJbuWr1IiRH4EPY.jpg","https://gocamping.or.kr/upload/camp/7670/8014GUhrR2p5sooj4dM9CDcb.jpg","https://gocamping.or.kr/upload/camp/7670/7121eiE0Ls92n36EID346KjK.jpg","https://gocamping.or.kr/upload/camp/7670/1578x4AlMyCBWwmg7ldvwQNL.jpg","https://gocamping.or.kr/upload/camp/7670/2329GLaR1Cm4yhf8Bu5boONZ.jpg","https://gocamping.or.kr/upload/camp/7670/5623PqsJo899TITtDJ2Suk0g.jpg","https://gocamping.or.kr/upload/camp/7670/1579pJBYbxDoznf92HwxLllo.jpg","https://gocamping.or.kr/upload/camp/7670/8415owz0mo4GfVMOpG7UpbC7.jpg","https://gocamping.or.kr/upload/camp/7670/402748YsU0ViyFLcuqe4pRMb.jpg","https://gocamping.or.kr/upload/camp/7670/6760P4fmYhI2ORfrTW1sB4iy.jpg","https://gocamping.or.kr/upload/camp/7670/1191nsHTfwQtYOVLNTi9RSBT.jpg","https://gocamping.or.kr/upload/camp/7670/4024RtPFrni55TG7ckTeyD1F.jpg","https://gocamping.or.kr/upload/camp/7670/9490WZSVRIiwrmvVLxxuwQ7G.jpg"],"img_dup":1,"photos":[{"t":"camps/7670/971a6170-t.webp","l":"camps/7670/971a6170-l.webp","w":720,"h":479}],"operator_snippets":[{"text":"스탠다드글램핑","url":"https://tiger-camping2.com/?intro=ok"},{"text":"리버뷰글램핑","url":"https://tiger-camping2.com/?intro=ok"},{"text":"불멍용 장작","url":"https://tiger-camping2.com/?intro=ok"},{"text":"남녀화장실","url":"https://tiger-camping2.com/?intro=ok"},{"text":"남녀샤워장","url":"https://tiger-camping2.com/?intro=ok"},{"text":"공용개수대","url":"https://tiger-camping2.com/?intro=ok"},{"text":"독채형, 커플형","url":"https://tiger-camping2.com/?intro=ok"},{"text":"예약 전 취소수수료 및 환불규정 꼭 확인 부탁드립니다.","url":"https://tiger-camping2.com/reservation.php?id=2"},{"text":"상기 내용으로 인해 중복 예약이 발생할 경우, 시스템에 등록된 건을 인정하며, 글램핑장과 판매자 측에서는 이로 인하여서는 어떤 책임과 의무도 지지 않습니다.","url":"https://tiger-camping2.com/reservation.php?id=2"},{"text":"객실금액은 기준인원만 포함된 금액이며 추가인원, 바베큐그릴, 화로대 세트, 장작 등 옵션은 별도로 구매하셔야 합니다.","url":"https://tiger-camping2.com/reservation.php?id=2"},{"text":"(적발 시 환불 없는 퇴실조치 사항)","url":"https://tiger-camping2.com/reservation.php?id=2"},{"text":"미 투숙 방문객도 추가인원으로 포함되어 추가요금이 발생합니다.","url":"https://tiger-camping2.com/reservation.php?id=2"},{"text":"각 객실마다 정해진 최대수용인원(영/유아 포함) 초과를 금하며, 예약된 인원 외 입실 시에는 반드시 사전연락 부탁드립니다.","url":"https://tiger-camping2.com/reservation.php?id=2"},{"text":"사전에 예약하신 인원과 상이할 경우 환불 없이 강제 퇴실 조치될 수 있습니다.","url":"https://tiger-camping2.com/reservation.php?id=2"},{"text":"15시까지 글램핑장 청소시간이므로 원활한 운영을 위해 시간을 꼭 지켜주세요.","url":"https://tiger-camping2.com/reservation.php?id=2"},{"text":"보호자를 동반하지 않은 미성년자는 어떠한 경우에도 입실하실 수 없습니다.","url":"https://tiger-camping2.com/reservation.php?id=2"},{"text":"애완동물은 부득이 타 객실 및 손님을 위해 입실을 금하오니 양해바랍니다.","url":"https://tiger-camping2.com/reservation.php?id=2"},{"text":"동반 입실 시 환불없는 퇴실조치가 가능합니다.","url":"https://tiger-camping2.com/reservation.php?id=2"},{"text":"퇴실 시 음식물을 비롯한 모든 쓰레기는 분리 수거해 주시고, 사용하신 주방기구는 세척해 주시기 바랍니다.","url":"https://tiger-camping2.com/reservation.php?id=2"},{"text":"기간 별 금액 미 확정으로 인해 요금 및 요금표가 잘못 반영된 경우, 자동 예약 취소 처리되며 정상 금액으로 재 예약 할 수 있습니다.","url":"https://tiger-camping2.com/reservation.php?id=2"},{"text":"단순변심, 고객사정으로 인한 취소 시 취소/환불 수수료가 적용됩니다.","url":"https://tiger-camping2.com/reservation.php?id=2"},{"text":"고객 연락처 오기재로 인해 연락이 불가할 경우, 예약이 자동취소 될 수 있습니다.","url":"https://tiger-camping2.com/reservation.php?id=2"},{"text":"추가인원요금이 예약 시 결제되지 않을 수 있으며, 이 경우 사전연락 또는 현장결제 부탁드립니다.","url":"https://tiger-camping2.com/reservation.php?id=2"},{"text":"최대인원 초과 입실 시 입실 및 환불이 불가합니다.(방문객 포함)","url":"https://tiger-camping2.com/reservation.php?id=2"},{"text":"21시 이후 체크인은 업체에 사전연락 부탁드립니다.","url":"https://tiger-camping2.com/reservation.php?id=2"},{"text":"사전예약취소 없이 사용하지 않은 예약 건에 대해서는 환불이 불가합니다.","url":"https://tiger-camping2.com/reservation.php?id=2"},{"text":"글램핑 특성상 예측하지 못한 날씨로 인한 환불이나 이용일 변경은 불가합니다.(사전연락문의)","url":"https://tiger-camping2.com/reservation.php?id=2"},{"text":"환불규정","url":"https://tiger-camping2.com/reservation.php?id=2"},{"text":"취소수수료","url":"https://tiger-camping2.com/reservation.php?id=2"},{"text":"예약일 변경 시 발생하는 수수료도 취소 수수료가 동일하게 적용되오니 예약 시 신중하게 생각하시고 결정해 주시기 바랍니다.","url":"https://tiger-camping2.com/reservation.php?id=2"},{"text":"구매 당일에도 입실일 기준에 따라 취소수수료가 부과되오니 신중히 결정하여 구매해 주시기 바랍니다.","url":"https://tiger-camping2.com/reservation.php?id=2"}],"field_conditions":{"version":2,"status":"SURVEYED","parking":{"state":"UNKNOWN","mode":"UNKNOWN","tent_side":null,"cart_required":null,"shared_nearby":null,"drop_off_external":null,"auto_camping_sites":null},"shelter_setup":{"state":"UNKNOWN","max_tents":null,"max_tarps":null,"canopy_allowed":null,"note":null},"power":{"state":"CONFIRMED","available":true,"limit_w":null,"regulatory_reference_w":600,"breaker_capacity":null,"statutory_standard":true,"high_power_mention":null},"ground":{"state":"UNKNOWN","types":[]},"charcoal":{"state":"SURVEYED","allowed":true},"firewood":{"state":"SURVEYED","allowed":true,"sold":true},"fire_pit":{"state":"SURVEYED","arrangement":"개별"},"site_size":{"state":"UNKNOWN","groups":[]},"sanitary":{"state":"UNKNOWN","toilets_count":null,"showers_count":null,"sinks_count":null,"private_bathroom":false,"private_bathroom_state":"UNKNOWN","hot_water":"제공","note":null},"features":["EXPERIENCE"],"rental_offers":[],"source":{"label":"한국관광공사 고캠핑 운영자 등록 및 공식 소개 전수조사","ur