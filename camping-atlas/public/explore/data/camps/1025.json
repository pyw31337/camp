ocamping.or.kr/upload/camp/1025/88162zWH9ZOrPptwNvFfz2bx.jpg","https://gocamping.or.kr/upload/camp/1025/3985E73ReQWEIe4N2U8bRLvj.jpg","https://gocamping.or.kr/upload/camp/1025/57456PRslHJ9i1FGEfj71BHU.jpg","https://gocamping.or.kr/upload/camp/1025/98033iVvRGMcpoKYyUDkxLMO.jpg","https://gocamping.or.kr/upload/camp/1025/2851rejsVhV3QwECub5S5jqK.jpg","https://gocamping.or.kr/upload/camp/1025/3645eNnHG4LPealqswCw9V90.jpg"],"img_dup":1,"photos":[{"t":"camps/1025/f6690f08-t.webp","l":"camps/1025/f6690f08-l.webp","w":720,"h":480}],"operator_snippets":[{"text":"마이웨이리조트 - 펜션&글램핑","url":"http://www.mywayr.com/sub02_2.php"},{"text":"야외수영장","url":"http://www.mywayr.com/sub02_2.php"},{"text":"요금은 실시간예약에서 확인하세요","url":"http://www.mywayr.com/sub02_2.php"},{"text":"- 주방시설 : 냉장고, 식탁, 전자렌지, 전기밥솥, 전기쿡탑, 취사도구 일체","url":"http://www.mywayr.com/sub02_2.php"},{"text":"- 기타(셀프바베큐) :숯불 700g 2개, 그릴1개, 석쇠, 장갑, 토치 2만원","url":"http://www.mywayr.com/sub02_2.php"},{"text":"요금안내","url":"http://www.mywayr.com/sub05_1.php"},{"text":"글램핑(잔디동, 숲속동, 수영장동)","url":"http://www.mywayr.com/sub05_1.php"},{"text":"- 공휴일 전 평일은 금요일요금 적용","url":"http://www.mywayr.com/sub05_1.php"},{"text":"공휴일 전 토요일,일요일,공휴일은 주말요금 적용","url":"http://www.mywayr.com/sub05_1.php"},{"text":"- 셀프바베큐 : 숯불 700g 2개, 그릴1개, 석쇠, 장갑, 토치 25,000원","url":"http://www.mywayr.com/sub05_1.php"},{"text":"최대인원 초과시 입실 및 환불이 불가합니다.","url":"http://www.mywayr.com/sub05_1.php"},{"text":"숙박하지 않는 당일 객실방문객도 인원에 포함이 되며 이 경우 사전허락후 이용가능합니다.","url":"http://www.mywayr.com/sub05_1.php"},{"text":"입실시간은 오후 15시부터 이며, 퇴실시간은 오전 11시까지 입니다.","url":"http://www.mywayr.com/sub05_1.php"},{"text":"오후 22시 이후의 입실은 사전에 반드시 연락주시기 바랍니다.","url":"http://www.mywayr.com/sub05_1.php"},{"text":"전기난로, 전기스토브 사용을 절대 금합니다.","url":"http://www.mywayr.com/sub05_1.php"},{"text":"개인 화로 및 장작 반입금지합니다.","url":"http://www.mywayr.com/sub05_1.php"},{"text":"모든 객실 애견동반금지입니다.","url":"http://www.mywayr.com/sub05_1.php"},{"text":"입실시간 14시.","url":"http://www.mywayr.com/sub05_1.php"},{"text":"퇴실시간 12시","url":"http://www.mywayr.com/sub05_1.php"},{"text":"2박3일 우선예약제이며,1박 이용시 이용일 3일전 예약가능합니다.(1박예약시 자동취소처리됨)","url":"http://www.mywayr.com/sub05_1.php"},{"text":"수영장 오픈후 1인추가비 15,000원입니다.","url":"http://www.mywayr.com/sub05_1.php"},{"text":"차량 1대 (추가시 1만원)","url":"http://www.mywayr.com/sub05_1.php"},{"text":"사이트 내 주차가능 여부는 별도 문의바랍니다.","url":"http://www.mywayr.com/sub05_1.php"},{"text":"일반쓰레기는 매점에서 받아 지정된 장소 (관리동 입구)에 분리수거하여 버려주세요.","url":"http://www.mywayr.com/sub05_1.php"},{"text":"전기선 20미터 준비","url":"http://www.mywayr.com/sub05_1.php"},{"text":"전기난로 인덕션 전기그릴 에어컨 전기밥솥 등 과전력제품 사용불가합니다.","url":"http://www.mywayr.com/sub05_1.php"},{"text":"수영장 이용규칙","url":"http://www.mywayr.com/sub05_1.php"},{"text":"- 수심 큰수영장 1m10cm이상.","url":"http://www.mywayr.com/sub05_1.php"},{"text":"작은수영장90cm이상","url":"http://www.mywayr.com/sub05_1.php"},{"text":"에어기계는 수영장 중간에 준비되어있습니다.","url":"http://www.mywayr.com/sub05_1.php"},{"text":"큰튜브는 대여가능합니다","url":"http://www.mywayr.com/sub05_1.php"},{"text":"다른 이용객에게 피해가 되는 무분별한 음주, 소란은 당일취소와 동일하게 처리됩니다.","url":"http://www.mywayr.com/sub05_1.php"},{"text":"화장실에서 발생되는 쓰레기는 제공된 휴지통에 넣어 주시기 바랍니다.","url":"http://www.mywayr.com/sub05_1.php"},{"text":"퇴실 시 관리자에게 퇴실점검을 받으시기 바랍니다.","url":"http://www.mywayr.com/sub05_1.php"},{"text":"쓰레기는 퇴실하실 때 분리수거해 주세요.","url":"http://www.mywayr.com/sub05_1.php"},{"text":"환불안내","url":"http://www.mywayr.com/sub05_1.php"},{"text":"환불은 결제한 금액에서 취소수수료를 제외한 금액으로 환불됩니다.","url":"http://www.mywayr.com/sub05_1.php"},{"text":"올바른 예약문화 정착과 예약취소로 인해 발생 할 수 있는 손해 및 분쟁을 미연에 방지하고자 함이오니 고객 여러분의 양해 부탁 드립니다.","url":"http://www.mywayr.com/sub05_1.php"},{"text":"예약 후 날짜변경, 객실변경은 전화로 상담해 주세요.","url":"http://www.mywayr.com/sub05_1.php"},{"text":"취소일기준","url":"http://www.mywayr.com/sub05_1.php"},{"text":"기본취소수수료","url":"http://www.mywayr.com/sub05_1.php"},{"text":"취소수수료(%)","url":"http://www.mywayr.com/sub05_1.php"},{"text":"(환불없음)","url":"http://www.mywayr.com/sub05_1.php"},{"text":"(0%환불)","url":"http://www.mywayr.com/sub05_1.php"},{"text":"(10%환불)","ur