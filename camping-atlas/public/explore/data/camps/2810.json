고기도 잡고, 물놀이를 하며 즐거운 시간을 보낼 수 있다.\n넓은 주차장과 여유 있는 사이트의 공간으로 캠퍼들이 편안하게 즐기다 떠나는 곳이다. 30분 거리에 지리산 노고단이 있어 노고단의 운무를 감상하며 자연의 경이로움을 느껴보는 것도 좋다.","updated":"2025-07-07","facilities":[{"k":"주요시설","v":"일반야영장(20면) · 글램핑시설(10면)","items":["일반야영장(20면)","글램핑시설(10면)"]},{"k":"기타 정보","v":"개인 트레일러 입장가능","items":["개인 트레일러 입장가능"]},{"k":"기타 부대시설","v":"골프연습시설","items":["골프연습시설"]},{"k":"사이트 간격","v":"10M"},{"k":"바닥형태 (단위:면)","v":"테크 (20)","items":["테크 (20)"]},{"k":"사이트 크기","v":"4 X 6 : 20개"},{"k":"글램핑 내부시설","v":"냉장고 · 유무선인터넷 · 난방기구","items":["냉장고","유무선인터넷","난방기구"]},{"k":"캠핑장비대여","v":"화로대","items":["화로대"]},{"k":"반려동물 출입","v":"불가능"},{"k":"화로대","v":"개별"},{"k":"안전시설현황","v":"소화기 (15) · 방화수 (2) · 방화사 (5) · 화재감지기 (10)","items":["소화기 (15)","방화수 (2)","방화사 (5)","화재감지기 (10)"]}],"photos":["https://www.gocamping.or.kr/upload/camp/2810/99903174oUKtyDCQBR7OYzb7.jpg","https://www.gocamping.or.kr/upload/camp/2810/7879UzAFdF3Sc0MtH2zDEkyr.jpg","https://www.gocamping.or.kr/upload/camp/2810/26345KYLGpCfk0rvdAi9KPXz.jpg","https://www.gocamping.or.kr/upload/camp/2810/78175cg566tSq3Dt9OSjl2VD.jpg","https://www.gocamping.or.kr/upload/camp/2810/1814AocOXAB8xP74uLuEnokc.jpg","https://www.gocamping.or.kr/upload/camp/2810/23589EKi293rXet6FTdYXpfp.jpg","https://www.gocamping.or.kr/upload/camp/2810/4881BGsNeYEBJxkq2B7esoF7.jpg"],"layout":["https://www.gocamping.or.kr/upload/camp/2810/3234SYPGofpt3QDqYzbAHJby.jpg"],"guide":[{"title":"일반캠핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"일반","values":["30,000","30,000","40,000","50,000"]}]}},{"title":"글램핑","table":{"cols":["평상시 주중","평상시 주말","성수기 주중","성수기 주말"],"rows":[{"label":"글램핑","values":["80,000","100,000","120,000","150,000"]}]}}],"fees":[{"won":30000,"label":"일반캠핑 · 일반","period":"평상시 주중"},{"won":30000,"label":"일반캠핑 · 일반","period":"평상시 주말"},{"won":40000,"label":"일반캠핑 · 일반","period":"성수기 주중"},{"won":50000,"label":"일반캠핑 · 일반","period":"성수기 주말"},{"won":80000,"label":"글램핑 · 글램핑","period":"평상시 주중"},{"won":100000,"label":"글램핑 · 글램핑","period":"평상시 주말