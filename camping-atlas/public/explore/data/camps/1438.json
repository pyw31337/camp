pY4MSsHZ9khjbdY21S1i.jpg","https://gocamping.or.kr/upload/camp/1438/9928RNdLbZTYaGL0gfUsrDmS.jpg","https://gocamping.or.kr/upload/camp/1438/8938huY4jZXmpVZtJbFxZpux.jpg","https://gocamping.or.kr/upload/camp/1438/2106YlyqM1zQFqHscvp2r50s.jpg","https://gocamping.or.kr/upload/camp/1438/0876dcfocKu71OwbnIDc89K4.jpg","https://gocamping.or.kr/upload/camp/1438/8022rsH9WH08dKeDwimISFUg.jpg","https://gocamping.or.kr/upload/camp/1438/05247P0DanprKCODgufd2kKG.jpg","https://gocamping.or.kr/upload/camp/1438/7406NfEMBkt2a1wb3jMS8xjS.jpg"],"img_dup":1,"photos":[{"t":"camps/1438/27e4bb78-t.webp","l":"camps/1438/27e4bb78-l.webp","w":720,"h":405},{"t":"camps/1438/f711599f-t.webp","l":"camps/1438/f711599f-l.webp","w":1000,"h":1287}],"operator_snippets":[{"text":"럭셔리카라반","url":"http://bibiautocamp.com/contents/main.html"},{"text":"프리미엄카라반","url":"http://bibiautocamp.com/contents/main.html"},{"text":"VIP카라반","url":"http://bibiautocamp.com/contents/main.html"},{"text":"타프형 오토캠핑","url":"http://bibiautocamp.com/contents/main.html"},{"text":"오토캠핑","url":"http://bibiautocamp.com/contents/main.html"},{"text":"노을&불멍","url":"http://bibiautocamp.com/contents/main.html"},{"text":"야외수영장","url":"http://bibiautocamp.com/contents/main.html"},{"text":"개별바비큐, 침실, 복층침실, 주방, 화장실","url":"http://bibiautocamp.com/contents/main.html"},{"text":"개별바비큐, 침실, 주방, 화장실","url":"http://bibiautocamp.com/contents/main.html"},{"text":"데크, 개별화장실","url":"http://bibiautocamp.com/contents/main.html"},{"text":"타프형 데크, 개별화장실","url":"http://bibiautocamp.com/contents/main.html"},{"text":"입실/퇴실 안내","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"입실시간 : 15시","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"퇴실시간 : 11시","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"전 객실 옆 주차 가능합니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"기준인원 초과시 1인당 카라반/글램핑 20,000원","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"오토캠핑 10,000원의 추가요금 발생 (48개월 이상)","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"성수기 기간은 실시간 예약에서 확인해 주세요.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"예약 후 24시간 이내 전액 입금하셔야 예약이 완료되며 미입금 시 예약이 자동으로 취소됩니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"사전 통보 없이 예약금 입금이 안 된 경우에는 예약이 자동으로 취소됩니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"반려견과 함께 캠핑을 즐길 수 있습니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"(애견글램핑, 오토캠핑만 가능)","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"현장에서 발생되는 모든 추가 요금은 1박당 부과되오니 자세한 사항은 숙소 측에 문의 부탁드립니다","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"펜션의 객실 예약 현황은 실시간 예약 특성상 100% 일치하지 않을 수 있습니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"타프형오토캠핑1~3, 오토캠핑사이트1~11는 난방기, 개인화로, 취사도구(그릴, 숯, 전기, 전열기구, 가스버너, 에어프라이어 등) 사용이 가능합니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"타프형 오토캠핑, 오토캠핑은 차박불가, 트레일러, 캠핑카 이용이 불가능합니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"# 인원 추가 안내","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"오토캠핑 10,000원의 추가요금이 있습니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"기준 인원 초과 시 추가 인원에 대한 비용이 별도로 발생할 수 있습니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"최대인원은 초과불가","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"# 애견동반안내","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"애견 동반 전 사전문의 및 상담 필수","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"가능객실: 애견동반글램핑,오토캠핑","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"이용요금: 1마리당 2만원 (1박기준/현장결제)","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"제한무게: 5kg미만","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"제한마릿수: 2마리","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"애견비품:애견 용품 개별 지참 필수","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"애견 동반 시 주의사항:목줄은 필수","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"애견 놀이터로 잔디밭이 있음","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"# 수영장이용안내","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"운영기간: 6월28일 ~ 8월16일","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"이용시간:입실~18:00","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"수영장 크기: 10m x 5m x 1m","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"이용 시 주의사항: 수영장에 설치된 준수사항 푯말 참조","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"전 객실 사이트 옆 주차 가능합니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"공용화장실","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"공용샤워실","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"숯불 바베큐: 4인 20,000(1박기준/현장결제)","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"장작만 구매 시 12,000원","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"이용시간 : 18:00~21:00 까지","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"개인화로대(부루스타, 숯, 화로대, 가스요리기구, 전기요리기구 등 일체, 숯, 그릴, 장작 및 화롯대 기구 포함) 반입 발견시 환불없이 퇴실 조치 할 수 있습니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"타프형오토캠핑1~3, 오토캠핑사이트1~11는 개인화로 사용 가능합니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"안전수칙을 위반하여 발생하는 모든 사고에 대해 업체에 책임이 없음을 알려드립니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"유의사항 안내","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"# 퇴실 시간","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"퇴실 시 음식물 및 기타 쓰레기는 분리수거 해 주시고, 식기류는 세척해 주시기 바랍니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"입실은 15시부터, 퇴실은 다음날 11시까지입니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"다음 이용 고객을 위해 퇴실 시간을 준수해 주시기 바랍니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"퇴실 시 간단한 정리 부탁드립니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"# 금연","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"금연구역과 객실에서 흡연 시 퇴실 조치 및 객실 요금의 3배가 부과됩니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"별도로 마련된 흡연장소를 이용해 주시기 바랍니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"# 매너타임","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"# 화재예방 및 소음","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"화재 발생과 안전을 위해 불꽃놀이와 촛불 등의 사용을 금합니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"안전 및 화재예방을 위해 객실 내에서 생선이나 고기 등을 굽는 직화 방식은 허용되지 않습니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"다른 이용객에게 피해를 줄 수 있는 무분별한 오락, 음주, 고성방가는 삼가주시기 바랍니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"# 미성년자","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"저희는 법적으로 미성년자 예약 및 혼숙이 금지되어 있습니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"미성년자는 보호자의 동반 없이는 숙박 및 예약을 하실 수 없습니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"또한 미성년자의 예약 및 이용은 숙소 규정에 따라 결정되며 해당 사유로 환불받을 수 없습니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"환불안내","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"취소수수료는 결제금액이 아닌 예약 금액(객실 금액 옵션 금액) 기준으로 책정됩니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"최대 인원 초과 시 입실이 불가할 수 있으며, 해당 사유로 환불을 받으실 수 없습니다.(유아, 어린이 포함)","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"이용일 당일 예약 후 당일 취소한 경우 이용 당일 취소이므로 환불이 불가합니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"취소수수료는 판매채널별로 상이할 수 있습니다.","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"이용일 7일 전 예약 취소 이용일 6일 전 예약 취소 이용일 5일 전 예약 취소 이용일 4일 전 예약 취소 이용일 3일 전 예약 취소 이용일 2일 전 예약 취소 이용일 1일 전 예약 취소 이용일 당일 예약 취소","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"환불불가","url":"http://bibiautocamp.com/contents/reserve.html"},{"text":"펜션 전경","url":"http://bibiautocamp.com/contents/about.html"},{"text":"펜션 소개","url":"http://bibiautocamp.com/contents/about.html"},{"text":"비비오토캠프는 글램핑, 