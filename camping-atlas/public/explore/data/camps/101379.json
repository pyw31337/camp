ate":null,"body":["난지섬 쭈꾸미 캠핑장 예약·가격·입실시간 - 지식나침반","난지섬 쭈꾸미 캠핑장 예약·가격·입실시간","난지섬 쭈꾸미 캠핑장은 충남 당진시 석문면 난지2길 84 에 있는 섬 캠핑장으로, 예약 전에는 예약 오픈 시간, 배편 시간, 추가요금, 입실·퇴실 시간 을 함께 확인해야 합니다.","특히 이곳은 배를 타고 들어가는 일정이기 때문에 일반 캠핑장처럼 “늦게 도착하면 되겠지”라고 생각하면 입실 동선이 꼬일 수 있습니다.","장비가 많거나 성수기 7월에 방문한다면 예약 전 비용과 이동 조건을 먼저 계산하는 편이 훨씬 유리합니다.","② 기본요금은 비수기 6만 원, 성수기 7월 7만 원 기준으로 정리되어 있습니다.","③ 기준 인원은 성인 2인 + 미성년자 2인 + 차량 1대 이며, 최대 인원은 6인, 성인 4인 초과 불가 로 보는 것이 안전합니다.","④ 입실은 11시 30분 , 퇴실은 11시 로 안내되어 있어 배편 시간에 맞춘 일정 관리가 중요합니다.","⑤ 예약 전에는 난지섬 쭈꾸미캠핑장 FAQ 에서 입퇴실, 취소, 매너타임을 함께 확인하는 것이 좋습니다.","예약 오픈 매월 1일 12시, 3개월 전 한 달 단위 주말·성수기 예약은 오픈 직후 확인이 유리합니다."]},{"t":"web","title":"난지섬 쭈꾸미 캠핑장 — 바베큐 — 충남 당진시 석문면","snippet":"난지섬 쭈꾸미 캠핑장은 충청남도 당진시 석문면 난지2길 84에 위치한 캠핑장입니다. 반려동물, 전화번호, 위치를 확인할 수 있습니다.","url":"https://opendatflow.com/camping-sites/4408","src":"opendatflow.com","date":null}],"web_checked_at":"2026-10-24T21:00:54.109Z","field_conditions":{"version":2,"status":"SURVEYED","parking":{"state":"SURVEYED","mode":"SITE_ADJACENT","tent_side":true,"cart_required":false,"shared_nearby":false,"drop_off_external":null,"auto_camping_sites":null},"shelter_setup":{"state":"UNKNOWN","max_tents":null,"max_tarps":null,"canopy_allowed":null,"note":null},"power":{"state":"UNKNOWN","available":null,"limit_w":null,"regulatory_reference_w":null,"breaker_capacity":null,"statutory_standard":false,"high_power_mention":null},"ground":{"state":"UNKNOWN","types":[]},"charcoal":{"state":"CONFIRMED","allowed":true},"firewood":{"state":"CONFIRMED","allowed":true,"sold":null},"fire_pit":{"state":"CONFIRMED","arrangement":"개별"},"site_size":{"state":"UNKNOWN","groups":[]},"sanitary":{"state":"CONFIRMED","toilets_count":null,"showers_count":null,"sinks_count":null,"private_bathroom":true,"private_bathroom_state":"SURVEYED","hot_water":"제공","note":"단독 개별 화장실/욕실 구비"},"features":["EXPERIENCE"],"rental_offers":[],"source":{"label":"한국관광공사 고캠핑 운영자 등록 및 공식 소개 전수조사","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=101379","checke