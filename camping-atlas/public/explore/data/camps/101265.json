다.","v":false}],"open_rules":[],"next":[],"warnings":["예약 방식이 '온라인예약대기'로 등록돼 있습니다. 실제 예약 가능 여부를 확인하세요.","네이버 예약 이용 절차 일부는 공식 원문으로 확인되지 않았습니다."]},"photos":[{"t":"camps/101265/3386a99f-t.webp","l":"camps/101265/3386a99f-l.webp","w":720,"h":539}]}