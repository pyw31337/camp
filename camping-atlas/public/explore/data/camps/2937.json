/gjcamp/01/note.php"},{"text":"쓰레기는 지정된 장소(공용 주차장 쓰레기장)에 종류별로 분류하여 내 놓으셔야 합니다.","url":"http://gjcamping.co/theme/gjcamp/01/note.php"},{"text":"강진 청자촌 오토캠핑장 내에 동물 반입은 관리자에게 문의하세요(010-7564-6203)","url":"http://gjcamping.co/theme/gjcamp/01/note.php"}],"rv":{"n":12,"p":[["조용·한적",1]],"c":[],"details":{"pros":[{"topic":"조용·한적","count":1,"samples":[{"title":"강진캠핑장 청자촌 오토캠핑장 가족과 여유롭게 즐긴 강진오토캠핑장 후기","url":"https://blog.naver.com/thenugu/224406231746","date":"2026-09-09"}]}],"cons":[],"issues":[]}},"nearby_licensed":{"CONVENIENCE":{"m":3132,"name":"세븐일레븐 강진가우도점(바다다)","addr":"전남광주통합특별시 강진군 대구면 중저길 15-27","lat":34.53576,"lng":126.79047,"n5":1},"OTC_MEDICINE":{"m":6732,"name":"씨유강진마량점","addr":"전남광주통합특별시 강진군 마량면 미항로 137","lat":34.44988,"lng":126.81724,"n5":0},"MART":{"m":1464,"name":"대구슈퍼","addr":"전남광주통합특별시 강진군 대구면 수동길 17-1","lat":34.49565,"lng":126.80014,"n5":5},"BUTCHER":{"m":6517,"name":"마량식육점","addr":"전남광주통합특별시 강진군 마량면 마량6길 19","lat":34.4518,"lng":126.81688,"n5":0},"FUEL":{"m":1542,"name":"강진남부농협 대구주유소","addr":"전남광주통합특별시 강진군 대구면 청자로 1856","lat":34.49497,"lng":126.79947,"n5":1},"PHARMACY":{"m":8085,"name":"영생약국","addr":"전남광주통합특별시 장흥군 대덕읍 대대로 925","lat":34.49893,"lng":126.88783,"n5":0},"VET":{"m":8084,"name":"대덕 동물병원","addr":"전남광주통합특별시 장흥군 대덕읍 대대로 926","lat":34.49858,"lng":126.88775,"n5":0}},"site_types":[{"code":"AUTO","label":"오토캠핑","count":null,"sub":null,"grade":"OPERATOR","src":"operator_homepage","url":"http://gjcamping.co/","at":"2026-10-15T23:27:04.533Z","quote":"강진청자촌 오토캠핑장"},{"code":"DECK","label":"데크","count":35,"sub":null,"grade":"CONFIRMED","src":"gocamping","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=2937","at":"2026-07-16T00:00:00+09:00","quote":null},{"code":"CARAVAN","label":"카라반","count":20,"sub":null,"grade":"CONFIRMED","src":"gocamping","url":"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no=2937","at":"2026-07-16T00:00:00+09:00","quote":null},{"code":"RV","label":"캠핑카·트레일러","count":56,"sub":null,"grade":"CONFIRMED","src":"gocampi